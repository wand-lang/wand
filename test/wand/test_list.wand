uses {FS.Read, FS.Write}

let {test, group} = import Test
import FS
import List
import Map
import Option
import Path
import Stream
import String

-- ── sort ────────────────────────────────────────────────────────────────

test "sort ints" (fn t -> t.eq [1, 2, 3] (List.sort [3, 1, 2]))
test "sort strings" (fn t ->
  t.eq ["apple", "banana", "cherry"] (List.sort ["banana", "apple", "cherry"]))
test "sort empty" (fn t -> (let empty : List Int = []; t.eq [] (List.sort empty)))

-- ── sort_by ─────────────────────────────────────────────────────────────

test "sort_by string length" (fn t ->
  t.eq ["fig", "kiwi", "banana"] (List.sort_by String.length ["banana", "kiwi", "fig"]))
test "sort_by negate (descending)" (fn t ->
  t.eq [5, 4, 3, 1, 1] (List.sort_by (fn x -> 0 - x) [3, 1, 4, 1, 5]))

-- ── unique ──────────────────────────────────────────────────────────────

test "unique ints" (fn t -> t.eq [1, 2, 3] (List.unique [1, 2, 1, 3, 2]))
test "unique preserves order" (fn t ->
  t.eq ["c", "a", "b"] (List.unique ["c", "a", "b", "a", "c"]))
test "unique empty" (fn t -> (let empty : List Int = []; t.eq [] (List.unique empty)))

-- `unique` answers with the same equality `==` does. It read the stored
-- value before, so two spellings of one instant both survived a list that
-- is meant to hold each value once.
test "unique agrees with == on durations" (fn t -> t.eq [60s] (List.unique [60s, 1min]))
test "unique agrees with == on instants" (fn t ->
  t.eq [2026-08-25] (List.unique [2026-08-25, 2026-08-25T00:00:00Z]))
test "unique agrees with == on sizes" (fn t -> t.eq [1000KB] (List.unique [1000KB, 1MB]))
test "unique keeps sizes that differ" (fn t ->
  t.eq [1000KB, 2MB] (List.unique [1000KB, 1MB, 2MB]))
test "unique reads inside a value" (fn t -> t.eq [[60s]] (List.unique [[60s], [1min]]))
test "unique keeps a prerelease apart from its release" (fn t ->
  t.eq [1.0.0-alpha, 1.0.0] (List.unique [1.0.0-alpha, 1.0.0, 1.0.0-alpha]))
test "unique on functions raises, as == does" (fn t ->
  t.raises (fn () -> List.unique [fn x -> x + 1, fn y -> y + 2]))

-- ── range ───────────────────────────────────────────────────────────────

test "range basic" (fn t -> t.eq [1, 2, 3, 4, 5] (List.range 1 5))
test "range single" (fn t -> t.eq [3] (List.range 3 3))
test "range empty (hi < lo)" (fn t -> t.eq [] (List.range 5 1))

-- ── flatten ─────────────────────────────────────────────────────────────

test "flatten basic" (fn t -> t.eq [1, 2, 3, 4, 5] (List.flatten [[1, 2], [3], [4, 5]]))
test "flatten empty lists" (fn t ->
  let empty : List Int = [];
  t.eq [1] (List.flatten [empty, [1], []]))
test "flatten empty" (fn t ->
  let empty : List (List Int) = [];
  t.eq [] (List.flatten empty))

-- ── concat ──────────────────────────────────────────────────────────────

test "concat basic" (fn t -> t.eq [1, 2, 3, 4] (List.concat [1, 2] [3, 4]))
test "concat with empty" (fn t ->
  let empty : List Int = [];
  t.eq [1, 2] (List.concat empty [1, 2]))
test "concat both empty" (fn t ->
  let empty : List Int = [];
  t.eq [] (List.concat empty empty))

-- ── filter_map ──────────────────────────────────────────────────────────

test "filter_map keeps what answered Some" (fn t ->
  t.eq
    [4, 8]
    (List.filter_map (fn x -> if x % 2 == 0 then Some (x * 2) else None) [1, 2, 3, 4]))
test "filter_map on an empty list" (fn t ->
  let empty : List Int = [];
  t.eq [] (List.filter_map (fn x -> Some x) empty))
test "filter_map that keeps nothing" (fn t ->
  t.eq [] (List.filter_map (fn _ -> None) [1, 2, 3]))
test "filter_map changes the element type" (fn t ->
  t.eq ["2"] (List.filter_map (fn x -> if x > 1 then Some "%{x}" else None) [1, 2]))

-- ── pipeline ────────────────────────────────────────────────────────────

test "range |> filter |> sort_by" (fn t ->
  let got =
    List.range 1 10 |> List.filter (fn x -> x % 2 == 0) |> List.sort_by (fn x -> 0 - x);
  t.eq [10, 8, 6, 4, 2] got)
test "flatten after map" (fn t ->
  let got = List.range 1 3 |> List.map (fn x -> [x, x * 2]) |> List.flatten;
  t.eq [1, 2, 2, 4, 3, 6] got)

-- ── get / get! ──────────────────────────────────────────────────────────

test "get 0" (fn t ->
  t.eq
    "a"
    (match List.get 0 ["a", "b", "c"] with
    | Some v -> v
    | None -> ""
    ))
test "get 2" (fn t ->
  t.eq
    "c"
    (match List.get 2 ["a", "b", "c"] with
    | Some v -> v
    | None -> ""
    ))
test "get out of bounds returns None" (fn t -> List.get 5 ["a", "b"] |> t.eq None)
test "get negative returns None" (fn t -> List.get (-1) ["a"] |> t.eq None)

test "get! 1" (fn t -> t.eq 20 (List.get! 1 [10, 20, 30]))
test "get! works on nested lists" (fn t ->
  t.eq 3 (List.get! 0 (List.get! 1 [[1, 2], [3, 4]])))
test "get! out of bounds raises" (fn t -> t.raises (fn () -> List.get! 9 [1, 2, 3]))

-- ── take_while / drop_while ────────────────────────────────────────────

test "take_while stops at first miss" (fn t ->
  t.eq [1, 2] (List.take_while (fn x -> x < 3) [1, 2, 3, 4, 1]))
test "take_while empty list" (fn t -> t.eq [] (List.take_while (fn x -> x < 3) []))
test "take_while all match" (fn t -> t.eq [1, 2] (List.take_while (fn x -> x < 10) [1, 2]))
test "take_while no match" (fn t -> t.eq [] (List.take_while (fn x -> x < 0) [1, 2]))

test "drop_while drops through first miss" (fn t ->
  t.eq [3, 4, 1] (List.drop_while (fn x -> x < 3) [1, 2, 3, 4, 1]))
test "drop_while empty list" (fn t -> t.eq [] (List.drop_while (fn x -> x < 3) []))
test "drop_while all match" (fn t -> t.eq [] (List.drop_while (fn x -> x < 10) [1, 2]))
test "drop_while no match" (fn t -> t.eq [1, 2] (List.drop_while (fn x -> x < 0) [1, 2]))

-- ── each ────────────────────────────────────────────────────────────────

-- `each` takes the element, as `map` and `filter` do. It used to take
-- `(index, element)`, which meant every call site wanting a side effect
-- opened with `fn (_, x) ->` -- and every one in the corpus discarded the
-- index. Tested through a real side effect, which also pins the order.
test "each sees every element, in order" (fn t ->
  with FS.temp_dir "list_each_" as d -> (
    let log = Path.join d (Path.of_string "log");
    FS.write_file! log "";
    List.each (fn x -> FS.append! log "%{x}\n") ["a", "b", "c"];
    t.eq "a\nb\nc\n" (FS.read_file! log)
  ))

test "each on an empty list does nothing" (fn t ->
  with FS.temp_dir "list_each_empty_" as d -> (
    let log = Path.join d (Path.of_string "log");
    FS.write_file! log "";
    let empty : List String = [];
    List.each (fn x -> FS.append! log x) empty;
    t.eq "" (FS.read_file! log)
  ))

-- ── indexed ─────────────────────────────────────────────────────────────

test "indexed counts from zero" (fn t ->
  t.eq [(0, "a"), (1, "b"), (2, "c")] (List.indexed ["a", "b", "c"]))
test "indexed empty" (fn t -> (let empty : List Int = []; t.eq [] (List.indexed empty)))

-- The position, when it is wanted, is one call away rather than in every
-- signature that never uses it.
test "indexed pairs with each" (fn t ->
  with FS.temp_dir "list_indexed_" as d -> (
    let log = Path.join d (Path.of_string "log");
    FS.write_file! log "";
    ["a", "b"] |> List.indexed |> List.each (fn (i, x) -> FS.append! log "%{i}:%{x} ");
    t.eq "0:a 1:b " (FS.read_file! log)
  ))

-- ── sum, max, min ───────────────────────────────────────────────────────

-- The total starts from the first element rather than from a literal
-- zero, which is what keeps these Add- and Ord-polymorphic. The Option is
-- the price: an empty list has no unit to answer with.

test "sum totals Ints" (fn t -> t.eq (Some 6) (List.sum [1, 2, 3]))
test "sum of one element" (fn t -> t.eq (Some 5) (List.sum [5]))
test "sum totals Sizes" (fn t -> t.eq (Some 1500B) (List.sum [1KB, 500B]))
test "sum totals Durations" (fn t -> t.eq (Some 1h30m) (List.sum [1h, 30min]))
test "sum totals Floats" (fn t -> t.eq (Some 3.5) (List.sum [1.5, 2.0]))
test "sum of empty" (fn t -> (let empty : List Int = []; t.eq (None) (List.sum empty)))

test "max of Ints" (fn t -> t.eq (Some 3) (List.max [3, 1, 2]))
test "min of Ints" (fn t -> t.eq (Some 1) (List.min [3, 1, 2]))
test "max of Versions reads the numbers" (fn t ->
  t.eq (Some 1.10.0) (List.max [1.9.0, 1.10.0]))
test "min of Durations" (fn t -> t.eq (Some 30s) (List.min [2min, 30s, 1h]))
test "max of empty" (fn t -> (let empty : List Int = []; t.eq (None) (List.max empty)))
test "min of empty" (fn t -> (let empty : List Int = []; t.eq (None) (List.min empty)))

-- The aggregates agree with the sort they stand in for.
test "max agrees with sort" (fn t ->
  t.eq (List.get 2 (List.sort [3, 1, 2])) (List.max [3, 1, 2]))

-- An empty total is supplied at the call site, which is where the unit is
-- known.
test "an empty sum takes its zero from the caller" (fn t ->
  let empty : List Size = [];
  t.eq 0B (List.sum empty |> Option.default 0B))

test "tally counts each string" (fn t -> t.eq {a = 2, b = 1} (List.tally ["a", "b", "a"]))

test "tally keeps first-seen order" (fn t ->
  t.eq ["b", "a"] (Map.keys (List.tally ["b", "a", "b"])))

test "tally of nothing is the empty map" (fn t -> t.eq Map.empty (List.tally []))

test "tally agrees with Stream.tally" (fn t ->
  let xs = ["x", "y", "x", "z", "y"];
  t.eq (Map.to_list (List.tally xs)) (Stream.of_list xs |> Stream.tally |> Map.to_list))

-- A count is often worked out, and one below 0 means none, as it does for
-- Stream.take and Stream.drop: a negative count once took the whole list.
group "take and drop with a count below 1" (fn () -> [
  test "take 0 is empty" (fn t -> t.eq [] (List.take 0 [1, 2, 3])),
  test "take below 0 is empty" (fn t -> t.eq [] (List.take (-2) [1, 2, 3])),
  test "drop 0 keeps all" (fn t -> t.eq [1, 2, 3] (List.drop 0 [1, 2, 3])),
  test "drop below 0 keeps all" (fn t -> t.eq [1, 2, 3] (List.drop (-2) [1, 2, 3])),
  test "past the end" (fn t ->
    t.eq ([1, 2, 3], []) (List.take 5 [1, 2, 3], List.drop 5 [1, 2, 3])),
  test "the last n, with fewer than n" (fn t ->
    let xs = [1, 2, 3];
    t.eq [1, 2, 3] (List.drop (List.length xs - 20) xs))
])
