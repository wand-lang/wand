uses {Clock}

let {test, group} = import Test
import Clock
import Duration
import Test

-- Waiting is an effect, so a handler can answer it. That is what makes a
-- deadline testable instead of slow: `Test.with_clock` supplies a clock
-- that costs no time and reports what was asked of it.
--
-- Nothing here sleeps for real. A test that took the durations it names
-- would take over an hour.

group "the virtual clock" (fn () -> [
  test "an hour costs nothing" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> Clock.sleep 1h);
    t.eq 1h elapsed),
  test "several sleeps add up" (fn t ->
    let (elapsed, v) = Test.with_clock (fn () -> (Clock.sleep 30s; Clock.sleep 90s; "done"));
    t.eq (2min, "done") (elapsed, v)),
  test "a thunk that never sleeps waits no time" (fn t ->
    let (elapsed, v) = Test.with_clock (fn () -> 42);
    t.eq (0ms, 42) (elapsed, v))
])

-- A zero sleep still performs the effect, so a handler sees it and a trace
-- reports it. Nothing is stepped around by a value that happens to be
-- zero.
group "the edges" (fn () -> [
  test "zero is still a sleep" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> Clock.sleep 0ms);
    t.eq 0ms elapsed),
  test "and it is counted" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> (Clock.sleep 0ms; Clock.sleep 5s));
    t.eq 5s elapsed)
])

-- A backoff loop is the reason ordering had to come first.
let backoff attempts =
  let step d n =
    if n == 0 then 0ms
    else (
      let capped = if d > 30s then 30s else d;
      Clock.sleep capped;
      capped + step (d + d) (n - 1)
    );
  step 1s attempts

group "a capped backoff" (fn () -> [
  test "doubles until the cap" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> backoff 3);
    t.eq 7s elapsed),
  -- 1 + 2 + 4 + 8 + 16 + 30 + 30 + 30: the last three are the cap.
  test "and never sleeps longer than the cap" (fn t ->
    let (elapsed, _) = Test.with_clock (fn () -> backoff 8);
    t.eq 121s elapsed)
])

-- Reading the clock is an effect as well, so a test pins the instant
-- instead of arranging for one.

group "reading the clock" (fn () -> [
  test "the instant a handler gives" (fn t ->
    t.eq 2026-03-01T00:00:00Z (Test.at 2026-03-01T00:00:00Z (fn () -> Clock.now ()))),
  -- Two readings, and not subtracted: that shape is `V-CLOCK1`, whatever
  -- answers it.
  test "every reading inside is the same one" (fn t ->
    t.eq
      (2026-03-01T00:00:00Z, 2026-03-01T00:00:00Z)
      (Test.at 2026-03-01T00:00:00Z (fn () -> (Clock.now (), Clock.now ())))),
  -- The shape a script is written in: how old is this, and is that too old.
  test "an age against a deadline" (fn t ->
    t.ok (Test.at 2026-03-01T00:00:00Z (fn () -> Clock.now () - 2026-01-01T00:00:00Z > 30d))),
  test "and one that is not too old" (fn t ->
    t.eq
      false
      (Test.at 2026-03-01T00:00:00Z (fn () -> Clock.now () - 2026-02-25T00:00:00Z > 30d)))
])

-- An instant moves by a Duration, from either side, and the answer is
-- written the way a literal is: UTC, whole seconds.

group "instant arithmetic" (fn () -> [
  test "a duration moves it forward" (fn t ->
    t.eq 2026-03-01T01:30:00Z (2026-03-01T00:00:00Z + 90min)),
  test "from either side" (fn t -> t.eq 2026-03-01T01:30:00Z (90min + 2026-03-01T00:00:00Z)),
  test "and back" (fn t -> t.eq 2026-02-28T23:00:00Z (2026-03-01T00:00:00Z - 1h)),
  test "an offset is the same instant" (fn t ->
    t.eq 2026-03-01T00:00:00Z (2026-03-01T05:30:00+05:30 + 0s)),
  test "the length between two instants" (fn t ->
    t.eq 25h (2026-03-02T01:00:00Z - 2026-03-01T00:00:00Z)),
  -- A file stamped in the future reads as no age, the way every other
  -- Duration subtraction floors.
  test "a difference the wrong way round floors at zero" (fn t ->
    t.eq 0ms (2026-03-01T00:00:00Z - 2026-03-02T00:00:00Z)),
  test "seconds are the resolution" (fn t ->
    t.eq 2026-03-01T00:00:00Z (2026-03-01T00:00:00Z + 500ms))
])

-- `Clock.timed` is the only way to measure a length of time. The durations
-- here are short, because this one waits for real.

group "measuring" (fn () -> [
  test "a sleep takes at least its length" (fn t ->
    let (took, _) = Clock.timed (fn () -> Clock.sleep 120ms);
    t.ok (took >= 120ms)),
  test "and the thunk's answer comes back with it" (fn t ->
    let (_, answer) = Clock.timed (fn () -> "built");
    t.eq "built" answer),
  test "work that does nothing takes almost none" (fn t ->
    let (took, _) = Clock.timed (fn () -> 1 + 1);
    t.ok (took < 100ms)),
  -- The reading is an effect, so a handler catches it. One that answers
  -- every reading with the same value reports no time passing.
  test "a handler answers the reading" (fn t ->
    let (took, _) =
      handle Clock.timed (fn () -> "work") with
      | Clock!timed _ k -> k 5min
    in
    t.eq 0ms took)
])
