uses {FS.Read, FS.Write}

let {test} = import Test
import Decode
import Result
import TOML
import List
import String
import Map
import Path
import FS

-- ── parse ───────────────────────────────────────────────────────────────

test "valid TOML returns Ok" (fn t ->
  t.eq
    "ok"
    (match TOML.parse "key = \"value\"\n" with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "invalid TOML returns Error" (fn t ->
  t.eq
    "error"
    (match TOML.parse "not = = toml" with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "parse! valid" (fn t -> (let tm = TOML.parse! "x = 1\n"; t.eq true (TOML.table? tm)))

test "parse! invalid raises" (fn t -> t.raises (fn () -> TOML.parse! "bad = = toml"))

-- ── field / field! ──────────────────────────────────────────────────────

test "field exists" (fn t ->
  let tm = TOML.parse! "name = \"Alice\"\nage = 30\n";
  t.eq
    (Ok "Alice")
    (match TOML.field "name" tm with
    | Ok v -> TOML.get_string v
    | Error _ -> Error "no field"
    ))

test "field missing" (fn t ->
  let tm = TOML.parse! "a = 1\n";
  t.eq
    "error"
    (match TOML.field "z" tm with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "field! exists" (fn t ->
  let tm = TOML.parse! "x = 42\n";
  t.eq
    42
    (match TOML.get_int (TOML.field! "x" tm) with
    | Ok n -> n
    | Error _ -> -1
    ))

test "field! missing raises" (fn t ->
  let tm = TOML.parse! "a = 1\n";
  t.raises (fn () -> TOML.field! "z" tm))

-- ── get_* extractors ────────────────────────────────────────────────────

test "get_string" (fn t ->
  let tm = TOML.parse! "s = \"hello\"\n";
  t.eq
    "hello"
    (match TOML.get_string (TOML.field! "s" tm) with
    | Ok s -> s
    | Error _ -> ""
    ))

test "get_int" (fn t ->
  let tm = TOML.parse! "n = 99\n";
  t.eq
    99
    (match TOML.get_int (TOML.field! "n" tm) with
    | Ok n -> n
    | Error _ -> -1
    ))

test "get_float" (fn t ->
  let tm = TOML.parse! "f = 3.14\n";
  t.eq
    true
    (match TOML.get_float (TOML.field! "f" tm) with
    | Ok f -> f > 3.0
    | Error _ -> false
    ))

test "get_float from int" (fn t ->
  let tm = TOML.parse! "n = 2\n";
  t.eq
    true
    (match TOML.get_float (TOML.field! "n" tm) with
    | Ok f -> f == 2.0
    | Error _ -> false
    ))

test "get_bool true" (fn t ->
  let tm = TOML.parse! "flag = true\n";
  t.eq
    true
    (match TOML.get_bool (TOML.field! "flag" tm) with
    | Ok b -> b
    | Error _ -> false
    ))

test "get_array length" (fn t ->
  let tm = TOML.parse! "nums = [1, 2, 3]\n";
  t.eq
    3
    (match TOML.get_array (TOML.field! "nums" tm) with
    | Ok xs -> List.length xs
    | Error _ -> -1
    ))

test "get_array int elements" (fn t ->
  let tm = TOML.parse! "nums = [10, 20]\n";
  t.eq
    10
    (match TOML.get_array (TOML.field! "nums" tm) with
    | Ok xs -> (
      match TOML.get_int (List.head! xs) with
      | Ok n -> n
      | Error _ -> -1
    )
    | Error _ -> -1
    ))

-- ── nested tables ───────────────────────────────────────────────────────

test "nested table access" (fn t ->
  let src = "[server]\nhost = \"localhost\"\nport = 8080\n";
  let tm = TOML.parse! src;
  let server = TOML.field! "server" tm;
  t.eq
    "localhost"
    (match TOML.get_string (TOML.field! "host" server) with
    | Ok s -> s
    | Error _ -> ""
    ))

-- ── get_table ───────────────────────────────────────────────────────────

test "get_table returns Map" (fn t ->
  let tm = TOML.parse! "a = 1\nb = 2\n";
  t.eq
    2
    (match TOML.get_table tm with
    | Ok m -> Map.size m
    | Error _ -> -1
    ))

-- ── read_file ───────────────────────────────────────────────────────────

test "read_file ok" (fn t ->
  with FS.temp_file "wand_toml_rd_" ".toml" as p -> (
    FS.write_file! p "[db]\nname = \"mydb\"\n";
    let outcome =
      (match TOML.read_file p with
       | Ok tm -> (
         let db = TOML.field! "db" tm;
         match TOML.get_string (TOML.field! "name" db) with
         | Ok s -> s
         | Error _ -> ""
       )
       | Error _ -> "");
    t.eq "mydb" outcome
  ))

test "read_file missing file returns Error" (fn t ->
  t.eq
    "error"
    (match TOML.read_file (Path.of_string "/nonexistent/wand_missing.toml") with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

-- `of` is what builds a TOML document; before it, a value could only be
-- re-printed after being parsed.
test "of a map" (fn t -> t.eq "a = 1\nb = 2\n" (TOML.stringify (TOML.of! {a = 1, b = 2})))
test "of a list" (fn t ->
  t.eq `tags = ["a", "b"]` (String.trim (TOML.stringify (TOML.of! {tags = ["a", "b"]}))))
test "a document is a table" (fn t ->
  match TOML.of 5 with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "is a table" why))
test "a function cannot be written" (fn t ->
  match TOML.of {f = fn x -> x} with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "cannot write" why))
test "it round trips" (fn t ->
  t.eq
    (Ok 8080)
    (TOML.get_int
      (TOML.field! "port" (TOML.parse! (TOML.stringify (TOML.of! {port = 8080}))))))

-- ── Key order ───────────────────────────────────────────────────────────

-- A table keeps the order its keys were written in, as a JSON object, a
-- YAML mapping and a Map do. The library wand parses with sorts them, and
-- the page that read a TOML file of groups came out alphabetical (#192).
let ordered = `
zeta = 1
alpha = 2
inline = { z = 1, a = 2 }
text = """
[not.a.header]
"""

[zebra]
b = 1
a = 2

[apple]
z = 1
`

test "a table keeps the order its keys were written in" (fn t ->
  t.eq
    (Ok ["zeta", "alpha", "inline", "text", "zebra", "apple"])
    (TOML.parse! ordered |> TOML.get_table |> Result.map Map.keys))

test "an inline table keeps its order" (fn t ->
  t.eq
    (Ok ["z", "a"])
    (TOML.field! "inline" (TOML.parse! ordered) |> TOML.get_table |> Result.map Map.keys))

test "a section keeps its order" (fn t ->
  t.eq
    (Ok ["b", "a"])
    (TOML.field! "zebra" (TOML.parse! ordered) |> TOML.get_table |> Result.map Map.keys))

test "stringify writes the keys in their order" (fn t ->
  t.eq
    "zebra = 1\napple = 2\n[later]\nz = 1\na = 2\n"
    (TOML.stringify (TOML.parse! "zebra = 1\napple = 2\n[later]\nz = 1\na = 2\n")))

test "of keeps a map's order" (fn t ->
  t.eq
    "zebra = 1\napple = 2\n"
    (TOML.stringify (TOML.of! (Map.from_list [("zebra", 1), ("apple", 2)]))))

test "decoding to a Map keeps the order" (fn t ->
  t.eq
    (Ok ["zebra", "apple"])
    (TOML.decode (Decode.dict Decode.int) (TOML.parse! "zebra = 1\napple = 2\n")
    |> Result.map Map.keys))

-- A quoted key is the text between the quotes. It came back with them.
test "a quoted key has no quotes in it" (fn t ->
  t.eq (Ok ["a.b"]) (TOML.parse! "\"a.b\" = 1\n" |> TOML.get_table |> Result.map Map.keys))

-- An empty table is written with its header. It was left out, so the
-- document read back without it.
test "an empty table is written" (fn t ->
  t.eq "[a]\n[b]\nx = 1\n" (TOML.stringify (TOML.parse! "[a]\n[b]\nx = 1\n")))
