let {test} = import Test
import String

-- ── String concatenation ────────────────────────────────────────────────

test "simple concat" (fn t -> t.eq "hello world" ("hello" ++ " world"))

test "concat with var" (fn t ->
  let name = "Alice";
  t.eq "Hello, Alice!" ("Hello, " ++ name ++ "!"))

test "concat empty" (fn t -> t.eq "abc" ("" ++ "abc"))

-- ── String interpolation ────────────────────────────────────────────────

test "simple interp" (fn t -> (let name = "World"; t.eq "Hello, World!" "Hello, %{name}!"))

test "interp arithmetic" (fn t -> t.eq "1 + 2 = 3" "1 + 2 = %{1 + 2}")
test "interp bool" (fn t -> t.eq "flag: true" "flag: %{true}")
test "no interp" (fn t -> t.eq "plain string" "plain string")

test "multiple interps" (fn t -> (let x = "a"; let y = "b"; t.eq "a and b" "%{x} and %{y}"))

-- ── Backtick strings ────────────────────────────────────────────────────

-- Everything between backticks is itself. The point is text that would
-- otherwise be a wall of backslashes: JSON, a regex, a Windows path.

test "a quote needs no escape" (fn t -> t.eq `{"hello": "world"}` `{"hello": "world"}`)

test "a backslash is a backslash" (fn t -> t.eq "\\d+\\s*" `\d+\s*`)

test "shell source is kept as written" (fn t ->
  t.eq "export PATH=$HOME/bin" `export PATH=$HOME/bin`)

test "it is an ordinary String" (fn t -> t.eq "abc" (`ab` ++ `c`))

-- A newline straight after the opening backtick is layout, not text.
-- Nothing else is trimmed -- the indent and the last newline are kept.

test "the opening newline is dropped" (fn t ->
  t.eq "one\ntwo\n" `
one
two
`)

test "an indent inside is text" (fn t ->
  t.eq "  indented\n" `
  indented
`)

test "a blank first line survives" (fn t ->
  t.eq "\nafter a blank line\n" `

after a blank line
`)

test "interpolation still works" (fn t ->
  let who = "ada";
  t.eq `{"name": "ada"}` `{"name": "%{who}"}`)

test "as a pattern" (fn t ->
  t.eq
    "matched"
    (match "hi" with
    | "hi" -> "matched"
    | _ -> "no"
    ))

-- ── Byte escapes ────────────────────────────────────────────────────────

-- A String is bytes, and `\xNN` writes one by its value: 255 starts a
-- telnet command, and no character spells it.
test "a byte escape is one byte" (fn t -> t.eq 3 (String.length "\xff\xfb\x01"))
test "a byte escape can spell ASCII" (fn t -> t.eq "A" "A")
test "two byte escapes can spell a character" (fn t -> t.eq "café" "café")
