let {test} = import Test

-- Private-symbol-access denial and missing-destructure-field errors both
-- fail the whole file to typecheck before any test body runs, and both need
-- a relative import resolved against this file's own directory, so those two
-- cases live in test_imports.ml. Everything else is here.

-- A module is named in upper case. A file named so is imported by its
-- name; any file can be bound to a name with `let`.
let MyLib = import ./ImportsFixture

test "whole module bound to name" (fn t -> t.eq 42 MyLib.answer)
test "function call via bound name" (fn t -> t.eq 42 (MyLib.double 21))
test "multiple fields accessible" (fn t -> t.eq 3 (MyLib.x + MyLib.y))

import ./ImportsFixture

test "bare import binds the file's name" (fn t -> t.eq 42 ImportsFixture.answer)

let L = import List
let Strs = import String

test "stdlib bound to custom name" (fn t -> t.eq 3 (L.length [1, 2, 3]))
test "stdlib with different local name" (fn t -> t.eq "HELLO" (Strs.upper "hello"))

let {foo = a, bar = b} = import ./ImportsFixture

test "destructure two fields" (fn t -> t.eq 30 (a + b))

let {double = dbl} = import ./ImportsFixture

test "destructure function" (fn t -> t.eq 42 (dbl 21))

let {answer, pi} = import ./ImportsFixture

test "shorthand list destructure" (fn t -> t.eq 45 (answer + pi))
