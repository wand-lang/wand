let {test} = import Test
import Args
import CSV
import Decode
import JSON
import List
import Result
import TOML
import YAML

-- A single-constructor type whose fields are named already says what a
-- decoder for it would do: the field names, and what each one holds. So
-- `T.decoder` is read off the definition rather than written out beside it,
-- and a field added to the type is a field added to the decoder.
--
-- Only the flat record is covered. Nested keys, renamed keys and validation
-- are what a hand-written decoder is for.

type Pod(name: String, restarts: Int, timeout: Duration)

let doc = JSON.parse! `{"name": "web-01", "restarts": 4, "timeout": "30s"}`

test "a type is its own decoder" (fn t ->
  t.eq (Ok Pod(name = "web-01", restarts = 4, timeout = 30s)) (JSON.decode Pod.decoder doc))

-- The whole point of deriving: there is no second copy to go stale. This
-- type has a field the one above does not, and nothing else was written.
type Pod2(name: String, restarts: Int, timeout: Duration, node: String)

test "a field added to the type is read by the decoder" (fn t ->
  let with_node = JSON.parse! `{"name": "a", "restarts": 1, "timeout": "1h", "node": "n1"}`;
  t.eq
    (Ok Pod2(name = "a", restarts = 1, timeout = 1h, node = "n1"))
    (JSON.decode Pod2.decoder with_node))

test "and a document missing it is refused, by name" (fn t ->
  t.eq (Error ".node: no such field") (JSON.decode Pod2.decoder doc))

test "a field of the wrong type is named too" (fn t ->
  let wrong = JSON.parse! `{"name": "a", "restarts": "many", "timeout": "1h"}`;
  t.eq (Error `.restarts: expected Int, got "many"`) (JSON.decode Pod.decoder wrong))

-- A domain literal decodes as itself here as anywhere else.
type Server(host: IPv4, port: Port, at: DateTime)

test "domain fields decode as themselves" (fn t ->
  let s = JSON.parse! `{"host": "10.0.0.4", "port": 8080, "at": "2024-01-15T14:30:00Z"}`;
  t.eq
    (Ok Server(host = 10.0.0.4, port = :8080, at = 2024-01-15T14:30:00Z))
    (JSON.decode Server.decoder s))

-- An `Option` field is the one that may be absent -- which is what the type
-- says. Every other field must be there.
type Job(name: String, owner: Option String)

test "an Option field may be absent" (fn t ->
  t.eq
    (Ok Job(name = "build", owner = None))
    (JSON.decode Job.decoder (JSON.parse! `{"name": "build"}`)))

test "and is Some when it is there" (fn t ->
  t.eq
    (Ok Job(name = "build", owner = Some "ci"))
    (JSON.decode Job.decoder (JSON.parse! `{"name": "build", "owner": "ci"}`)))

test "but is still refused when it is there and wrong" (fn t ->
  t.eq
    (Error ".owner: expected String, got Int")
    (JSON.decode Job.decoder (JSON.parse! `{"name": "b", "owner": 3}`)))

-- A field holding another derivable type, and the path through both.
type Meta(name: String, ready: Bool)

type Wrapper(metadata: Meta, replicas: Int)

test "a field of another type uses that type's decoder" (fn t ->
  let w = JSON.parse! `{"metadata": {"name": "web", "ready": true}, "replicas": 3}`;
  t.eq
    (Ok Wrapper(metadata = Meta(name = "web", ready = true), replicas = 3))
    (JSON.decode Wrapper.decoder w))

test "and the path names every step of the way in" (fn t ->
  let w = JSON.parse! `{"metadata": {"name": 1, "ready": true}, "replicas": 3}`;
  t.eq (Error ".metadata.name: expected String, got Int") (JSON.decode Wrapper.decoder w))

-- A type that mentions itself. The decoders of the types a field mentions
-- are found when that field is decoded, not when the decoder is built --
-- which is the only reason this terminates.
type Node(label: String, children: List Node)

test "a recursive type has a decoder" (fn t ->
  let tree = JSON.parse! `{"label": "root", "children": [{"label": "a", "children": []}]}`;
  t.eq
    (Ok Node(label = "root", children = [Node(label = "a", children = [])]))
    (JSON.decode Node.decoder tree))

test "and reports where in the tree it gave up" (fn t ->
  let tree = JSON.parse! `{"label": "r", "children": [{"label": 3, "children": []}]}`;
  t.eq
    (Error ".children[0].label: expected String, got Int")
    (JSON.decode Node.decoder tree))

-- A derived decoder is an ordinary value: it can be named, passed, and used
-- with every combinator a hand-written one can.
test "a derived decoder is a value like any other" (fn t ->
  let pods = Decode.field "items" (Decode.list Pod.decoder);
  let doc2 = JSON.parse! `{"items": [{"name": "a", "restarts": 0, "timeout": "5s"}]}`;
  t.eq (Ok [Pod(name = "a", restarts = 0, timeout = 5s)]) (JSON.decode pods doc2))

-- The other direction. An encoder is an ordinary function -- encoding cannot
-- fail, so there is nothing for a type of its own to carry -- and it is
-- derived from the same fields the decoder reads.

type Endpoint(host: IPv4, port: Port, timeout: Duration, label: Option String)

let one = Endpoint(host = 10.0.0.4, port = :8080, timeout = 30s, label = Some "web")

let bare = Endpoint(host = 10.0.0.5, port = :9090, timeout = 1h, label = None)

test "a type writes itself back out" (fn t ->
  t.eq
    `{"host":"10.0.0.4","port":8080,"timeout":"30s","label":"web"}`
    (JSON.stringify (Endpoint.encoder one)))

-- A field holding None is left out rather than written as null. Both read
-- back as None; a config is tidier without the empty keys.
test "an absent field is left out" (fn t ->
  t.eq
    `{"host":"10.0.0.5","port":9090,"timeout":"1h"}`
    (JSON.stringify (Endpoint.encoder bare)))

-- What the pair is for: read a document, and write back what you read.
test "what is decoded encodes back to itself" (fn t ->
  t.eq (Ok one) (JSON.decode Endpoint.decoder (Endpoint.encoder one)))

test "including the fields that were not there" (fn t ->
  t.eq (Ok bare) (JSON.decode Endpoint.decoder (Endpoint.encoder bare)))

type Cluster(region: String, servers: List Endpoint, counts: Map Int)

test "and so does a document with lists, maps and nested types in it" (fn t ->
  let c = Cluster(region = "eu-west", servers = [one, bare], counts = {warn = 2, error = 5});
  t.eq (Ok c) (JSON.decode Cluster.decoder (Cluster.encoder c)))

-- The whole point, at the level a script sees it: a document in, the same
-- document out, but for the change.
type Config(name: String, port: Port, timeout: Duration, replicas: Int)

test "a document read, changed, and written back" (fn t -> (
  let document = `{"name": "api", "port": 8080, "timeout": "30s", "replicas": 2}`;
  match JSON.decode Config.decoder (JSON.parse! document) with
  | Error why -> t.eq "decoded" why
  | Ok (Config(name = n, port = p, timeout = d, replicas = _)) -> (
    let scaled = Config(name = n, port = p, timeout = d, replicas = 4);
    t.eq
      `{"name":"api","port":8080,"timeout":"30s","replicas":4}`
      (JSON.stringify (Config.encoder scaled))
  )
))

-- A type with parameters takes one decoder for each, in the order it
-- declares them, and gives back a decoder for the applied type.

type Paged 'a(items: List 'a, total: Int)

type Tree 'a(value: 'a, children: List (Tree 'a))

test "a generic type is decoded by supplying a decoder per parameter" (fn t ->
  let doc = JSON.parse! `{"items": [1, 2, 3], "total": 3}`;
  t.eq (Ok Paged(items = [1, 2, 3], total = 3)) (JSON.decode (Paged.decoder Decode.int) doc))

test "and the argument can be another derived decoder" (fn t ->
  t.eq
    (Ok Paged(items = [Meta(name = "web", ready = true)], total = 1))
    (JSON.decode
      (Paged.decoder Meta.decoder)
      (JSON.parse! `{"items": [{"name": "web", "ready": true}], "total": 1}`)))

test "a failure inside the parameter still names its place" (fn t ->
  let doc = JSON.parse! `{"items": [1, "x"], "total": 2}`;
  t.eq
    (Error `.items[1]: expected Int, got "x"`)
    (JSON.decode (Paged.decoder Decode.int) doc))

-- Generic and recursive at once: the type mentions itself with the same
-- argument, and the decoders are found when the field is reached.
test "a generic type may mention itself" (fn t ->
  let doc = JSON.parse! `{"value": 1, "children": [{"value": 2, "children": []}]}`;
  t.eq
    (Ok Tree(value = 1, children = [Tree(value = 2, children = [])]))
    (JSON.decode (Tree.decoder Decode.int) doc))

-- The encoder takes one encoder per parameter, and the one supplied is the
-- one that runs -- it is not a structural walk that ignores what it is
-- given.
test "a generic type is encoded by supplying an encoder per parameter" (fn t ->
  t.eq
    `{"items":[1,2,3],"total":3}`
    (JSON.stringify (Paged.encoder JSON.of_int Paged(items = [1, 2, 3], total = 3))))

test "and that encoder is the one that runs" (fn t ->
  t.eq
    `{"items":["n=1"],"total":1}`
    (JSON.stringify
      (Paged.encoder (fn n -> JSON.of_string "n=%{n}") Paged(items = [1], total = 1))))

test "a generic round trip" (fn t ->
  let p = Paged(items = [1, 2], total = 2);
  t.eq (Ok p) (JSON.decode (Paged.decoder Decode.int) (Paged.encoder JSON.of_int p)))

-- A derived member through the module that declares the type. The table of
-- derivable types holds one entry per short name, so two modules that each
-- declare an `Item` share it; the qualified form has to reach the one whose
-- module was named.
let A = import ./derive_fixture_a
let B = import ./derive_fixture_b

test "a decoder is reached through its module" (fn t ->
  t.eq
    (Ok A.Item(name = "a", count = 2))
    (JSON.decode A.Item.decoder (JSON.parse! `{"name":"a","count":2}`)))

test "and it is that module's type, not the other's" (fn t ->
  t.eq
    (Ok B.Item(name = "a", tag = "x", weight = 2))
    (JSON.decode B.Item.decoder (JSON.parse! `{"name":"a","tag":"x","weight":2}`)))

test "an encoder is reached the same way" (fn t ->
  t.eq
    `{"name":"a","count":2}`
    (JSON.stringify (A.Item.encoder A.Item(name = "a", count = 2))))

test "a nested field reads the declaring module's type" (fn t ->
  let boxed = A.Boxed(tag = A.Tag(label = "L"), size = 2);
  t.eq
    (Ok boxed)
    (JSON.decode A.Boxed.decoder (JSON.parse! `{"tag":{"label":"L"},"size":2}`)))

test "and the other module's is its own" (fn t ->
  let boxed = B.Boxed(tag = B.Tag(label = "L"));
  t.eq (Ok boxed) (JSON.decode B.Boxed.decoder (JSON.parse! `{"tag":{"label":"L"}}`)))

-- A sum is read without a tag when its value says which constructor it
-- is: a bare word is written as the word, and a constructor holding one
-- value is written as the value, when no two values share a kind.
-- Kubernetes writes `imagePullPolicy` the first way and `maxSurge` the
-- second.
type IntOrString = I Int | S String
type PullPolicy = Always | Never | IfNotPresent
type Rollout(maxSurge: IntOrString, pull: PullPolicy)

test "an untagged sum reads by the kind of its value" (fn t ->
  t.eq
    (Ok Rollout(maxSurge = S "25%", pull = Never))
    (JSON.decode Rollout.decoder (JSON.parse! `{"maxSurge": "25%", "pull": "Never"}`)))

test "and writes the value alone" (fn t ->
  t.eq
    `{"maxSurge":1,"pull":"Always"}`
    (JSON.stringify (Rollout.encoder Rollout(maxSurge = I 1, pull = Always))))

test "a kind no constructor holds is named" (fn t ->
  t.eq
    (Error ".maxSurge: expected a number or a string, got Bool")
    (JSON.decode Rollout.decoder (JSON.parse! `{"maxSurge": true, "pull": "Never"}`)))

test "a word the enum does not have is named, with the ones it has" (fn t ->
  t.eq
    (Error `.pull: expected one of Always, Never, IfNotPresent, got "Sometimes"`)
    (JSON.decode Rollout.decoder (JSON.parse! `{"maxSurge": 1, "pull": "Sometimes"}`)))

test "a sum is its own decoder and encoder" (fn t ->
  t.eq `"IfNotPresent"` (JSON.stringify (PullPolicy.encoder IfNotPresent)))

-- A field of an alias type is read and written as the type it names, and
-- a JSON field holds whatever the document holds there.
type Quantity = String
type Limits(cpu: Quantity, raw: Option JSON = None)

test "an alias field reads as its target" (fn t ->
  t.eq
    (Ok Limits(cpu = "500m", raw = None))
    (JSON.decode Limits.decoder (JSON.parse! `{"cpu": "500m"}`)))

test "a JSON field keeps what the document holds" (fn t ->
  let doc = `{"cpu":"1","raw":{"a":[1,true,null]}}`;
  t.eq
    doc
    (match JSON.decode Limits.decoder (JSON.parse! doc) with
    | Ok l -> JSON.stringify (Limits.encoder l)
    | Error e -> e
    ))

-- A field may name the key it has in a document, where the document spells
-- it in a way a field name cannot be. In wand code the field is its name.
type DaemonEndpoint(port "Port": Int)
type Props(
  ref "$ref": Option String = None,
  list_type "x-kubernetes-list-type": Option String = None
)
type NodeInfo(endpoint: DaemonEndpoint, props: List Props)

test "a field is read by its key" (fn t ->
  t.eq
    (Ok NodeInfo(endpoint = DaemonEndpoint(port = 10250), props = [Props(ref = Some "#/a")]))
    (JSON.decode
      NodeInfo.decoder
      (JSON.parse! `{"endpoint": {"Port": 10250}, "props": [{"$ref": "#/a"}]}`)))

test "and written by it" (fn t ->
  t.eq `{"Port":7}` (JSON.stringify (DaemonEndpoint.encoder DaemonEndpoint(port = 7))))

test "a missing field is named by its key" (fn t ->
  t.eq
    (Error ".Port: no such field")
    (JSON.decode DaemonEndpoint.decoder (JSON.parse! `{"port": 1}`)))

-- A command line is not a document: its flags are the fields' names.
type Flags(dry_run "dry-run": Bool = false)

test "a flag keeps the field's name" (fn t ->
  t.eq (Ok Flags(dry_run = true)) (Args.read Flags.parser ["--dry_run"]))

-- TOML writes what JSON writes: a field by its key, a sum without its tag.
test "TOML.of writes a field by its key" (fn t ->
  t.eq (Ok "Port = 7\n") (TOML.of DaemonEndpoint(port = 7) |> Result.map TOML.stringify))

test "and a sum without its tag" (fn t ->
  t.eq
    (Ok "maxSurge = \"25%\"\npull = \"Never\"\n")
    (TOML.of Rollout(maxSurge = S "25%", pull = Never) |> Result.map TOML.stringify))

-- A constructor with no payload can have its own spelling in documents,
-- for a value that cannot be a constructor name. In wand code the
-- constructor is its name.
type DnsPolicy = ClusterFirst | Default | None_ "None"
type Operation = All "*" | CREATE | ClientAuth "client auth"
type Workload(dns: DnsPolicy, op: Operation)

test "a constructor is read by its spelling" (fn t ->
  t.eq
    (Ok Workload(dns = DnsPolicy.None_, op = Operation.All))
    (JSON.decode Workload.decoder (JSON.parse! `{"dns": "None", "op": "*"}`)))

test "and written by it" (fn t ->
  t.eq
    `{"dns":"None","op":"client auth"}`
    (JSON.stringify
      (Workload.encoder Workload(dns = DnsPolicy.None_, op = Operation.ClientAuth))))

test "JSON.of and TOML.of write the spelling" (fn t ->
  let p = Workload(dns = DnsPolicy.None_, op = Operation.All);
  t.eq (Ok `{"dns":"None","op":"*"}`, Ok "dns = \"None\"\nop = \"*\"\n") (
    Result.map JSON.stringify (JSON.of p),
    Result.map TOML.stringify (TOML.of p)
  ))

test "TOML, YAML and CSV read the spelling" (fn t ->
  let want = Workload(dns = DnsPolicy.None_, op = Operation.All);
  t.eq [Ok want, Ok want, Ok want] [
    TOML.decode Workload.decoder (TOML.parse! "dns = \"None\"\nop = \"*\""),
    YAML.decode Workload.decoder (YAML.parse! "dns: None\nop: \"*\""),
    CSV.rows Workload.decoder "dns,op\nNone,*" |> Result.map (fn ps -> List.head! ps)
  ])

test "the constructor's name is not its spelling" (fn t ->
  t.eq
    (Error `.dns: expected one of ClusterFirst, Default, None, got "None_"`)
    (JSON.decode Workload.decoder (JSON.parse! `{"dns": "None_", "op": "*"}`)))

test "a flag's value is the spelling too" (fn t ->
  t.eq
    (Ok Workload(dns = DnsPolicy.Default, op = Operation.ClientAuth))
    (Args.read Workload.parser ["--dns", "Default", "--op", "client auth"]))
