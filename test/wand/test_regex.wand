let {test} = import Test
import List
import Regex
import String
import Result
import Par

-- ── Literals ────────────────────────────────────────────────────────────

test "regex has type Regex" (fn t -> (let re = r/\d+/; t.ok (Regex.match? re "abc123")))
test "regex literal inline" (fn t -> t.ok (Regex.match? r/hello/ "say hello"))

-- ── Regex.match? ───────────────────────────────────────────────────────

test "match found" (fn t -> t.ok (Regex.match? r/\d+/ "abc123"))
test "match not found" (fn t -> t.eq false (Regex.match? r/\d+/ "abc"))
test "match partial" (fn t -> t.ok (Regex.match? r/b/ "abc"))
test "match anchored" (fn t -> t.ok (Regex.match? r/^\d+$/ "123"))
test "match anchored fail" (fn t -> t.eq false (Regex.match? r/^\d+$/ "1a"))

-- ── Flags ───────────────────────────────────────────────────────────────

test "flags case-insensitive i" (fn t -> t.ok (Regex.match? r/hello/i "HELLO"))
test "flags case-insensitive miss without flag" (fn t ->
  t.eq false (Regex.match? r/hello/ "HELLO"))
test "flags multiline m - ^ matches line start" (fn t ->
  t.ok (Regex.match? r/^world/m "hello\nworld"))
test "flags dotall s - . matches newline" (fn t -> t.ok (Regex.match? r/a.b/s "a\nb"))
test "flags dotall off by default" (fn t -> t.eq false (Regex.match? r/a.b/ "a\nb"))

-- ── Regex.capture ──────────────────────────────────────────────────────

test "capture no match returns empty list" (fn t ->
  t.eq 0 (List.length (Regex.capture r/\d+/ "abc")))
test "capture full match at index 0" (fn t ->
  t.eq "123" (List.head! (Regex.capture r/\d+/ "abc123")))
test "capture groups" (fn t ->
  t.eq ["user@host", "user", "host"] (Regex.capture r/(\w+)@(\w+)/ "user@host"))
test "capture two groups" (fn t ->
  t.eq ["2026-05", "2026", "05"] (Regex.capture r/^(\d+)-(\d+)$/ "2026-05"))
test "capture pattern match on result" (fn t ->
  match Regex.capture r/^(\S+)\s+(\d+)/ "foo 42" with
  | [] -> t.eq "foo:42" "no match"
  | [_, name, num] -> t.eq "foo:42" "%{name}:%{num}"
  | _ -> t.eq "foo:42" "other")

-- ── Regex.replace ───────────────────────────────────────────────────

test "replace first match" (fn t -> t.eq "aXb2c3" (Regex.replace r/\d+/ "X" "a1b2c3"))
test "replace no match returns original" (fn t ->
  t.eq "abc" (Regex.replace r/\d+/ "X" "abc"))

-- ── Regex.replace_all ───────────────────────────────────────────────

test "replace_all matches" (fn t -> t.eq "aXbXcX" (Regex.replace_all r/\d+/ "X" "a1b2c3"))
test "replace_all no match returns original" (fn t ->
  t.eq "abc" (Regex.replace_all r/\d+/ "X" "abc"))
test "replace_all with empty string" (fn t ->
  t.eq "abc" (Regex.replace_all r/\s+/ "" "a b  c"))

-- ── Regex.split ─────────────────────────────────────────────────────

test "split_re on whitespace" (fn t -> t.eq ["a", "b", "c"] (Regex.split r/\s+/ "a  b   c"))
test "split_re on delimiter" (fn t -> t.eq ["a", "b", "c"] (Regex.split r/,\s*/ "a, b,c"))

-- ── Regex.match_all ────────────────────────────────────────────────────

test "match_all digit runs" (fn t ->
  t.eq ["1", "22", "333"] (Regex.match_all r/\d+/ "a1b22c333"))
test "match_all no matches" (fn t -> t.eq [] (Regex.match_all r/\d+/ "abc"))
test "match_all tokenizer-style alternation" (fn t ->
  let got = Regex.match_all r/[a-zA-Z_]\w*|[{}=]|"[^"]*"/ `block{x="1"}`;
  t.eq ["block", "{", "x", "=", `"1"`, "}"] got)

-- ── Regex module ────────────────────────────────────────────────────────

test "Regex.match?" (fn t -> t.ok (Regex.match? r/\d+/ "abc123"))
test "Regex.capture" (fn t -> t.eq ["123", "123"] (Regex.capture r/(\d+)/ "abc123"))
test "Regex.replace" (fn t -> t.eq "aXb2" (Regex.replace r/\d+/ "X" "a1b2"))
test "Regex.replace_all" (fn t -> t.eq "aXbX" (Regex.replace_all r/\d+/ "X" "a1b2"))
test "Regex.split" (fn t -> t.eq ["a", "b", "c"] (Regex.split r/,/ "a,b,c"))

-- ── Regex.compile ───────────────────────────────────────────────────────

test "compile valid pattern" (fn t ->
  match Regex.compile "\\d+" with
  | Ok re -> t.eq true (Regex.match? re "abc123")
  | Error _ -> t.ok false)
test "compile invalid pattern returns Error" (fn t ->
  match Regex.compile "[invalid" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)

-- A counted repeat is expanded when the pattern is compiled, so the cost is
-- the count and nothing else. `a{999999999}` took minutes and the memory to
-- match, from a pattern alone -- matching is a non-backtracking automaton,
-- so no input can make a compiled pattern worse.
test "a repeat count past the bound is refused" (fn t ->
  match Regex.compile "a{999999999}" with
  | Ok _ -> t.ok false
  | Error why -> t.ok (String.contains? "repeat" why))
test "and one too long to be a number" (fn t ->
  match Regex.compile "a{99999999999999999999}" with
  | Ok _ -> t.ok false
  | Error why -> t.ok (String.contains? "repeat" why))
test "the bound itself still compiles" (fn t ->
  match Regex.compile "a{10000}" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "an ordinary repeat is untouched" (fn t -> t.ok (Regex.match? r/[0-9]{3}/ "abc123"))
test "a brace in a character class is a brace" (fn t ->
  match Regex.compile "[{]{2}" with
  | Ok re -> t.eq true (Regex.match? re "a{{b")
  | Error _ -> t.ok false)
test "an escaped brace is a brace" (fn t ->
  match Regex.compile "a\\{999999999\\}" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "a literal is bounded the same way" (fn t ->
  t.raises (fn () -> Regex.match? r/a{999999999}/ "aaa"))

-- ── A literal is compiled once ───────────────────────────────────────────

-- `Re.compile` used to run on every evaluation of a regex literal, so a
-- pattern written inside a loop was recompiled once per iteration -- about
-- 5us each, and a second of it over a 200k-line file. The compiled form is
-- cached on the pattern and the flags as written. These pin what the cache
-- must not break: a key that ignored the flags would collide, and a cached
-- pattern must not turn a failing literal into a passing one.

test "the same pattern under different flags stays two patterns" (fn t ->
  t.eq (true, false) (Regex.match? r/ABC/i "abc", Regex.match? r/ABC/ "abc"))

test "and in either order" (fn t ->
  t.eq (false, true) (Regex.match? r/DEF/ "def", Regex.match? r/DEF/i "def"))

test "an oversized repeat still raises on every evaluation" (fn t ->
  t.eq
    [true, true]
    (List.map (fn i -> Result.error? (try Regex.match? r/a{999999}/ "x")) [1, 2]))

test "a literal in a loop answers the same as one hoisted out" (fn t ->
  let hoisted = r/(\d+)/;
  let inline = List.map (fn s -> Regex.capture r/(\d+)/ s) ["a1", "b22", "c"];
  let out = List.map (fn s -> Regex.capture hoisted s) ["a1", "b22", "c"];
  t.eq out inline)

-- Par workers evaluate on domains of their own, which is why the cache is
-- per domain rather than shared.
test "a literal works inside Par workers" (fn t ->
  t.eq 40 (List.length (Par.map 8 (fn i -> Regex.match? r/^a+$/ "aaa") (List.range 1 40))))

-- `\xNN` inside a character class is the byte, as it is outside one.
test "a byte range in a class" (fn t ->
  t.eq (true, false) (
    Regex.match? r/^[\xfb-\xfe]$/ "\xfc",
    Regex.match? r/^[\xfb-\xfe]$/ "\xfa"
  ))
test "a byte that closes a class stays in it" (fn t ->
  t.ok (Regex.match? r/^[a\x5d]+$/ "a]a"))
test "Regex.compile reads it too" (fn t ->
  t.eq
    (Ok true)
    (Result.map (fn r -> Regex.match? r "\xfd") (Regex.compile "[\\xfb-\\xfe]")))
