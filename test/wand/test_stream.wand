uses {FS.Read, FS.Write, IO}

import List
import Map
import Test
let {test} = import Test
import FS
import Int
import IO
import Option
import Path
import Stream
import String

-- A stream reads nothing until a terminal operation runs it, and each
-- run is a fresh enumeration.

test "of_list to_list round-trips" (fn t ->
  t.eq [1, 2, 3] (Stream.of_list [1, 2, 3] |> Stream.to_list))

test "map transforms as elements flow" (fn t ->
  t.eq [2, 4, 6] (Stream.of_list [1, 2, 3] |> Stream.map (fn x -> x * 2) |> Stream.to_list))

test "filter keeps what the predicate approves" (fn t ->
  t.eq
    [2, 4]
    (Stream.of_list [1, 2, 3, 4] |> Stream.filter (fn x -> x % 2 == 0) |> Stream.to_list))

test "take passes at most n" (fn t ->
  t.eq [1, 2] (Stream.of_list [1, 2, 3, 4] |> Stream.take 2 |> Stream.to_list))

test "stages fuse in order" (fn t ->
  t.eq
    [4, 6]
    (Stream.of_list [1, 2, 3, 4]
    |> Stream.map (fn x -> x * 2)
    |> Stream.filter (fn x -> x > 2)
    |> Stream.take 2
    |> Stream.to_list))

test "fold_left folds every element" (fn t ->
  t.eq 10 (Stream.of_list [1, 2, 3, 4] |> Stream.fold_left (fn a x -> a + x) 0))

test "each runs in order for its effects" (fn t ->
  let seen = Stream.of_list ["a", "b"] |> Stream.fold_left (fn acc x -> acc ++ x) "";
  t.eq "ab" seen)

test "a mocked file stream feeds the fold" (fn t ->
  let count log = FS.stream_lines log |> Stream.fold_left (fn n _ -> n + 1) 0;
  t.eq 3 (Test.with_lines ./mock.log ["a", "b", "c"] (fn () -> count ./mock.log)))

test "an unmocked path streams empty under with_lines" (fn t ->
  let count log = FS.stream_lines log |> Stream.fold_left (fn n _ -> n + 1) 0;
  t.eq 0 (Test.with_lines ./mock.log ["a"] (fn () -> count ./other.log)))

test "each fold reads the source afresh" (fn t ->
  let s = Stream.of_list [1, 2, 3];
  t.eq (6, 6) (
    Stream.fold_left (fn a x -> a + x) 0 s,
    Stream.fold_left (fn a x -> a + x) 0 s
  ))

test "a missing file raises at the fold, catchably" (fn t ->
  let go () = FS.stream_lines ./does-not-exist.log |> Stream.fold_left (fn n _ -> n + 1) 0;
  t.eq
    true
    (match try go () with
    | Ok _ -> false
    | Error why -> String.contains? "does-not-exist" why
    ))

-- ── the terminals that fold ─────────────────────────────────────────────

-- Each of these reads the whole source. `count` is not called `length`
-- for that reason: counting twice reads twice.

test "count counts the elements" (fn t -> t.eq 3 (Stream.of_list [1, 2, 3] |> Stream.count))
test "count of an empty source" (fn t ->
  let empty : List Int = [];
  t.eq 0 (Stream.of_list empty |> Stream.count))
test "count sees the stages above it" (fn t ->
  t.eq 2 (Stream.of_list [1, 2, 3, 4] |> Stream.filter (fn x -> x % 2 == 0) |> Stream.count))

test "last is the final element" (fn t ->
  t.eq (Some 3) (Stream.of_list [1, 2, 3] |> Stream.last))
test "last of an empty source" (fn t ->
  let empty : List Int = [];
  t.eq (None) (Stream.of_list empty |> Stream.last))

test "sum totals the elements" (fn t ->
  t.eq (Some 6) (Stream.of_list [1, 2, 3] |> Stream.sum))
test "sum totals Sizes" (fn t ->
  t.eq (Some 1500B) (Stream.of_list [1KB, 500B] |> Stream.sum))
test "sum of an empty source" (fn t ->
  let empty : List Int = [];
  t.eq (None) (Stream.of_list empty |> Stream.sum))

test "max of the elements" (fn t -> t.eq (Some 3) (Stream.of_list [3, 1, 2] |> Stream.max))
test "min of the elements" (fn t -> t.eq (Some 1) (Stream.of_list [3, 1, 2] |> Stream.min))
test "max of an empty source" (fn t ->
  let empty : List Int = [];
  t.eq (None) (Stream.of_list empty |> Stream.max))

-- ── the terminals that stop early ───────────────────────────────────────

test "empty? on an empty source" (fn t ->
  let empty : List Int = [];
  t.eq true (Stream.of_list empty |> Stream.empty?))
test "empty? on a source with one element" (fn t ->
  t.eq false (Stream.of_list [1] |> Stream.empty?))

test "any? finds a match" (fn t ->
  t.eq true (Stream.of_list [1, 2, 3] |> Stream.any? (fn x -> x > 2)))
test "any? with no match" (fn t ->
  t.eq false (Stream.of_list [1, 2, 3] |> Stream.any? (fn x -> x > 9)))
test "all? holds" (fn t ->
  t.eq true (Stream.of_list [1, 2, 3] |> Stream.all? (fn x -> x > 0)))
test "all? fails on one miss" (fn t ->
  t.eq false (Stream.of_list [1, 2, 3] |> Stream.all? (fn x -> x > 1)))
test "all? of an empty source holds" (fn t ->
  let empty : List Int = [];
  t.eq true (Stream.of_list empty |> Stream.all? (fn x -> x > 9)))

test "find answers the first match" (fn t ->
  t.eq (Some 2) (Stream.of_list [1, 2, 3] |> Stream.find (fn x -> x > 1)))
test "find with no match" (fn t ->
  t.eq (None) (Stream.of_list [1, 2, 3] |> Stream.find (fn x -> x > 9)))

-- Stopping early is the point of these four, and a stage that raises on
-- every element after the first is how to see that the source stopped
-- being read. If it were read to the end, each of these would raise.
let explode_after_one = Stream.map (fn x -> if x == 1 then x else List.head! [])

test "any? stops at the first match" (fn t ->
  t.eq true (Stream.of_list [1, 2, 3] |> explode_after_one |> Stream.any? (fn x -> x == 1)))
test "all? stops at the first miss" (fn t ->
  t.eq false (Stream.of_list [1, 2, 3] |> explode_after_one |> Stream.all? (fn x -> x > 1)))
test "find stops at the match" (fn t ->
  t.eq
    (Some 1)
    (Stream.of_list [1, 2, 3] |> explode_after_one |> Stream.find (fn x -> x == 1)))
test "empty? reads one element and stops" (fn t ->
  t.eq false (Stream.of_list [1, 2, 3] |> explode_after_one |> Stream.empty?))

-- And the counterpart: a terminal that reads everything does raise.
test "a terminal that reads on meets the raise" (fn t ->
  t.raises (fn () -> Stream.of_list [1, 2, 3] |> explode_after_one |> Stream.count))

-- ── Stages that came with the rest of the design ────────────────────────

test "filter_map maps and filters in one step" (fn t ->
  t.eq
    [20, 40]
    (Stream.of_list [1, 2, 3, 4]
    |> Stream.filter_map (fn x -> if x % 2 == 0 then Some (x * 10) else None)
    |> Stream.to_list))

test "flat_map emits several per element" (fn t ->
  t.eq
    ["a", "b", "c"]
    (Stream.of_list ["a b", "c"]
    |> Stream.flat_map (fn l -> String.split " " l)
    |> Stream.to_list))

test "flat_map can emit nothing" (fn t ->
  t.eq [] (Stream.of_list [1, 2] |> Stream.flat_map (fn _ -> []) |> Stream.to_list))

test "take_while stops at the first refusal" (fn t ->
  t.eq
    [1, 2]
    (Stream.of_list [1, 2, 9, 3] |> Stream.take_while (fn x -> x < 5) |> Stream.to_list))

test "take_while stops the read" (fn t ->
  t.eq [1] (Stream.of_list [1, 9, 2] |> Stream.take_while (fn x -> x < 5) |> Stream.to_list))

test "drop skips from the front" (fn t ->
  t.eq [3] (Stream.of_list [1, 2, 3] |> Stream.drop 2 |> Stream.to_list))

test "drop past the end leaves nothing" (fn t ->
  t.eq [] (Stream.of_list [1, 2] |> Stream.drop 5 |> Stream.to_list))

test "drop_while does not start dropping again" (fn t ->
  t.eq
    [9, 1]
    (Stream.of_list [1, 2, 9, 1] |> Stream.drop_while (fn x -> x < 5) |> Stream.to_list))

test "indexed counts from zero" (fn t ->
  t.eq [(0, "a"), (1, "b")] (Stream.of_list ["a", "b"] |> Stream.indexed |> Stream.to_list))

test "scan answers after each element" (fn t ->
  t.eq
    [1, 3, 6]
    (Stream.of_list [1, 2, 3] |> Stream.scan (fn a x -> a + x) 0 |> Stream.to_list))

test "scan does not emit the starting value" (fn t ->
  t.eq [] (Stream.of_list [] |> Stream.scan (fn a x -> a + x) 0 |> Stream.to_list))

test "chunks groups by n" (fn t ->
  t.eq [[1, 2], [3, 4]] (Stream.of_list [1, 2, 3, 4] |> Stream.chunks 2 |> Stream.to_list))

test "the last chunk holds what is left" (fn t ->
  t.eq [[1, 2], [3]] (Stream.of_list [1, 2, 3] |> Stream.chunks 2 |> Stream.to_list))

-- A stream that stopped early is not owed its buffers.
test "a take before a chunk drops the part-filled group" (fn t ->
  t.eq
    [[1, 2]]
    (Stream.of_list [1, 2, 3, 4, 5] |> Stream.take 3 |> Stream.chunks 2 |> Stream.to_list))

test "unique passes the first of each" (fn t ->
  t.eq [1, 2, 3] (Stream.of_list [1, 2, 1, 3, 2] |> Stream.unique |> Stream.to_list))

-- `unique` files what it has seen by an `eq_key` and settles ties with
-- `==`, the way `List.unique` does. It used to scan a list of everything
-- seen so far, so n distinct items cost n^2/2 comparisons: 20,000 lines took
-- six seconds. Two values `==` calls equal must still collapse to one.
test "unique holds one instant written two ways" (fn t ->
  t.eq [60s, 90s] (Stream.of_list [60s, 1min, 90s, 1min] |> Stream.unique |> Stream.to_list))

test "unique reads values, not text" (fn t ->
  t.eq
    [(1, "a"), (1, "b")]
    (Stream.of_list [(1, "a"), (1, "b"), (1, "a")] |> Stream.unique |> Stream.to_list))

test "the stages compose in the order written" (fn t ->
  t.eq
    [[0, 3], [6]]
    (Stream.of_list [1, 2, 3, 4, 5]
    |> Stream.filter (fn x -> x % 2 == 1)
    |> Stream.indexed
    |> Stream.map (fn p -> (let (i, x) = p; i + x - 1))
    |> Stream.chunks 2
    |> Stream.to_list))

-- ── Several files as one stream ─────────────────────────────────────────

test "stream_lines_all reads the files in order" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let a = Path.join d ./a;
    let b = Path.join d ./b;
    FS.write_file! a "1\n2";
    FS.write_file! b "3";
    t.eq ["1", "2", "3"] (FS.stream_lines_all [a, b] |> Stream.to_list)
  ))

test "stream_lines_all of nothing is empty" (fn t ->
  t.eq [] (FS.stream_lines_all [] |> Stream.to_list))

test "a take stops before the later files are opened" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let a = Path.join d ./a;
    FS.write_file! a "1\n2";
    t.eq
      ["1"]
      (FS.stream_lines_all [a, Path.join d ./missing] |> Stream.take 1 |> Stream.to_list)
  ))

-- ── The sinks ───────────────────────────────────────────────────────────

test "write_lines writes one element per line" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let f = Path.join d ./out;
    FS.write_lines! f (Stream.of_list ["a", "b"]);
    t.eq "a\nb\n" (FS.read_file! f)
  ))

test "write_lines replaces what is there" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let f = Path.join d ./out;
    FS.write_file! f "old\n";
    FS.write_lines! f (Stream.of_list ["new"]);
    t.eq "new\n" (FS.read_file! f)
  ))

test "append_lines adds to the end" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let f = Path.join d ./out;
    FS.write_file! f "a\n";
    FS.append_lines! f (Stream.of_list ["b"]);
    t.eq "a\nb\n" (FS.read_file! f)
  ))

test "append_lines makes the file when it is missing" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let f = Path.join d ./out;
    FS.append_lines! f (Stream.of_list ["a"]);
    t.eq "a\n" (FS.read_file! f)
  ))

test "read, filter and write is two calls" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let log = Path.join d ./app.log;
    let errs = Path.join d ./errors.log;
    FS.write_file! log "ERROR one\nok\nERROR two";
    FS.stream_lines log
    |> Stream.filter (fn l -> String.contains? "ERROR" l)
    |> FS.write_lines! errs;
    t.eq "ERROR one\nERROR two\n" (FS.read_file! errs)
  ))

test "the sink gives back a Result" (fn t ->
  with FS.temp_dir "st_" as d ->
  t.eq ((Ok) ()) (FS.write_lines (Path.join d ./out) (Stream.of_list ["a"])))

-- `tally` is the whole counting loop, so it must answer exactly what the
-- fold it replaces answers -- including the order, which is first-seen and
-- not key order.
test "tally counts each string" (fn t ->
  t.eq {a = 2, b = 1} (Stream.of_list ["a", "b", "a"] |> Stream.tally))

test "tally keeps first-seen order" (fn t ->
  t.eq ["b", "a"] (Stream.of_list ["b", "a", "b"] |> Stream.tally |> Map.keys))

test "tally of nothing is the empty map" (fn t ->
  t.eq Map.empty (Stream.of_list [] |> Stream.tally))

test "tally agrees with the fold it replaces" (fn t ->
  let xs = ["x", "y", "x", "z", "y", "x"];
  let folded = List.fold_left (fn m k -> Map.update k 0 (fn n -> n + 1) m) Map.empty xs;
  t.eq (Map.to_list folded) (Stream.of_list xs |> Stream.tally |> Map.to_list))

test "tally counts what the stages let through" (fn t ->
  t.eq
    {a = 2}
    (Stream.of_list ["a b", "c d", "a e"]
    |> Stream.filter_map (String.word 0)
    |> Stream.filter (fn w -> w == "a")
    |> Stream.tally))

test "a constructor is a function over a file's stream (#120)" (fn t ->
  let count log = FS.stream_lines log |> Stream.filter_map Some |> Stream.count;
  t.eq 3 (Test.with_lines ./mock.log ["a", "b", "c"] (fn () -> count ./mock.log)))

-- ── smallest_by and greatest_by ─────────────────────────────────────────

-- Each element carries its position, so a tie that came back in the wrong
-- order shows.
let _pairs = List.range 0 59 |> List.map (fn i -> ((i * 7 + i / 3) % 5, i))

test "smallest_by agrees with List.smallest_by, ties included" (fn t ->
  let counts = [0, 1, 3, 10, 60, 100];
  t.eq
    (List.map (fn n -> List.smallest_by n (fn p -> p.0) _pairs) counts)
    (List.map (fn n -> Stream.of_list _pairs |> Stream.smallest_by n (fn p -> p.0)) counts))

test "greatest_by agrees with List.greatest_by, ties included" (fn t ->
  let counts = [0, 1, 3, 10, 60, 100];
  t.eq
    (List.map (fn n -> List.greatest_by n (fn p -> p.0) _pairs) counts)
    (List.map (fn n -> Stream.of_list _pairs |> Stream.greatest_by n (fn p -> p.0)) counts))

test "the source is read once, and the key runs once per element" (fn t ->
  let outcome =
    handle (Stream.of_list [3, 1, 2]
    |> Stream.map (fn x -> (IO.print "r"; x))
    |> Stream.greatest_by 2 (fn x -> (IO.print "k"; x))) with
    | IO!print s k -> (let (seen, xs) = k (); (s ++ seen, xs))
    | return xs -> ("", xs)
  in
  t.eq ("rkrkrk", [3, 2]) outcome)

test "the greatest lines of a file" (fn t ->
  with FS.temp_dir "st_" as d -> (
    let log = Path.join d ./app.log;
    FS.write_file! log "ms=40 a\nms=7 b\nms=300 c\nms=40 d\n";
    let ms line =
      String.word 0 line |> Option.default "" |> String.replace "ms=" "" |> Int.of_string!;
    t.eq ["ms=300 c", "ms=40 a", "ms=40 d"] (FS.stream_lines log |> Stream.greatest_by 3 ms)
  ))

test "asked for nothing, the source is not read" (fn t ->
  t.eq [] (FS.stream_lines ./does-not-exist.log |> Stream.smallest_by 0 String.length))
