uses {Env, FS.Read, FS.Write}

let {test} = import Test
import Env
import List
import Path
import String
import Map
import FS

-- ── get ─────────────────────────────────────────────────────────────────

let () = Env.set "WAND_TEST_VAR" "hello"
test "get existing" (fn t -> t.eq (Some "hello") (Env.get "WAND_TEST_VAR"))
test "get missing returns None" (fn t -> Env.get "WAND_TEST_NONEXISTENT_XYZ" |> t.eq None)

-- ── get! ────────────────────────────────────────────────────────────────

let () = Env.set "WAND_TEST_VAR" "world"
test "get! existing" (fn t -> t.eq "world" (Env.get! "WAND_TEST_VAR"))
test "get! missing raises" (fn t ->
  t.raises (fn () -> Env.get! "WAND_TEST_NONEXISTENT_XYZ"))

-- ── set ─────────────────────────────────────────────────────────────────

test "set then get" (fn t -> (
  Env.set "WAND_TEST_SET" "value";
  t.eq (Some "value") (Env.get "WAND_TEST_SET")
))

-- ── clear ───────────────────────────────────────────────────────────────

-- Removed, not emptied. Setting the name to "" leaves it in the
-- environment, where a child can still find it: `${NAME-fallback}` takes
-- the empty string and never reaches the fallback.
let () = Env.set "WAND_TEST_CLEAR" "before"
test "clear takes the name out" (fn t -> (
  Env.clear "WAND_TEST_CLEAR";
  t.eq None (Env.get "WAND_TEST_CLEAR")
))
test "and it is gone from all ()" (fn t -> (
  Env.set "WAND_TEST_CLEAR2" "before";
  Env.clear "WAND_TEST_CLEAR2";
  t.eq false (List.any? (fn (k, _) -> k == "WAND_TEST_CLEAR2") (Env.all ()))
))

-- ── all ─────────────────────────────────────────────────────────────────

let () = Env.set "WAND_TEST_ALL" "present"
test "all contains set var" (fn t ->
  let pairs = Env.all ();
  t.ok (List.any? (fn (k, _) -> k == "WAND_TEST_ALL") pairs))

-- ── home ────────────────────────────────────────────────────────────────

test "home returns path" (fn t -> t.ok (Path.absolute? (Env.home ())))

-- ── user ────────────────────────────────────────────────────────────────

test "user returns non-empty string" (fn t -> t.ok (String.length (Env.user ()) > 0))

-- ── Env.read / Env.load ────────────────────────────────────────────────

test "basic key=value" (fn t ->
  with FS.temp_file "wand_env_rd_" ".env" as p -> (
    FS.write_file! p "FOO=bar\nBAZ=qux\n";
    let m = Env.read! p;
    t.eq "bar" (Map.get! "FOO" m)
  ))

let dotenv_fmt =
  "# comment\nKEY1=hello\nKEY2=\"quoted\"\nKEY3='single'\nexport KEY4=exported\n\nKEY5=has=equals\n"

test "dotenv formats" (fn t ->
  with FS.temp_file "wand_env_fmt_" ".env" as p -> (
    FS.write_file! p dotenv_fmt;
    let m = Env.read! p;
    t.eq ("hello", "quoted", "single", "exported", "has=equals") (
      Map.get! "KEY1" m,
      Map.get! "KEY2" m,
      Map.get! "KEY3" m,
      Map.get! "KEY4" m,
      Map.get! "KEY5" m
    )
  ))

test "load sets env var" (fn t ->
  with FS.temp_file "wand_load_" ".env" as p -> (
    FS.write_file! p "WAND_LOAD_TEST=loaded_value\n";
    Env.load! p;
    t.eq (Some "loaded_value") (Env.get "WAND_LOAD_TEST")
  ))
