import Map
import List

let {test} = import Test

-- ── A key is held once ────────────────────────────────────────────────────

-- Two entries under one key means one of them is unreachable: `get` finds a
-- single value while `size`, `keys` and any fold see both, and a document
-- read in and written back would carry the ghost along. The last value given
-- wins, as an assignment implies, and it sits where the key first appeared --
-- because a Map is written back out in the order it holds, and a config that
-- reorders itself on every edit makes a diff nobody can read.

test "a literal holds a repeated key once, taking the last value" (fn t ->
  t.eq {a = 9, b = 2} {a = 1, b = 2, a = 9})

test "and the count agrees with what can be reached" (fn t ->
  t.eq (1, ["a"], Some 9) (
    Map.size {a = 1, a = 9},
    Map.keys {a = 1, a = 9},
    Map.get "a" {a = 1, a = 9}
  ))

test "from_list resolves them the same way" (fn t ->
  t.eq {a = 9, b = 2} (Map.from_list [("a", 1), ("b", 2), ("a", 9)]))

-- Where a key already is, is where it stays -- otherwise editing one field
-- of a config rewrites the order of the whole file.
test "set replaces in place rather than moving the key to the front" (fn t ->
  t.eq {a = 1, b = 99, c = 3} (Map.set "b" 99 {a = 1, b = 2, c = 3}))

test "and merge keeps the order the left already had" (fn t ->
  t.eq {a = 1, b = 9} (Map.merge {a = 1, b = 2} {b = 9}))

test "a key merge adds goes on the end" (fn t ->
  t.eq {a = 1, b = 2} (Map.merge {a = 1} {b = 2}))

-- ── Braces ────────────────────────────────────────────────────────────────

test "the empty braces are Map.empty" (fn t -> t.eq Map.empty {})

test "a map prints in braces" (fn t -> t.eq "{a = 1, b = 2}" "%{{a = 1, b = 2}}")

test "a brace pattern puns" (fn t ->
  let {a, b = renamed} = {a = 5, b = 6};
  t.eq 11 (a + renamed))

-- ── Order survives the index ──────────────────────────────────────────────

-- A map holds its entries in a `StrMap` keyed by name and remembers, per
-- key, when it was first added; `keys` sorts on that. The order used to be
-- the list's own, where these held by construction. They are worth stating
-- now that a counter keeps them, and two or three keys would not catch a
-- counter that drifts.

let wide = List.fold_left (fn m i -> Map.set "k%{i}" i m) Map.empty (List.range 1 50)

test "fifty keys come back in the order they went in" (fn t ->
  t.eq (List.map (fn i -> "k%{i}") (List.range 1 50)) (Map.keys wide))

test "and setting every one of them again moves none of them" (fn t ->
  t.eq
    (Map.keys wide)
    (Map.keys (List.fold_left (fn m i -> Map.set "k%{i}" 0 m) wide (List.range 1 50))))

test "a key deleted and set again goes on the end" (fn t ->
  t.eq ["b", "c", "a"] (Map.keys (Map.set "a" 9 (Map.delete "a" {a = 1, b = 2, c = 3}))))

test "deleting the last key leaves the rest where they were" (fn t ->
  t.eq ["a", "b"] (Map.keys (Map.delete "c" {a = 1, b = 2, c = 3})))

test "map and filter keep the order too" (fn t ->
  t.eq (["c", "a"], ["c"]) (
    Map.keys (Map.map (fn v -> v * 2) {c = 1, a = 2}),
    Map.keys (Map.filter (fn v -> v == 1) {c = 1, a = 2})
  ))

-- ── update ───────────────────────────────────────────────────────────────

-- `update` is `set` for a value that depends on the old one. It exists for
-- the counting idiom, which was a `match` on `get` with a branch for the
-- first count -- and that branch is where the seed goes wrong.

test "update changes what is there" (fn t ->
  t.eq {a = 2} (Map.update "a" 0 (fn n -> n + 1) {a = 1}))

test "and uses the given value when the key is new" (fn t ->
  t.eq {a = 1, b = 1} (Map.update "b" 0 (fn n -> n + 1) {a = 1}))

test "a key already there keeps its place" (fn t ->
  t.eq ["b", "a"] (Map.keys (Map.update "a" 0 (fn n -> n + 5) {b = 1, a = 2})))

test "a new key goes on the end, as set leaves it" (fn t ->
  t.eq ["b", "a", "c"] (Map.keys (Map.update "c" 7 (fn n -> n) {b = 1, a = 2})))

test "it agrees with the match on get that it replaces" (fn t ->
  let by_hand =
    fn k m -> match Map.get k m with
      | Some n -> Map.set k (n + 1) m
      | None -> Map.set k 1 m
  in
  let counted =
    List.fold_left (fn m w -> Map.update w 0 (fn n -> n + 1) m) Map.empty [
      "a",
      "b",
      "a",
      "c",
      "b",
      "a"
    ];
  let by_hand_counted =
    List.fold_left (fn m w -> by_hand w m) Map.empty ["a", "b", "a", "c", "b", "a"];
  t.eq by_hand_counted counted)

-- ── Order is how a map prints, not what it holds ─────────────────────────

-- Two maps with the same keys and an equal value under each are equal,
-- whatever order the keys arrived in. The order still decides how a map
-- prints and writes.
test "maps built in two orders are equal" (fn t -> t.eq {a = 1, b = 2} {b = 2, a = 1})
test "and not unequal" (fn t -> t.not_ok ({a = 1, b = 2} != {b = 2, a = 1}))
test "a key deleted and set again leaves an equal map" (fn t ->
  let m = {a = 1, b = 2};
  t.eq m (m |> Map.delete "a" |> Map.set "a" 1))
test "a different value is still unequal" (fn t ->
  t.not_ok ({a = 1, b = 2} == {b = 2, a = 9}))
test "a missing key is still unequal" (fn t -> t.not_ok ({a = 1} == {a = 1, b = 2}))
test "inside a list, a tuple and another map" (fn t ->
  t.ok
    ([{a = 1, b = 2}] == [{b = 2, a = 1}]
    && ({a = 1, b = 2}, 1) == ({b = 2, a = 1}, 1)
    && {x = {a = 1, b = 2}} == {x = {b = 2, a = 1}}))
test "List.unique keeps one of two equal maps" (fn t ->
  t.eq 1 (List.length (List.unique [{a = 1, b = 2}, {b = 2, a = 1}])))
test "the order still decides the keys' order" (fn t ->
  t.eq (["a", "b"], ["b", "a"]) (Map.keys {a = 1, b = 2}, Map.keys {b = 2, a = 1}))
