uses {FS.Read, FS.Write}

let {test} = import Test
import CSV
import List
import Path
import Result
import FS

-- ── parse ───────────────────────────────────────────────────────────────

test "single row" (fn t -> t.eq 1 (List.length (CSV.parse! "a,b,c")))
test "field value" (fn t ->
  t.eq "hello" (List.head! (List.head! (CSV.parse! "hello,world"))))
test "multiple rows" (fn t -> t.eq 2 (List.length (CSV.parse! "a,b\nc,d")))
test "field count per row" (fn t -> t.eq 3 (List.length (List.head! (CSV.parse! "a,b,c"))))

test "quoted field with space" (fn t ->
  t.eq "hello world" (List.head! (List.head! (CSV.parse! `"hello world",b`))))
test "embedded comma" (fn t -> t.eq "a,b" (List.head! (List.head! (CSV.parse! `"a,b",c`))))
test "escaped quote" (fn t ->
  t.eq `say "hi"` (List.head! (List.head! (CSV.parse! `"say ""hi""",b`))))

-- ── parse_with ──────────────────────────────────────────────────────────

test "tab separator field count" (fn t ->
  t.eq 3 (List.length (List.head! (CSV.parse_with! "\t" "a\tb\tc"))))
test "pipe separator second field" (fn t ->
  t.eq "y" (List.head! (List.tail! (List.head! (CSV.parse_with! "|" "x|y")))))

-- ── stringify ───────────────────────────────────────────────────────────

test "simple two-row output" (fn t ->
  t.eq "a,b\nc,d" (CSV.stringify [["a", "b"], ["c", "d"]]))
test "quotes field containing comma" (fn t -> t.eq `"a,b",c` (CSV.stringify [["a,b", "c"]]))
test "stringify_with custom separator" (fn t ->
  t.eq "x|y" (CSV.stringify_with "|" [["x", "y"]]))

-- ── read_file ───────────────────────────────────────────────────────────

test "read_file row count and header" (fn t ->
  with FS.temp_file "wand_csv_rd_" ".csv" as p -> (
    FS.write_file! p "name,age\nAlice,30\nBob,25\n";
    let outcome =
      (match CSV.read_file p with
       | Ok rows -> (List.length rows, List.head! (List.head! rows))
       | Error _ -> (-1, ""));
    t.eq (3, "name") outcome
  ))

test "read_file missing file gives Error" (fn t ->
  t.ok
    (match CSV.read_file (Path.of_string "/nonexistent/wand_missing.csv") with
    | Ok _ -> false
    | Error _ -> true
    ))

test "read_file! row count" (fn t ->
  with FS.temp_file "wand_csv_exn_" ".csv" as p -> (
    FS.write_file! p "x,y\n1,2\n";
    let rows = CSV.read_file! p;
    t.eq 2 (List.length rows)
  ))

test "read_file! raises on missing" (fn t ->
  t.raises (fn () -> CSV.read_file! (Path.of_string "/nonexistent/wand_missing.csv")))

-- A cell is text, and every value has a text form, so a row of numbers or
-- domain values needs no conversion first.
test "a row of ints" (fn t -> t.eq "1,2" (CSV.stringify [[1, 2]]))
test "a row of domain values" (fn t ->
  t.eq
    "2024-01-15T00:00:00Z,2024-02-01T00:00:00Z"
    (CSV.stringify [[2024-01-15, 2024-02-01]]))
-- A row is a list, so it holds one type. Cells of different types are
-- written as text, which is what a cell is.
test "mixed cells are written as text" (fn t ->
  t.eq "web,8080" (CSV.stringify [["web", "%{8080}"]]))

-- What is not CSV is an Error, not rows read some other way.
test "an unclosed quote is an Error" (fn t -> t.ok (Result.error? (CSV.parse `a,"b`)))
test "a separator is one character" (fn t ->
  t.eq [true, true] [
    Result.error? (CSV.parse_with "" "a"),
    Result.error? (CSV.parse_with ";;" "a")
  ])
test "a row of one empty field round-trips" (fn t ->
  t.eq (Ok [[""]]) (CSV.parse (CSV.stringify [[""]])))
