let {test} = import Test
import Float
import Int

-- Arithmetic is one spelling over both members of Num: the checker keeps
-- an expression to one numeric type, the evaluator dispatches on the
-- value's tag, and an unpinned function works at both.

test "float multiply" (fn t -> t.eq 3.0 (1.5 * 2.0))
test "float add" (fn t -> t.eq 1.75 (1.5 + 0.25))
test "float subtract" (fn t -> t.eq 1.25 (1.5 - 0.25))
test "float divide" (fn t -> t.eq 0.75 (1.5 / 2.0))
test "unary minus at Float" (fn t -> t.eq (-1.5) (0.0 - 1.5))

test "a Num function serves both types" (fn t ->
  let double x = x + x;
  t.eq (4, 3.0) (double 2, double 1.5))

test "a literal pins the type" (fn t -> (let bump x = x + 1; t.eq 3 (bump 2)))

-- Int keeps its checked behavior; Float keeps IEEE values.
test "int division by zero still raises" (fn t -> t.raises (fn () -> 1 / 0))
test "float division by zero is infinity" (fn t -> t.eq true (1.0 / 0.0 > 0.0))

-- The crossings.
test "of_int" (fn t -> t.eq 3.0 (Float.of_int 3))
test "round halves away from zero" (fn t ->
  t.eq (3, -3) (Float.round 2.5, Float.round (-2.5)))
test "floor toward negative infinity" (fn t ->
  t.eq (2, -3) (Float.floor 2.9, Float.floor (-2.1)))
test "ceil toward positive infinity" (fn t ->
  t.eq (3, -2) (Float.ceil 2.1, Float.ceil (-2.9)))
test "abs" (fn t -> t.eq 2.5 (Float.abs (-2.5)))

-- A width is a printing decision, so it answers a String: no Float is
-- exactly 0.1, and rounding to one would answer a value that cannot hold
-- the answer.
test "format to one digit" (fn t -> t.eq "0.3" (Float.format 1 0.3333))
test "format fills the digits in" (fn t -> t.eq "1.50" (Float.format 2 1.5))
test "format to none" (fn t -> t.eq "2" (Float.format 0 2.4))
test "format rounds away from zero" (fn t -> t.eq "-0.8" (Float.format 1 (-0.75)))

-- NaN, infinity and a value past an Int's range have no Int; each used to
-- come back as 0.
test "rounding NaN raises" (fn t -> t.raises (fn () -> Float.round (0.0 / 0.0)))
test "flooring infinity raises" (fn t -> t.raises (fn () -> Float.floor (1.0 / 0.0)))
test "a value past an Int's range raises" (fn t ->
  t.raises (fn () -> Float.ceil (Float.of_int Int.max_value * 4.0)))
