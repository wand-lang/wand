uses {FS.Read, FS.Write}

let {test} = import Test
import Decode
import JSON
import Result
import String
import List
import Map
import Path
import FS

-- ── parse ───────────────────────────────────────────────────────────────

test "null" (fn t ->
  t.eq
    "null"
    (match JSON.parse "null" with
    | Ok j -> JSON.stringify j
    | Error _ -> "err"
    ))

test "number" (fn t ->
  t.eq
    "42"
    (match JSON.parse "42" with
    | Ok j -> JSON.stringify j
    | Error _ -> "err"
    ))

test "string" (fn t ->
  t.eq
    `"hello"`
    (match JSON.parse `"hello"` with
    | Ok j -> JSON.stringify j
    | Error _ -> "err"
    ))

test "bad JSON returns Error" (fn t ->
  t.eq
    "error"
    (match JSON.parse "{bad}" with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "parse! valid" (fn t -> t.eq "true" (JSON.stringify (JSON.parse! "true")))
test "parse! invalid raises" (fn t -> t.raises (fn () -> JSON.parse! "not json"))

-- ── get_* extractors ───────────────────────────────────────────────────

test "get_bool true" (fn t ->
  t.eq
    true
    (match JSON.get_bool (JSON.parse! "true") with
    | Ok b -> b
    | Error _ -> false
    ))

test "get_bool wrong type" (fn t ->
  t.eq
    "error"
    (match JSON.get_bool (JSON.parse! "42") with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "get_int" (fn t ->
  t.eq
    99
    (match JSON.get_int (JSON.parse! "99") with
    | Ok n -> n
    | Error _ -> -1
    ))

test "get_int wrong type" (fn t ->
  t.eq
    "error"
    (match JSON.get_int (JSON.parse! `"hi"`) with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "get_float from float literal" (fn t ->
  t.eq
    true
    (match JSON.get_float (JSON.parse! "3.14") with
    | Ok f -> f > 3.0
    | Error _ -> false
    ))

test "get_float from int literal" (fn t ->
  t.eq
    true
    (match JSON.get_float (JSON.parse! "2") with
    | Ok f -> f == 2.0
    | Error _ -> false
    ))

test "get_string" (fn t ->
  t.eq
    "world"
    (match JSON.get_string (JSON.parse! `"world"`) with
    | Ok s -> s
    | Error _ -> ""
    ))

test "get_array length" (fn t ->
  t.eq
    3
    (match JSON.get_array (JSON.parse! "[1,2,3]") with
    | Ok xs -> List.length xs
    | Error _ -> -1
    ))

test "get_object then field" (fn t ->
  t.eq
    `"v"`
    (match JSON.get_object (JSON.parse! `{"k":"v"}`) with
    | Ok m -> JSON.stringify (Map.get! "k" m)
    | Error _ -> ""
    ))

-- ── field / field! ──────────────────────────────────────────────────────

test "field exists" (fn t ->
  let j = JSON.parse! `{"name":"Alice","age":30}`;
  t.eq
    `"Alice"`
    (match JSON.field "name" j with
    | Ok v -> JSON.stringify v
    | Error _ -> ""
    ))

test "field missing" (fn t ->
  let j = JSON.parse! `{"a":1}`;
  t.eq
    "error"
    (match JSON.field "z" j with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

test "field! exists" (fn t ->
  let j = JSON.parse! `{"x":42}`;
  t.eq "42" (JSON.stringify (JSON.field! "x" j)))

test "field! missing raises" (fn t ->
  let j = JSON.parse! `{"a":1}`;
  t.raises (fn () -> JSON.field! "z" j))

-- ── construction ────────────────────────────────────────────────────────

test "of_bool" (fn t -> t.eq "true" (JSON.stringify (JSON.of_bool true)))
test "of_int" (fn t -> t.eq "7" (JSON.stringify (JSON.of_int 7)))
test "of_float" (fn t -> t.eq "1.5" (JSON.stringify (JSON.of_float 1.5)))
test "of_string" (fn t -> t.eq `"hi"` (JSON.stringify (JSON.of_string "hi")))
test "of_list" (fn t ->
  t.eq "[1,2]" (JSON.stringify (JSON.of_list [JSON.of_int 1, JSON.of_int 2])))
test "null and is_null" (fn t -> t.eq true (JSON.null? JSON.null))

-- ── stringify_pretty ────────────────────────────────────────────────────

test "pretty round-trips" (fn t ->
  let j = JSON.parse! `{"a":1}`;
  let s = JSON.stringify_pretty j;
  t.eq
    "ok"
    (match JSON.parse s with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

-- ── read_file ───────────────────────────────────────────────────────────

test "read_file ok" (fn t ->
  with FS.temp_file "wand_json_rd_" ".json" as p -> (
    FS.write_file! p `{"greeting":"hello"}`;
    let outcome =
      (match JSON.read_file p with
       | Ok j -> JSON.stringify (JSON.field! "greeting" j)
       | Error _ -> "");
    t.eq `"hello"` outcome
  ))

test "read_file missing file returns Error" (fn t ->
  t.eq
    "error"
    (match JSON.read_file (Path.of_string "/nonexistent/wand_missing.json") with
    | Ok _ -> "ok"
    | Error _ -> "error"
    ))

-- ── Building an object ────────────────────────────────────────────────────

-- `get_object` gives back a Map, and this is its inverse. Keys need not be
-- identifiers -- a map literal takes them quoted -- which is what lets a
-- document with real-world keys be written at all.

test "an object is built from a Map, in the order it holds" (fn t ->
  t.eq
    `{"b":2,"a":"x"}`
    (JSON.stringify (JSON.of_map {b = JSON.of_int 2, a = JSON.of_string "x"})))

test "a key that is not an identifier is written quoted" (fn t ->
  t.eq
    `{"content-type":"json","@type":1}`
    (JSON.stringify
      (JSON.of_map {"content-type" = JSON.of_string "json", "@type" = JSON.of_int 1})))

-- Nothing to guard against here: a Map holds a key once, so a repeat was
-- resolved before it reached the writer.
test "a repeated key was already resolved by the Map" (fn t ->
  t.eq `{"a":9}` (JSON.stringify (JSON.of_map {a = JSON.of_int 1, a = JSON.of_int 9})))

test "an empty Map is an empty object" (fn t ->
  t.eq "{}" (JSON.stringify (JSON.of_map Map.empty)))

test "objects nest, and hold arrays" (fn t ->
  t.eq
    `{"meta":{"n":1},"xs":[1]}`
    (JSON.stringify
      (JSON.of_map {
        meta = JSON.of_map {n = JSON.of_int 1},
        xs = JSON.of_list [JSON.of_int 1]
      })))

test "and what was read can be written back" (fn t -> (
  let doc = `{"a":1,"b":"two"}`;
  match JSON.get_object (JSON.parse! doc) with
  | Ok m -> t.eq doc (JSON.stringify (JSON.of_map m))
  | Error why -> t.eq doc why
))

-- A document may name a key twice even though a Map cannot hold one twice.
-- Every reader here takes the later one -- which is what the parsers
-- everywhere else do -- so no two readers of the same document in the same
-- program can disagree about it.
test "a document that names a key twice reads the later one, whichever way it is read" (fn t ->
  let doc = JSON.parse! `{"a": 1, "a": 9}`;
  let via_field = JSON.field "a" doc |> Result.and_then JSON.get_int;
  let via_object =
    JSON.get_object doc
    |> Result.and_then (fn m ->
      match Map.get "a" m with
      | Some v -> JSON.get_int v
      | None -> Error "missing");
  t.eq (Ok 9, Ok 9, Ok 9) (
    via_field,
    via_object,
    JSON.decode (Decode.field "a" Decode.int) doc
  ))

-- `of` writes a whole structure, so nothing has to be converted a piece at
-- a time. The `of_*` builders above take one converted value each.
test "of a list of ints" (fn t -> t.eq "[1,2,3]" (JSON.stringify (JSON.of! [1, 2, 3])))
test "of a list of strings" (fn t ->
  t.eq `["a","b"]` (JSON.stringify (JSON.of! ["a", "b"])))
test "of a map" (fn t -> t.eq `{"a":1,"b":2}` (JSON.stringify (JSON.of! {a = 1, b = 2})))
test "of a nested structure" (fn t ->
  t.eq `{"tags":["a","b"]}` (JSON.stringify (JSON.of! {tags = ["a", "b"]})))
test "of a domain value" (fn t ->
  t.eq `["2024-01-15"]` (JSON.stringify (JSON.of! [2024-01-15])))
test "of an empty list" (fn t -> t.eq "[]" (JSON.stringify (JSON.of! [])))
-- What cannot be written is a value that holds code.
test "of a function is an Error" (fn t ->
  match JSON.of (fn x -> x) with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "cannot encode" why))
test "and the raising form raises" (fn t -> t.raises (fn () -> JSON.of! (fn x -> x)))
-- A JSON value passes through, so a structure may hold both.
test "of a JSON value is itself" (fn t ->
  t.eq "1" (JSON.stringify (JSON.of! (JSON.of_int 1))))

-- ── Numbers JSON cannot write ───────────────────────────────────────────
-- `1e999999` reads as infinity, and JSON has no spelling for it. Refused at
-- the door: reading it used to succeed and every later look at the value --
-- `JSON.stringify`, `"%{j}"` -- ended the program with an error `try` could
-- not catch, while `stringify_pretty` wrote `Infinity`, which is not JSON.
test "an out-of-range number is refused" (fn t ->
  match JSON.parse "1e999999" with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "infinite" why))
test "and inside a structure too" (fn t ->
  match JSON.parse `{"a": [1e999999]}` with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "infinite" why))
test "the raising form raises, and try catches it" (fn t ->
  t.raises (fn () -> JSON.parse! "1e999999"))
test "an infinite Float is not a JSON number" (fn t ->
  t.raises (fn () -> JSON.of_float (1.0 / 0.0)))
test "and JSON.of refuses one" (fn t ->
  match JSON.of (1.0 / 0.0) with
  | Ok _ -> t.fail "expected a refusal"
  | Error why -> t.ok (String.contains? "infinite" why))
test "a number in range still reads" (fn t ->
  t.eq "1e+300" (JSON.stringify (JSON.parse! "1e300")))

-- An integer past an Int's range is kept as its digits, so one such field
-- does not make the whole document an Error.
let big = `{"id": 12345678901234567890, "n": 1}`

test "a document with an integer past an Int's range parses" (fn t ->
  t.ok (Result.ok? (JSON.parse big)))
test "and writes the integer back exactly" (fn t ->
  t.eq `{"id":12345678901234567890,"n":1}` (JSON.stringify (JSON.parse! big)))
test "the other fields read as before" (fn t ->
  t.eq (Ok 1) (JSON.decode (Decode.field "n" Decode.int) (JSON.parse! big)))
test "the integer reads exactly as text" (fn t ->
  t.eq
    (Ok "12345678901234567890")
    (JSON.decode (Decode.field "id" Decode.string) (JSON.parse! big)))
test "and is no Int" (fn t ->
  t.ok (Result.error? (JSON.get_int (JSON.field! "id" (JSON.parse! big)))))
