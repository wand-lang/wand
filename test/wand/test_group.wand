import List
import String

let {test, group, Suite, Pass} = import Test

-- A real group: these children run and report through `wand s`,
-- which is the integration the OCaml runner tests pin down.
group "shared bindings" (fn () ->
  let n = 40 + 2;
  let s = String.upper "hi";
  [
    test "an Int child" (fn t -> t.eq 42 n),
    test "a String child sharing the same body" (fn t -> t.eq "HI" s)
  ])

group "nesting" (fn () -> [
  test "a leaf" (fn t -> t.ok true),
  group "inner" (fn () -> [test "a deeper leaf" (fn t -> t.ok true)])
])

-- A group's value is data, so a test can take one apart.
test "a group is a Suite of its children" (fn t ->
  match group "g" (fn () -> [test "a" (fn tt -> tt.ok true)]) with
  | Suite l [Pass a] -> t.eq ("g", "a") (l, a)
  | _ -> t.fail `expected Suite "g" [Pass "a"]`)

test "a raising child fails alone, and its sibling still runs" (fn t ->
  match group "g" (fn () -> [
    test "boom" (fn tt -> tt.eq (1 / 0) 0),
    test "fine" (fn tt -> tt.ok true)
  ]) with
  | Suite _ [Fail m, Pass _] ->
    t.ok (String.contains? "boom: raised:" m && String.contains? "division by zero" m)
  | _ -> t.fail "expected one Fail then one Pass")

test "a raising body is the group's one failure" (fn t ->
  match group "g" (fn () -> (1 / 0; [])) with
  | Suite _ [Fail m] -> t.ok (String.contains? "setup raised:" m)
  | _ -> t.fail "expected the single setup failure")

test "an empty group is a Suite with no children" (fn t ->
  match group "g" (fn () -> []) with
  | Suite _ [] -> t.ok true
  | _ -> t.fail "expected no children")
