uses {Clock, FS.Read, FS.Write, Shell(git, sh)}

let {test, group} = import Test
import Clock
import FS
import Par
import Path
import Resource
import String
import Test

-- A race runs every thunk at once and answers with the first to finish.
--
-- These use short commands, because the wait is real: a loser inside a
-- subprocess cannot answer wand until the subprocess does.

group "the first to finish wins" (fn () -> [
  test "over commands" (fn t ->
    t.eq
      (Ok "quick")
      (Par.race [
        fn () -> $(sh -c 'sleep 2; echo slow'),
        fn () -> $(sh -c 'sleep 0.1; echo quick')
      ])),
  test "over wand work" (fn t ->
    let spin n = if n == 0 then "slow" else spin (n - 1);
    t.eq (Ok "fast") (Par.race [fn () -> spin 200000000, fn () -> "fast"]))
])

-- First to finish, not first to succeed.
group "what comes back" (fn () -> [
  test "a winner that raises is an Error" (fn t ->
    match Par.race [fn () -> $(sh -c 'exit 4')] with
    | Ok out -> t.fail "expected an Error, got %{out}"
    | Error why -> t.ok (String.contains? "code 4" why)),
  test "a loser that raises is discarded" (fn t ->
    t.eq
      (Ok "won")
      (Par.race [fn () -> $(sh -c 'sleep 1; exit 9'), fn () -> $(sh -c 'echo won')])),
  test "nothing to race is an Error" (fn t ->
    match Par.race [] with
    | Ok _ -> t.fail "expected an Error"
    | Error why -> t.ok (String.contains? "nothing" why))
])

-- A loser stops where it stands, and gives back what it holds.
test "a cancelled loser releases" (fn t ->
  with FS.temp_dir "race_" as d -> (
    let held = Path.join d (Path.of_string "held");
    let spin n = if n == 0 then 0 else spin (n - 1);
    let holder =
      Resource.make (fn () -> FS.write_file! held "yes") (fn _ -> FS.delete! held);
    let loser = fn () -> with holder as _ -> spin 400000000;
    let _ = Par.race [loser, fn () -> 1];
    t.eq false (FS.exists? held)
  ))

-- Every branch performs its effects where the race was written, so a
-- handler around the race answers each of them, and the race still runs.
test "a race inside a handler runs every branch" (fn t ->
  t.eq
    (Ok "mocked")
    (Test.with_shell [("git", "mocked")] (fn () ->
      Par.race [fn () -> (Clock.sleep 5s; "slept"), fn () -> $(git describe)])))

-- A handler inside a thunk stands for that branch alone.
test "a handler inside each thunk stands" (fn t ->
  t.eq
    (Ok "mocked")
    (Par.race [
      fn () -> Test.with_shell [("git", "mocked")] (fn () -> $(git describe)),
      fn () -> (Clock.sleep 5s; "slept")
    ]))

-- ── A deadline on wand code ─────────────────────────────────────────────

-- `Par.timeout` is a race between the work and a sleeper. The durations
-- here are short, because the wait is real: a deadline under a mocked
-- clock is refused, for the reason the last tests in this group state.

group "Par.timeout" (fn () -> [
  test "work that finishes in time" (fn t ->
    t.eq (Ok "done") (Par.timeout 5s (fn () -> (Clock.sleep 50ms; "done")))),
  test "work that does not" (fn t ->
    match Par.timeout 200ms (fn () -> (Clock.sleep 10s; "done")) with
    | Ok v -> t.fail "expected a deadline, got %{v}"
    | Error why -> t.ok (String.contains? "200ms" why)),
  test "a thunk that raises comes back as Error" (fn t ->
    match Par.timeout 5s (fn () -> $(sh -c 'exit 5')) with
    | Ok v -> t.fail "expected an Error, got %{v}"
    | Error why -> t.ok (String.contains? "code 5" why)),
  -- Under a handler for `Clock.sleep` the sleeper takes no time, so the
  -- deadline would pass before any real work finished. Refused instead.
  test "a deadline under a mocked clock is refused" (fn t ->
    t.raises (fn () -> Test.with_clock (fn () -> Par.timeout 5s (fn () -> Clock.sleep 1s)))),
  test "and under any other handler it stands" (fn t ->
    t.eq (Ok 1) (Test.with_shell [] (fn () -> Par.timeout 5s (fn () -> 1))))
])

-- Work that is stopped gives back what it holds, as a losing racer does.
test "work stopped by a deadline releases" (fn t ->
  with FS.temp_dir "timeout_" as d -> (
    let held = Path.join d (Path.of_string "held");
    let spin n = if n == 0 then 0 else spin (n - 1);
    let holder = Resource.make (fn () -> FS.write_file! held "y") (fn _ -> FS.delete! held);
    let _ = Par.timeout 200ms (fn () -> with holder as _ -> spin 900000000);
    t.eq false (FS.exists? held)
  ))
