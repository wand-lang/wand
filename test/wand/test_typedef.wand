import JSON
import Result
import Test

let {test} = import Test

-- ── Enum-style variants (no payload) ───────────────────────────────────

type Color = Red | Green | Blue

test "nullary constructor" (fn t -> t.eq "Red" "%{Red}")
test "constructor equality" (fn t -> t.eq true (Red == Red))
test "constructor inequality" (fn t -> t.eq false (Red == Green))

-- ── Variants with payloads ──────────────────────────────────────────────

type Wrap = Wrap Int
type Pair = Pair Int Int

test "single payload" (fn t -> t.eq "Wrap(42)" "%{Wrap 42}")
test "two payloads" (fn t -> t.eq "Pair(3, 4)" "%{Pair 3 4}")

-- ── Pattern matching on variants ───────────────────────────────────────

let describe_color c =
  match c with
  | Red -> "red"
  | Green -> "green"
  | Blue -> "blue"
test "match nullary" (fn t -> t.eq "green" (describe_color Green))

type Rect = Rect Int Int
let area r =
  match r with
  | Rect w h -> w * h
test "match payload" (fn t -> t.eq 12 (area (Rect 3 4)))

-- ── Single-constructor shorthand (named fields) ────────────────────────

type Point(x: Int, y: Int)
type Circle(radius: Int)

test "construct and access" (fn t -> (let p = Point(x = 1, y = 2); t.eq 1 p.x))

test "second field" (fn t -> (let origin = Point(x = 0, y = 0); t.eq 0 origin.y))

test "field on function result" (fn t ->
  let unit_circle = Circle(radius = 1);
  t.eq 1 unit_circle.radius)

-- ── Named constructor patterns ─────────────────────────────────────────

test "destructure named fields" (fn t ->
  let p = Point(x = 3, y = 4);
  let sum =
    match p with
    | Point(x = a, y = b) -> a + b
  in
  t.eq 7 sum)

test "wildcard field" (fn t ->
  let p = Point(x = 5, y = 99);
  let get_x =
    match p with
    | Point(x = v, y = _) -> v
  in
  t.eq 5 get_x)

let add_coords p =
  let Point(x = a, y = b) = p;
  a + b
test "in local let binding" (fn t -> t.eq 15 (add_coords Point(x = 7, y = 8)))

-- ── Named-field types are destructured by name ──────────────────────────

test "single field by name" (fn t ->
  let c = Circle(radius = 7);
  let Circle(radius = r) = c;
  t.eq 7 r)

test "multi field by name" (fn t ->
  let p = Point(x = 3, y = 4);
  let Point(x = a, y = b) = p;
  t.eq "3, 4" "%{a}, %{b}")

test "match case by name" (fn t ->
  let c = Circle(radius = 9);
  t.eq
    9
    (match c with
    | Circle(radius = r) -> r
    ))

let circle_area c =
  let Circle(radius = r) = c;
  r * r
test "in local let inside fn" (fn t -> t.eq 25 (circle_area Circle(radius = 5)))

-- ── Errors ──────────────────────────────────────────────────────────────

-- ── A type on a parameter ───────────────────────────────────────────────

-- Dot access needs a named type, and a definition is generalized before any
-- call is seen. So the type comes from the definition.

let radius_of (c: Circle) = c.radius
test "a parameter carries its type" (fn t -> t.eq 7 (radius_of Circle(radius = 7)))

let scaled (c: Circle) (by: Int) = c.radius * by
test "two annotated parameters" (fn t -> t.eq 21 (scaled Circle(radius = 7) 3))

test "a lambda takes one too" (fn t ->
  t.eq 12 ((fn (p: Point) -> p.x * p.y) Point(x = 3, y = 4)))

test "and an arm of a match" (fn t ->
  t.eq
    5
    (match Circle(radius = 5) with
    | (c: Circle) -> c.radius
    ))

let named (c: Circle) : Int = c.radius
test "with a return annotation as well" (fn t -> t.eq 2 (named Circle(radius = 2)))

-- ── Record update ──────────────────────────────────────────────────────

type Tally(ok: Int, failed: Int, label: String)

let base = Tally(ok = 1, failed = 2, label = "x")

test "one field changes and the rest stay" (fn t ->
  t.eq Tally(ok = 1, failed = 9, label = "x") Tally(base, failed = 9))
test "several fields at once" (fn t ->
  t.eq Tally(ok = 8, failed = 9, label = "x") Tally(base, ok = 8, failed = 9))
test "naming every field is a construction" (fn t ->
  t.eq Tally(ok = 8, failed = 9, label = "y") Tally(base, ok = 8, failed = 9, label = "y"))
test "the base is left alone" (fn t ->
  let _ = Tally(base, failed = 9);
  t.eq 2 base.failed)
test "the base is any expression" (fn t ->
  t.eq 9 Tally(Tally(base, ok = 3), failed = 9).failed)

-- ── A type on a payload pattern ────────────────────────────────────────

-- Where a decoder's result lands, so it is where the type is most often
-- already known and most often still worth writing.
type Boxed(n: Int)

test "a payload carries its type" (fn t ->
  let read =
    fn r -> match r with
      | Ok (b: Boxed) -> b.n
      | Error _ -> 0
  in
  t.eq 7 (read (Ok Boxed(n = 7))))

test "and so does one inside a tuple payload" (fn t ->
  let read =
    fn r -> match r with
      | Ok((b: Boxed), extra) -> b.n + extra
      | Error _ -> 0
  in
  t.eq 9 (read (Ok (Boxed(n = 7), 2))))

-- ── Field puns ─────────────────────────────────────────────────────────

-- A bare name inside a constructor's parentheses reads as its own field,
-- the way `{a, b}` already puns for a map. Which reading it carries is the
-- declaration's to decide: `Pod` names its fields, so these are fields.
type Pod(name: String, restarts: Int)

let pod = Pod(name = "api", restarts = 3)

test "a pun binds each field to its own name" (fn t ->
  t.eq
    "api/3"
    (match pod with
    | Pod(name, restarts) -> "%{name}/%{restarts}"
    ))

test "a pun beside a field that is ignored" (fn t ->
  t.eq
    "api"
    (match pod with
    | Pod(name, restarts = _) -> name
    ))

test "a pun sits beside a named field" (fn t ->
  t.eq
    "api/9"
    (match pod with
    | Pod(name, restarts = r) -> "%{name}/%{r + 6}"
    ))

test "a pun sits after a named field" (fn t ->
  t.eq
    "db/3"
    (match pod with
    | Pod(name = _, restarts) -> "db/%{restarts}"
    ))

test "the order of the fields is the pattern's own" (fn t ->
  t.eq
    "3/api"
    (match pod with
    | Pod(restarts, name) -> "%{restarts}/%{name}"
    ))

test "a pun works as a parameter" (fn t ->
  let describe = fn (Pod(name, restarts)) -> "%{name} %{restarts}";
  t.eq "api 3" (describe pod))

test "a pun nests under another constructor" (fn t ->
  t.eq
    "api"
    (match Ok pod with
    | Ok (Pod(name, restarts = _)) -> name
    | Error _ -> ""
    ))

-- The same spelling on a constructor that does not name its fields is the
-- tuple payload it has always been.
type Span = Span (Int, Int)

test "bare names still read a tuple payload" (fn t ->
  t.eq
    3
    (match Span (1, 2) with
    | Span(a, b) -> a + b
    ))

-- A construction puns the same way, from names the value already has.

let name = "web"

let restarts = 5

test "a construction puns from names in scope" (fn t ->
  let p = Pod(name, restarts);
  t.eq "web/5" "%{p.name}/%{p.restarts}")

-- A pun beside a named field parses, and `wand f` writes it out again: the
-- pun form is all-or-nothing on this side, because a bare name in front of a
-- named field is the update below. The spellings themselves are held in
-- test/test_parser.ml, where the formatter does not reach.

-- A bare name before a named field is the base of an update, which is what
-- that spelling has always meant.
let pod_base = Pod(name = "db", restarts = 1)

test "a name before a named field is still the base of an update" (fn t ->
  let p = Pod(pod_base, restarts = 7);
  t.eq "db/7" "%{p.name}/%{p.restarts}")

let one = 1

let two = 2

test "a construction of a tuple payload is unchanged" (fn t ->
  let s = Span(one, two);
  t.eq
    3
    (match s with
    | Span(a, b) -> a + b
    ))

-- ── Field defaults ─────────────────────────────────────────────────────

-- `= value` after a field's type is what lets a construction leave it out.
-- The value is written out, so it reads the same at every site that omits
-- the field.
type Conf(host: String, port: Port = :8080, retries: Int = 3)

test "a field with a default may be left out" (fn t ->
  let c = Conf(host = "a");
  t.eq "a:8080/3" "%{c.host}%{c.port}/%{c.retries}")

test "and may still be given" (fn t ->
  let c = Conf(host = "a", port = :90);
  t.eq "a:90/3" "%{c.host}%{c.port}/%{c.retries}")

type Defaulted(n: Int = 3, label: String = "on")

test "every field defaulted needs no fields at all" (fn t ->
  let c = Defaulted();
  t.eq "3/on" "%{c.n}/%{c.label}")

test "a default reaches a derived decoder" (fn t ->
  let doc = JSON.parse! `{"host": "a", "port": 90}`;
  t.eq (Ok Conf(host = "a", port = :90, retries = 3)) (JSON.decode Conf.decoder doc))

test "a document that gives the field wins over the default" (fn t ->
  let doc = JSON.parse! `{"host": "a", "retries": 9}`;
  t.eq (Ok Conf(host = "a", port = :8080, retries = 9)) (JSON.decode Conf.decoder doc))

test "a field with no default is still required of a document" (fn t ->
  let doc = JSON.parse! `{"port": 90}`;
  t.eq true (Result.error? (JSON.decode Conf.decoder doc)))

-- ── Reaching a type through its module ──────────────────────────────────

-- A module's types and constructors can be named through the module, the
-- way its values already are. The bare name still works, and names the same
-- type.
type Held(o: Test.TestOutcome)

test "a qualified type names the same type as the bare one" (fn t ->
  let held = Held(o = Test.Pass "x");
  t.eq `Pass("x")` "%{held.o}")

test "a qualified constructor matches" (fn t ->
  t.eq
    "x"
    (match Test.Pass "x" with
    | Test.Pass s -> s
    | Test.Fail s -> s
    | Test.Suite s _ -> s
    ))

-- Named in the import, a constructor is used bare.
let {Pass = Pass, Fail = Fail, Suite = Suite} = import Test

test "a constructor named in the import is used bare" (fn t ->
  t.eq
    "x"
    (match Test.Pass "x" with
    | Pass s -> s
    | Fail s -> s
    | Suite s _ -> s
    ))

-- A field name is not a name a scope can see, so a word the language has
-- taken reads as itself there. Half the JSON a script decodes spells a
-- field `type`, and wand calling it a keyword does not change the document.
type Condition(type: String, status: String, when: String = "now")

test "a keyword names a field" (fn t ->
  let c = Condition(type = "Ready", status = "True");
  t.eq "Ready" c.type)

test "a default fills one in" (fn t ->
  let c = Condition(type = "Ready", status = "True");
  t.eq "now" c.when)

test "an update names one" (fn t ->
  let c = Condition(type = "Ready", status = "True");
  t.eq "Available" Condition(c, type = "Available").type)

test "a pattern matches on one" (fn t ->
  let c = Condition(type = "Ready", status = "True");
  t.eq
    "Ready holds"
    (match c with
    | Condition(type = k, status = "True") -> "%{k} holds"
    | Condition(type = k) -> "%{k} does not"
    ))

test "it is written out as itself" (fn t ->
  let c = Condition(type = "Ready", status = "False");
  t.eq
    (Ok `{"type":"Ready","status":"False","when":"now"}`)
    (Result.map JSON.stringify (JSON.of c)))

test "and read back from itself" (fn t ->
  let doc = JSON.parse! `{"type":"Ready","status":"False","when":"then"}`;
  t.eq
    (Ok Condition(type = "Ready", status = "False", when = "then"))
    (JSON.decode Condition.decoder doc))

-- ── A type used above its declaration ───────────────────────────────────

-- The typechecker reads every declaration first, so a run does too: these
-- tests run before the `type` line below them.
test "a constructor above its type" (fn t -> t.eq 2 Later(n = 2).n)
test "a derived member above its type" (fn t ->
  t.eq (Ok Later(n = 3)) (JSON.decode Later.decoder (JSON.parse! `{"n":3}`)))
test "an alias above its type" (fn t -> t.eq Later(n = 4) Soon(n = 4))

type Soon = Later
type Later(n: Int)
