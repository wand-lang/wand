let {test} = import Test
import List
import String

-- ── length / empty? ─────────────────────────────────────────────────

test "length empty" (fn t -> t.eq 0 (String.length ""))
test "length hello" (fn t -> t.eq 5 (String.length "hello"))
test "empty? true" (fn t -> t.ok (String.empty? ""))
test "empty? false" (fn t -> t.eq false (String.empty? "x"))

-- ── upper / lower ───────────────────────────────────────────────────────

test "upper" (fn t -> t.eq "HELLO" (String.upper "hello"))
test "lower" (fn t -> t.eq "world" (String.lower "WORLD"))
test "case round trip" (fn t -> t.eq "hello" (String.lower (String.upper "Hello")))

-- ── trim ────────────────────────────────────────────────────────────────

test "trim spaces" (fn t -> t.eq "hello" (String.trim "  hello  "))
test "trim newlines" (fn t -> t.eq "hi" (String.trim "\n  hi\n"))
test "trim clean" (fn t -> t.eq "clean" (String.trim "clean"))
test "trim_left" (fn t -> t.eq "hi  " (String.trim_left "  hi  "))
test "trim_right" (fn t -> t.eq "  hi" (String.trim_right "  hi  "))

-- ── slice ───────────────────────────────────────────────────────────────

test "slice full" (fn t -> t.eq "hello" (String.slice 0 5 "hello"))
test "slice prefix" (fn t -> t.eq "hel" (String.slice 0 3 "hello"))
test "slice suffix" (fn t -> t.eq "llo" (String.slice 2 5 "hello"))
test "slice empty" (fn t -> t.eq "" (String.slice 2 2 "hello"))
test "slice clamp" (fn t -> t.eq "hi" (String.slice 0 100 "hi"))

-- ── split ───────────────────────────────────────────────────────────────

test "split csv" (fn t -> t.eq ["a", "b", "c"] (String.split "," "a,b,c"))
test "split no match" (fn t -> t.eq ["abc"] (String.split "," "abc"))
test "split words" (fn t -> t.eq ["hello", "world"] (String.split " " "hello world"))

-- ── contains? / starts_with? / ends_with? ──────────────────────────────

test "contains? yes" (fn t -> t.ok (String.contains? "ll" "hello"))
test "contains? no" (fn t -> t.eq false (String.contains? "xy" "hello"))
test "starts_with? yes" (fn t -> t.ok (String.starts_with? "he" "hello"))
test "starts_with? no" (fn t -> t.eq false (String.starts_with? "lo" "hello"))
test "ends_with? yes" (fn t -> t.ok (String.ends_with? "lo" "hello"))
test "ends_with? no" (fn t -> t.eq false (String.ends_with? "he" "hello"))

-- ── replace ─────────────────────────────────────────────────────────────

test "replace basic" (fn t -> t.eq "hell0 w0rld" (String.replace "o" "0" "hello world"))
test "replace no match" (fn t -> t.eq "hello" (String.replace "x" "y" "hello"))
test "replace prefix" (fn t -> t.eq "HEllo" (String.replace "he" "HE" "hello"))

-- ── repeat / reverse ────────────────────────────────────────────────────

test "repeat 3" (fn t -> t.eq "ababab" (String.repeat 3 "ab"))
test "repeat 0" (fn t -> t.eq "" (String.repeat 0 "ab"))
test "repeat 1" (fn t -> t.eq "x" (String.repeat 1 "x"))
test "reverse" (fn t -> t.eq "olleh" (String.reverse "hello"))
test "reverse empty" (fn t -> t.eq "" (String.reverse ""))

-- ── truncate ────────────────────────────────────────────────────────────

test "truncate cuts to the budget" (fn t -> t.eq "hel" (String.truncate 3 "hello"))
test "truncate leaves a short string alone" (fn t -> t.eq "hi" (String.truncate 9 "hi"))
test "truncate at exactly the length" (fn t -> t.eq "hello" (String.truncate 5 "hello"))
test "truncate to zero" (fn t -> t.eq "" (String.truncate 0 "hello"))
test "truncate to a negative budget" (fn t -> t.eq "" (String.truncate (-1) "hello"))
test "truncate an empty string" (fn t -> t.eq "" (String.truncate 3 ""))

-- The whole point: a cut inside a character drops the character rather
-- than half of it. "café" is five bytes, and the é is the last two.
test "truncate does not split a character" (fn t -> t.eq "caf" (String.truncate 4 "café"))
test "truncate keeps a character that fits" (fn t ->
  t.eq "café" (String.truncate 5 "café"))
test "truncate is byte-exact where slice is not" (fn t ->
  t.eq (4, 3) (
    String.length (String.slice 0 4 "café"),
    String.length (String.truncate 4 "café")
  ))

-- A three-byte character exercises the walk back by more than one.
test "truncate backs off a three-byte character" (fn t ->
  t.eq "ab" (String.truncate 3 "ab€"))
test "truncate keeps a three-byte character that fits" (fn t ->
  t.eq "ab€" (String.truncate 5 "ab€"))

-- Bytes that are not UTF-8 are cut at the budget, because there is no
-- character to keep whole. `String.slice 4 5 "café"` is the second byte of
-- the é on its own, which is a continuation byte with no lead in front of
-- it, and four of those are not a character in any encoding.
test "truncate cuts bytes that are not UTF-8 at the budget" (fn t ->
  let stray = String.repeat 4 (String.slice 4 5 "café");
  t.eq 3 (String.length (String.truncate 3 stray)))

-- The budget is never exceeded, whatever the input.
test "truncate never returns more than the budget" (fn t ->
  t.eq
    true
    (List.all? (fn n -> String.length (String.truncate n "a€bcé") <= n) (List.range 0 9)))

-- ── bytes ───────────────────────────────────────────────────────────────

test "bytes" (fn t -> t.eq ["a", "b", "c"] (String.bytes "abc"))
test "bytes empty" (fn t -> t.eq [] (String.bytes ""))

-- The name is the whole point of the rename: a multi-byte character comes
-- back as its bytes, not as itself.
test "bytes splits a multi-byte character" (fn t ->
  t.eq 2 (List.length (String.bytes "é")))
test "bytes counts what length counts" (fn t ->
  t.eq (String.length "café") (List.length (String.bytes "café")))

-- ── of_int / to_int / to_float ─────────────────────────────────────────

test "of_int" (fn t -> t.eq "42" (String.of_int 42))
test "to_int ok" (fn t -> t.eq (Ok 123) (String.to_int "123"))
test "of_int negative" (fn t -> t.eq "-7" (String.of_int (-7)))
test "to_float ok" (fn t -> t.eq (Ok 3.14) (String.to_float "3.14"))
test "to_float int-like" (fn t -> t.eq (Ok 42.0) (String.to_float "42"))
test "to_int err" (fn t ->
  match String.to_int "abc" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
test "to_float err" (fn t ->
  match String.to_float "abc" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)

-- ── join ────────────────────────────────────────────────────────────────

test "join csv" (fn t -> t.eq "a, b, c" (String.join ", " ["a", "b", "c"]))
test "join empty" (fn t -> t.eq "" (String.join ", " []))
test "join single" (fn t -> t.eq "only" (String.join ", " ["only"]))

-- An element that is empty is still an element: a CSV row whose first field
-- is blank has to come back with the separator in front of the second.
test "join keeps an empty first field" (fn t -> t.eq ",b" (String.join "," ["", "b"]))
test "join keeps an empty middle field" (fn t ->
  t.eq "a,,b" (String.join "," ["a", "", "b"]))
test "join of two empties is one separator" (fn t -> t.eq "," (String.join "," ["", ""]))

-- ── lines / words ───────────────────────────────────────────────────────

test "lines" (fn t -> t.eq ["a", "b", "c"] (String.lines "a\nb\nc"))

-- A newline ends a line rather than separating two. Nearly every file ends
-- in one, so splitting on "\n" answered with an extra "" at the end and
-- every caller had to drop it.
test "a trailing newline adds no line" (fn t -> t.eq ["a", "b"] (String.lines "a\nb\n"))
test "text with nothing in it has no lines" (fn t -> t.eq [] (String.lines ""))
-- Only the piece after the last newline goes, so a blank line written on
-- purpose is still a line.
test "an empty line inside is kept" (fn t -> t.eq ["a", "", "c"] (String.lines "a\n\nc\n"))
test "an empty line at the end is kept" (fn t -> t.eq ["a", ""] (String.lines "a\n\n"))
test "one newline is one empty line" (fn t -> t.eq [""] (String.lines "\n"))
test "a line without a newline is a line" (fn t -> t.eq ["a"] (String.lines "a"))
test "words" (fn t -> t.eq ["one", "two", "three"] (String.words "one two three"))

-- Whatever the spacing looks like, the words are the words: a run of spaces
-- separates two of them, not four empty ones, and the ends contribute none.
test "words ignores repeated and edge spacing" (fn t ->
  t.eq ["a", "b"] (String.words "  a  b  "))
test "words separates on tabs and newlines" (fn t ->
  t.eq ["a", "b", "c"] (String.words "a\tb\nc"))
test "words of blank text is empty" (fn t -> t.eq [] (String.words "   "))

-- ── pipeline ────────────────────────────────────────────────────────────

test "pipe" (fn t ->
  let s = "  Hello, World!  ";
  t.eq "hello, world!" (s |> String.trim |> String.lower))

-- ── to_bool / to_path ──────────────────────────────────────────────────

test "to_bool true" (fn t -> t.eq (Ok true) (String.to_bool "true"))
test "to_bool false" (fn t -> t.eq (Ok false) (String.to_bool "False"))
test "to_bool err" (fn t ->
  match String.to_bool "yes" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
test "to_path" (fn t -> t.eq /tmp/foo (String.to_path "/tmp/foo"))

-- ── domain type parsers ─────────────────────────────────────────────────

test "to_url ok" (fn t ->
  match String.to_url "https://example.com" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_url err" (fn t ->
  match String.to_url "not-a-url" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
test "to_ipv4 ok" (fn t ->
  match String.to_ipv4 "192.168.1.1" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_ipv4 err" (fn t ->
  match String.to_ipv4 "999.0.0.1" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
test "to_cidr ok" (fn t ->
  match String.to_cidr "10.0.0.0/8" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_port ok" (fn t ->
  match String.to_port ":8080" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
-- Both spellings read: `:8080` is wand's own notation, and the bare number
-- is what an environment variable or a config file holds.
test "to_port takes the bare number too" (fn t ->
  t.eq (String.to_port ":8080") (String.to_port "8080"))

test "to_port err" (fn t ->
  match String.to_port "http" with
  | Ok _ -> t.ok false
  | Error msg -> t.eq `cannot parse "http" as Port` msg)

test "to_port out of range says which rule was broken" (fn t ->
  match String.to_port ":99999" with
  | Ok _ -> t.ok false
  | Error msg -> t.eq "invalid port :99999: must be 0-65535" msg)

test "and an octet out of range does too" (fn t ->
  match String.to_ipv4 "256.0.0.1" with
  | Ok _ -> t.ok false
  | Error msg -> t.eq "invalid IPv4 address: each octet must be 0–255" msg)
test "to_version ok" (fn t ->
  match String.to_version "1.2.3" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_size ok" (fn t ->
  match String.to_size "10MB" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_size err" (fn t ->
  match String.to_size "abc" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
-- One instant type, so one parser, reading either spelling.
test "to_datetime reads a bare day as midnight" (fn t ->
  t.eq (Ok 2024-01-15T00:00:00Z) (String.to_datetime "2024-01-15"))
test "to_datetime err" (fn t ->
  match String.to_datetime "01/15/2024" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)
test "to_datetime ok" (fn t ->
  match String.to_datetime "2024-01-15T14:30:00Z" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_duration ok" (fn t ->
  match String.to_duration "5min" with
  | Ok _ -> t.ok true
  | Error _ -> t.ok false)
test "to_duration err" (fn t ->
  match String.to_duration "abc" with
  | Ok _ -> t.ok false
  | Error _ -> t.ok true)

-- ── word ─────────────────────────────────────────────────────────────────

-- `word` reads one of what `words` would return, without building the rest.
-- The two must not drift, so these check the answer against `words` rather
-- than against a literal, and cover the places the two rules could part:
-- runs of whitespace, a tab, and leading and trailing space.

test "word agrees with words at every index" (fn t ->
  let s = "  a\tbb   ccc  ";
  let ws = String.words s;
  t.eq
    (List.map (fn i -> List.get i ws) [0, 1, 2, 3])
    (List.map (fn i -> String.word i s) [0, 1, 2, 3]))

test "word is None past the end" (fn t -> t.eq None (String.word 9 "a b"))

test "word! raises past the end" (fn t -> t.raises (fn () -> String.word! 9 "a b"))

test "and says how many there were" (fn t ->
  t.eq (Error "no word 9: the string has 2") (try String.word! 9 "a b"))

test "no words at all" (fn t -> t.eq (None, []) (String.word 0 "   ", String.words "   "))

-- ── the raising siblings of the to_* family ─────────────────────────────

-- Every fallible function comes as a pair, and this family had twelve
-- exceptions to that in one module. Each `!` answers with the value where
-- the plain name answers with Ok, and raises the same reason where it
-- answers with Error.

test "to_int!" (fn t -> t.eq 42 (String.to_int! "42"))
test "to_float!" (fn t -> t.eq 1.5 (String.to_float! "1.5"))
test "to_bool!" (fn t -> t.ok (String.to_bool! "TRUE"))
test "to_glob!" (fn t -> t.eq (Ok *.wand) (try String.to_glob! "*.wand"))
test "to_url!" (fn t -> t.eq https://example.com (String.to_url! "https://example.com"))
test "to_ipv4!" (fn t -> t.eq 192.168.1.1 (String.to_ipv4! "192.168.1.1"))
test "to_cidr!" (fn t -> t.eq 10.0.0.0/8 (String.to_cidr! "10.0.0.0/8"))
test "to_port!" (fn t -> t.eq :8080 (String.to_port! ":8080"))
test "to_version!" (fn t -> t.eq 1.2.3 (String.to_version! "1.2.3"))
test "to_size!" (fn t -> t.eq 10MB (String.to_size! "10MB"))
test "to_datetime!" (fn t -> t.eq 2026-08-22 (String.to_datetime! "2026-08-22"))
test "to_duration!" (fn t -> t.eq 1h30m (String.to_duration! "1h30m"))

test "a bad parse raises" (fn t -> t.raises (fn () -> String.to_int! "abc"))

-- The reason is the one the plain name would have answered with, passed
-- through rather than rewritten.
test "and raises the reason the pair reports" (fn t ->
  t.eq (String.to_int "abc") (try String.to_int! "abc"))
