uses {FS.Read, FS.Write}

let {test, group} = import Test
import FS
import Path

-- A `let` in a block binds for the rest of the block. `;` ends its
-- right-hand side, as a newline does at the top level of a file.

group "what a binding reaches" (fn () -> [
  test "the statements after it" (fn t ->
    t.eq 3 (let f = fn () -> (let x = 1; let y = 2; x + y); f ())),
  test "a binding sees the one before" (fn t ->
    t.eq 6 (let f = fn () -> (let x = 1; let y = x + 1; y * 3); f ())),
  test "a binding after a statement" (fn t ->
    t.eq "ab" (let f = fn () -> (let a = "a"; let b = "b"; a ++ b); f ()))
])

-- Every binding form works, because they all reach the same place in the
-- parser.
group "the forms" (fn () -> [
  test "annotated" (fn t -> t.eq 2 (let f = fn () -> (let x : Int = 1; x + 1); f ())),
  test "a function" (fn t -> t.eq 5 (let f = fn () -> (let g y = y + 1; g 4); f ())),
  test "a tuple pattern" (fn t ->
    t.eq 3 (let f = fn () -> (let (a, b) = (1, 2); a + b); f ()))
])

-- The older spelling keeps its own meaning.
test "let ... in scopes over one expression" (fn t ->
  t.eq 9 (let f = fn () -> (let x = 1 in x + 1; 9); f ()))

-- The block form is what a script that names two intermediates writes, and
-- it costs no indentation.
test "a block that does real work" (fn t ->
  with FS.temp_dir "block_" as d -> (
    let done? =
      (
        let stage = Path.join d (Path.of_string "pkg");
        let note = Path.join stage (Path.of_string "note.txt");
        FS.mkdir! stage;
        FS.write_file! note "hello";
        FS.exists? note
      );
    t.ok done?
  ))

-- `let g = f 1` binds a function that was written elsewhere. Inside it, a
-- name means what it meant where it was written, so a new `inc` here does
-- not reach the `inc` that `add` sees.
test "a function value keeps the names it was written with" (fn t ->
  let inc = 5;
  let add a b = a + b + inc;
  let inc = add 1;
  t.eq 8 (inc 2))
