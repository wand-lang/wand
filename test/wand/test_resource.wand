uses {FS.Read, FS.Write, Shell(echo)}

let {test} = import Test
import Resource
import FS
import List
import String
import Path

-- A resource bracket has one job: whatever the body does, the release runs.
-- These check it against each way a body can leave -- returning, raising,
-- and being stopped by a handler that answers without resuming -- because
-- the happy path is the one case that was never in doubt.
--
-- Cleanup is observed through a real file rather than a counter, so a test
-- passes only if the release actually happened.

let marker name = Path.of_string "/tmp/wand_res_%{name}"

let tracked name =
  let acquire = fn () -> (FS.write_file! (marker name) "held"; name);
  let release = fn n -> FS.delete! (marker n);
  Resource.make acquire release

let held? name = FS.exists? (marker name)

test "the body sees what was acquired" (fn t -> t.eq "a" (with tracked "a" as x -> x))

test "released after the body returns" (fn t ->
  let _ = with tracked "b" as x -> x;
  t.eq false (held? "b"))

test "held while the body runs" (fn t -> t.eq true (with tracked "c" as _ -> held? "c"))

-- Release has to happen before `try` turns the raise into a value, or a
-- failing script leaves its lock behind.
test "released when the body raises" (fn t ->
  let r = try with tracked "d" as _ -> List.get! 9 [1];
  let failed =
    match r with
    | Error _ -> true
    | Ok _ -> false
  in
  t.eq (true, false) (failed, held? "d"))

test "the raise still reaches the caller" (fn t ->
  t.raises (fn () -> with tracked "e" as _ -> List.get! 9 [1]))

-- Innermost first: the order things were acquired, reversed.
test "nested brackets release inside out" (fn t ->
  let _ = with tracked "f" as _ -> with tracked "g" as _ -> 1;
  t.eq [false, false] [held? "f", held? "g"])

test "the outer one is still held inside the inner" (fn t ->
  t.eq
    [true, true]
    (with tracked "h" as _ -> with tracked "i" as _ -> [held? "h", held? "i"]))

-- A handler that answers on its own ends the body. What the body was
-- holding still comes back -- otherwise a mock would leak every lock the
-- code it stands in for had taken.
test "released when a handler does not resume" (fn t ->
  let out =
    handle with tracked "j" as _ -> (let c = $(echo hi); c) with
    | Shell!run _ _ -> "mocked"
  in
  t.eq ("mocked", false) (out, held? "j"))

test "released when a handler does resume" (fn t ->
  let out =
    handle with tracked "k" as _ -> (let c = $(echo hi); c) with
    | Shell!run _ k -> k "mocked"
  in
  t.eq ("mocked", false) (out, held? "k"))

-- The release itself performs, and a handler is free to decline to resume
-- what it performs. That unwinds the bracket like any other abandoned
-- region -- it used to reach the top level as a fatal error instead, since
-- the raise doing the unwinding comes from inside the release, which runs
-- as `Fun.protect`'s finally and has whatever it raises wrapped.
test "a handler may decline to resume an operation performed in a release" (fn t -> (
  let out =
    handle with tracked "n" as _ -> "body" with
    | FS!delete _ _ -> "declined"
  in
  -- The delete never reached the disk, so the marker is still there.
  FS.delete! (marker "n");
  t.eq "declined" out
))

-- Each bracket the unwinding passes through wraps the raise once more.
test "and through two brackets" (fn t -> (
  let out =
    handle with tracked "o" as _ -> with tracked "p" as _ -> "body" with
    | FS!delete _ _ -> "declined"
  in
  FS.delete! (marker "o");
  FS.delete! (marker "p");
  t.eq "declined" out
))

-- A resource is a description, not something already open, so naming one
-- acquires nothing and using it twice acquires twice.
test "naming a resource acquires nothing" (fn t ->
  let r = tracked "l";
  t.eq false (held? "l"))

test "one resource used twice" (fn t ->
  let r = tracked "m";
  let first = with r as x -> x;
  let second = with r as x -> x;
  t.eq ["m", "m"] [first, second])

-- ── FS.temp_dir ─────────────────────────────────────────────────────────

-- A scratch directory exists to be filled, so release has to take the tree
-- with it -- an empty-directory removal would fail on the first file the
-- body wrote, which is every real use.
test "temp_dir removes a directory that is not empty" (fn t ->
  let kept =
    with FS.temp_dir "wand_td_" as d -> (
      let dir = Path.to_string d;
      FS.write_file! (Path.of_string "%{dir}/a.txt") "x";
      FS.mkdir! (Path.of_string "%{dir}/sub");
      FS.write_file! (Path.of_string "%{dir}/sub/b.txt") "y";
      dir
    );
  t.eq false (FS.exists? (Path.of_string kept)))

test "temp_dir is a directory that exists while it is held" (fn t ->
  t.eq (true, true) (with FS.temp_dir "wand_td_" as d -> (FS.exists? d, FS.dir? d)))

test "two temp_dirs do not collide" (fn t ->
  let both = with FS.temp_dir "wand_td_" as a -> with FS.temp_dir "wand_td_" as b -> a != b;
  t.eq true both)

-- The tree goes even when the body leaves by raising. The directory's name
-- is written outside it first, so the check survives the body it came from.
test "temp_dir cleans up when the body raises" (fn t -> (
  let note = marker "raise_case";
  let r =
    try with FS.temp_dir "wand_td_" as d -> (
      let dir = Path.to_string d;
      FS.write_file! note dir;
      FS.write_file! (Path.of_string "%{dir}/a.txt") "x";
      List.get! 9 [1]
    );
  let dir = FS.read_file! note;
  FS.delete! note;
  let raised =
    match r with
    | Error _ -> true
    | Ok _ -> false
  in
  t.eq (true, false) (raised, FS.exists? (Path.of_string dir))
))
