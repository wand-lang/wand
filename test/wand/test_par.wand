uses {Clock, FS.Read, FS.Write, Shell}

import Test
let {test} = import Test
import Clock
import Par
import List
import Map
import Result
import FS
import Path
import String

-- ── Results keep the list's order ───────────────────────────────────────

test "results come back in order, not completion order" (fn t ->
  t.eq [Ok 2, Ok 4, Ok 6, Ok 8, Ok 10] (Par.map 4 (fn x -> x * 2) [1, 2, 3, 4, 5]))

test "an empty list is fine" (fn t -> t.eq [] (Par.map 4 (fn x -> x) []))

test "a limit larger than the work is fine" (fn t ->
  t.eq [Ok 2, Ok 3] (Par.map 99 (fn x -> x + 1) [1, 2]))

test "a limit of one still works" (fn t ->
  t.eq [Ok 2, Ok 3, Ok 4] (Par.map 1 (fn x -> x + 1) [1, 2, 3]))

-- ── A failure is a value ────────────────────────────────────────────────

-- One item raising does not cancel its siblings or fail the call: it comes
-- back as an Error where its result would have been.
test "a failure lands in its own position" (fn t ->
  t.eq
    [Ok 1, Error "map key not found: k", Ok 3]
    (Par.map 4 (fn m -> Map.get! "k" m) [{k = 1}, Map.empty, {k = 3}]))

test "and the error carries no source position" (fn t -> (
  let results = Par.map 2 (fn m -> Map.get! "k" m) [Map.empty];
  match List.head results with
  | Some (Error e) -> t.ok (String.starts_with? "map key not found" e)
  | _ -> t.ok false
))

-- ── each runs for effects ───────────────────────────────────────────────

test "each visits every element" (fn t ->
  with FS.temp_dir "wand_par_" as d -> (
    let dir = Path.to_string d;
    Par.each 3 (fn n -> FS.write_file! (Path.of_string "%{dir}/%{n}.txt") "x") [1, 2, 3];
    t.eq 3 (List.length (FS.glob_in *.txt (Path.of_string dir)))
  ))

-- ── Effects performed inside a worker are still interceptable ───────────

-- Each worker installs the program's handlers on its own domain. Without
-- that an effect performed in a worker would escape a rehearsal, which is
-- the one thing a rehearsal must not allow.
test "a worker's commands are seen by a handler" (fn t ->
  let cmds = Test.shell_calls (fn () -> Par.each 3 (fn n -> $(echo hi)) [1, 2]);
  t.eq 2 (List.length cmds))

-- Watching costs the overlap, so it is only paid when someone is watching:
-- with no handler in scope a worker performs its own effects on its own
-- domain, and the work really does run at the same time.
test "a mock still answers a worker's commands" (fn t ->
  let out =
    Test.with_shell [("echo", "mocked")] (fn () -> Par.map 3 (fn n -> $(echo hi)) [1, 2]);
  t.eq [Ok "mocked", Ok "mocked"] out)

-- Several workers, each performing several effects, all watched. A worker's
-- effects are answered one at a time on the calling domain, and the reply
-- carries no idea of who asked -- so with two workers waiting, one could
-- take the answer meant for the other and leave it waiting for a reply that
-- had already been consumed. Eight rounds of it, since a race that only
-- sometimes loses is a race that passes once and fails in CI.
test "many watched workers, several effects each" (fn t ->
  let round =
    fn _ -> Test.shell_calls (fn () ->
      Par.each 4 (fn n -> with FS.temp_dir "wand_par_race_" as d -> (
        FS.write_file! (Path.of_string "%{Path.to_string d}/%{n}.txt") "x";
        $(echo hi)
      )) [1, 2, 3, 4]);
  let counts = List.map (fn r -> List.length r) (List.map round [1, 2, 3, 4, 5, 6, 7, 8]);
  t.eq [4, 4, 4, 4, 4, 4, 4, 4] counts)

-- ── A lock guards workers, not just processes ───────────────────────────

-- A kernel lock is held by the process, so two workers -- two domains of
-- one process -- would both take one and the guard would do nothing. wand
-- keeps a table of what this process holds, which is what makes the second
-- worker fail. Exactly one of four gets it.
test "only one worker takes a lock" (fn t -> (
  let dir = with FS.temp_file "wand_par_lock_" "" as p -> Path.to_string p;
  FS.mkdir! (Path.of_string dir);
  let guard = Path.of_string "%{dir}/one.lock";
  let attempt =
    (fn n -> with FS.lock guard as taken ->
     match taken with
     | Ok _ -> (Clock.sleep 150ms; "took")
     | Error _ -> "held");
  let outcomes = Par.map 4 attempt ["a", "b", "c", "d"];
  FS.delete_tree! (Path.of_string dir);
  t.eq 1 (List.length (List.filter (fn r -> r == Ok "took") outcomes))
))

-- ── Work with effects waits side by side ────────────────────────────────

-- An item that performs an effect runs on the calling domain from then
-- on, so a limit is not bounded by how many threads the machine has.
test "a limit past the number of cores" (fn t ->
  let (took, out) =
    Clock.timed (fn () -> Par.map 300 (fn _ -> Clock.sleep 300ms) (List.range 1 300));
  t.eq (300, true) (List.length (List.filter Result.ok? out), took < 3s))

-- Under a handler each item's effects still reach it, and the waits still
-- overlap rather than taking turns.
test "waits overlap under a handler" (fn t ->
  let (took, out) =
    Clock.timed (fn () ->
      Test.with_shell [("git", "mocked")] (fn () ->
        Par.map 10 (fn _ -> (Clock.sleep 300ms; $(git describe))) (List.range 1 10)));
  t.eq (List.map (fn _ -> Ok "mocked") (List.range 1 10), true) (out, took < 2s))

-- Two workers on one domain are two holders: the second waits for the
-- first to let go rather than being told it holds the lock already.
test "a waiting worker takes the lock once it is free" (fn t -> (
  let dir = with FS.temp_file "wand_par_wait_" "" as p -> Path.to_string p;
  FS.mkdir! (Path.of_string dir);
  let guard = Path.of_string "%{dir}/one.lock";
  let attempt =
    (fn _ -> with FS.lock_wait 3s guard as taken ->
     match taken with
     | Ok _ -> (Clock.sleep 150ms; "took")
     | Error _ -> "held");
  let outcomes = Par.map 2 attempt ["a", "b"];
  FS.delete_tree! (Path.of_string dir);
  t.eq [Ok "took", Ok "took"] outcomes
))
