uses {Clock, Env, FS.Read, FS.Write, Shell(dune)}

import Test
let {group, test, with_clock} = import Test
let {busiest, client} = import ../../examples/ports/log-top-talkers
let {over, usage} = import ../../examples/ports/disk-threshold
let {plan, tidy} = import ../../examples/ports/normalize-names
let {failed, stage} = import ../../examples/ports/ci-gate
let {describe, gaps} = import ../../examples/ports/env-check
let {count_into, share, status, Tally = Tally} = import ../../examples/ports/error-rate
let {blockers, Release = Release} = import ../../examples/ports/release-check
let {flapping, pods, restarts, summary} = import ../../examples/ports/pod-restarts
let {attempt, read, Health = Health} = import ../../examples/ports/http-retry
let {answering?, wait_for} = import ../../examples/ports/wait-for-port
let {missing} = import ../../examples/ports/stage-release
let {failures, stated} = import ../../examples/ports/verify-archives
let {render, Opts = Opts, Flags = Flags} = import ../../examples/ports/probe-args
let {age, backup_name, expired, expired?, ours?, window} =
  import ../../examples/ports/rotate-backups
-- `failures` is verify-archives' already, and the last import of a name
-- decides every use of it (V-IMP1), so this one is renamed here.
let {changed?, failures = unmet, line, outcome, outcomes, steps, Made, Already, Failed, Step} =
  import ../../examples/ports/provision-host
import Args
import Env
import FS
import Float
import List
import Map
import Option
import Path
import Result
import String

-- The ports in examples/ports/, checked without a machine to read.
--
-- Importing a wand file runs its bindings and not its bare expressions, so
-- a port whose work sits in `main` and whose last line calls it is both a
-- script and a module: running it does the work, importing it does
-- nothing. Every port here is written that way, which is what lets these
-- tests hold one.

group "log-top-talkers" (fn () -> [
  test "the client is the first field" (fn t ->
    t.eq (Some "10.0.0.9") (client `10.0.0.9 - - [x] "GET /" 200`)),
  test "a blank line has no client" (fn t -> t.ok (Option.none? (client ""))),
  test "the busiest come first" (fn t ->
    t.eq [("a", 3), ("b", 2)] (busiest 2 (Map.from_list [("a", 3), ("b", 2), ("c", 1)]))),
  -- A tie is broken by name, so the report does not shuffle between runs.
  test "a tie is broken by name" (fn t ->
    t.eq [("a", 2), ("b", 2)] (busiest 2 (Map.from_list [("b", 2), ("a", 2)])))
])

group "disk-threshold" (fn () -> [
  test "a mount and its percentage" (fn t ->
    t.eq (Some ("/", 91)) (usage "/dev/disk1s1 1000 910 90 91% /")),
  test "the header is not a row" (fn t ->
    t.ok (Option.none? (usage "Filesystem 1024-blocks Used Available Capacity Mounted on"))),
  test "a capacity that is not a number" (fn t ->
    t.ok (Option.none? (usage "/dev/a 1 1 1 n/a /mnt"))),
  test "only what is over the limit" (fn t ->
    t.eq [("/", 91)] (over 90 ["/dev/a 1 1 1 91% /", "/dev/b 1 1 1 12% /home"])),
  test "the limit itself is not over it" (fn t -> t.eq [] (over 90 ["/dev/a 1 1 1 90% /"]))
])

group "normalize-names" (fn () -> [
  test "spaces and case" (fn t -> t.eq "notes-on-rust.txt" (tidy "Notes On Rust.txt")),
  test "a name already in the house style is not in the plan" (fn t ->
    t.eq [] (plan [./fine.txt])),
  -- A path literal holds no space, so a name with one is written as a
  -- string and converted.
  test "and one that is not, is" (fn t ->
    let messy = Path.of_string "./A File.txt";
    t.eq [(messy, ./a-file.txt)] (plan [messy]))
])

-- The effectful half is testable too: `Test.with_shell_results` answers the three
-- commands, so the gate can be run with any verdict. A command the table
-- misses exits zero.
let failing cmd = (cmd, ShellResult(stdout = "", stderr = "", code = 1))

group "ci-gate" (fn () -> [
  test "a stage is its exit code" (fn t ->
    t.eq ("build", true) (stage "build" ShellResult(stdout = "", stderr = "", code = 0))),
  test "and a non-zero code fails it" (fn t ->
    t.eq ("build", false) (stage "build" ShellResult(stdout = "", stderr = "", code = 2))),
  test "nothing failed when every command answers zero" (fn t ->
    t.eq
      []
      (Test.with_shell_results [] (fn () ->
        failed [stage "build" $?(dune build), stage "test" $?(dune test)]))),
  test "the failing stage is named" (fn t ->
    t.eq
      [("test", false)]
      (Test.with_shell_results [failing "dune test"] (fn () ->
        failed [stage "build" $?(dune build), stage "test" $?(dune test)])))
])

-- `Env!get` supplies the String its raising builtin returns, so a handler
-- cannot say "unset" -- that state is the raise. These read the real
-- environment under names nothing else uses.
group "env-check" (fn () -> [
  test "a variable that is not set" (fn t ->
    t.eq ["WAND_PORTS_ABSENT is not set"] (List.map describe (gaps ["WAND_PORTS_ABSENT"]))),
  -- The distinction bash cannot make: exported and empty is not unset.
  test "and one set to the empty string" (fn t -> (
    Env.set "WAND_PORTS_EMPTY" "";
    t.eq
      ["WAND_PORTS_EMPTY is set to the empty string"]
      (List.map describe (gaps ["WAND_PORTS_EMPTY"]))
  )),
  test "a variable with a value is no gap" (fn t -> (
    Env.set "WAND_PORTS_SET" "postgres://x";
    t.eq [] (gaps ["WAND_PORTS_SET"])
  ))
])

group "error-rate" (fn () -> [
  test "the status code of a request line" (fn t ->
    t.eq (Some 503) (status `10.0.0.1 - - [x] "GET /a HTTP/1.1" 503 128`)),
  test "a line that carries no code" (fn t -> t.ok (Option.none? (status "starting up"))),
  test "a 5xx is a failure" (fn t ->
    t.eq
      Tally(ok = 0, failed = 1)
      (count_into Tally(ok = 0, failed = 0) `- - - [x] "GET /" 503 1`)),
  test "and anything else is not" (fn t ->
    t.eq
      Tally(ok = 1, failed = 0)
      (count_into Tally(ok = 0, failed = 0) `- - - [x] "GET /" 404 1`)),
  -- The integer division bash does here answers 0.
  test "a share below one percent is not zero" (fn t ->
    t.eq "0.8" (Float.format 1 (share Tally(ok = 992, failed = 8)))),
  test "no requests is no failures" (fn t -> t.eq 0.0 (share Tally(ok = 0, failed = 0)))
])

group "release-check" (fn () -> [
  test "a release with nothing wrong ships" (fn t ->
    t.eq
      []
      (blockers 1.0.0 Release(
        version = 1.2.0,
        draft = false,
        artifacts = ["a", "b", "c", "d"]
      ))),
  test "every reason at once, not the first" (fn t ->
    t.eq
      ["still a draft", "0.9.0 is below 1.0.0", "1 artifacts, expected 4"]
      (blockers 1.0.0 Release(version = 0.9.0, draft = true, artifacts = ["a"])))
])

-- A document with two containers in one pod, the first of them healthy --
-- the shape `jq '.status.containerStatuses[0].restartCount'` reads wrong.
let doc = `
{"items":[
     {"metadata":{"name":"web-01","namespace":"default"},
      "status":{"phase":"Running","containerStatuses":[
        {"name":"web","restartCount":0},{"name":"sidecar","restartCount":7}]}},
     {"metadata":{"name":"web-02","namespace":"default"},
      "status":{"phase":"Running","containerStatuses":[
        {"name":"web","restartCount":1}]}}]}`

group "pod-restarts" (fn () -> [
  test "the document reads into pods" (fn t ->
    match pods doc with
    | Ok found -> t.eq 2 (List.length found)
    | Error _ -> t.ok false),
  test "restarts is every container, not the first" (fn t ->
    match pods doc with
    | Ok [first, _] -> t.eq 7 (restarts first)
    | _ -> t.ok false),
  test "only what is over the limit" (fn t ->
    match pods doc with
    | Ok found -> t.eq 1 (List.length (flapping 3 found))
    | Error _ -> t.ok false),
  test "the line names the namespace and the pod" (fn t ->
    match pods doc with
    | Ok [first, _] -> t.eq "default/web-01\tRunning\t7 restarts" (summary first)
    | _ -> t.ok false),
  -- A document that does not match names the field it stopped at.
  test "a missing field is named" (fn t ->
    match pods
      `{"items":[{"metadata":{"name":"a"},"status":{"phase":"R","containerStatuses":[]}}]}` with
    | Ok _ -> t.ok false
    | Error e -> t.ok (String.contains? "namespace" e))
])

-- The retry is a function over a thunk, so a test drives it with answers of
-- its own and never reaches a host. `Test.with_clock` answers the sleeps at
-- no cost, and reports what the waits added up to.
--
-- The status is what the retry decides on, which is the thing the bash it
-- replaces could not see: a 503 is worth asking again and a 404 is not.
let answering code = HTTPResponse(status = code, headers = {}, body = "")

group "http-retry" (fn () -> [
  test "the first answer is taken" (fn t ->
    t.eq
      (Ok "body")
      (attempt 3 1s (fn () -> HTTPResponse(status = 200, headers = {}, body = "body")))),
  test "a server error gives up after the last try" (fn t ->
    t.eq (Error "answered 503") (attempt 3 1s (fn () -> answering 503))),
  -- The whole point of the port: bash retried this one too.
  test "a request error is not retried at all" (fn t ->
    let (waited, outcome) = with_clock (fn () -> attempt 3 1s (fn () -> answering 404));
    t.eq (0ms, Error "answered 404") (waited, outcome)),
  -- 1s then 2s: the backoff doubles, and three tries wait twice.
  test "the backoff doubles and the tries are capped" (fn t ->
    let (waited, _) = with_clock (fn () -> attempt 3 1s (fn () -> answering 503));
    t.eq 3s waited),
  test "a body reads into the type" (fn t ->
    t.eq
      (Ok Health(status = "ok", version = 1.2.0))
      (read `{"status":"ok","version":"1.2.0"}`)),
  test "and a document that does not match names the field" (fn t ->
    match read `{"status":"ok"}` with
    | Ok _ -> t.ok false
    | Error e -> t.ok (String.contains? "version" e))
])

-- The deadline is real, so the durations are short. It cannot be virtual:
-- under a mocked clock the sleeper takes no time, so `Par.timeout` refuses
-- one. The probe is a thunk, so no socket is opened here.
group "wait-for-port" (fn () -> [
  test "a probe that answers returns at once" (fn t ->
    t.eq (Ok true) (wait_for 200ms 50ms (fn () -> true))),
  test "and one that never does hits the deadline" (fn t ->
    match wait_for 200ms 50ms (fn () -> false) with
    | Ok _ -> t.ok false
    | Error why -> t.ok (String.contains? "200ms" why)),
  -- `nc -z` exits zero when the port answers, and the probe reads nothing
  -- else, so the whole test is which code comes back.
  test "an open port is answering" (fn t ->
    t.ok (Test.with_shell_results [] (fn () -> answering? "localhost" :8080))),
  test "and a closed one is not" (fn t ->
    t.eq
      false
      (Test.with_shell_results [failing "nc -z 'localhost' '8080'"] (fn () ->
        answering? "localhost" :8080))),
  -- The port goes in as a number and each splice is one argument, which is
  -- what keeps a host with a space in it from becoming two.
  test "the command as it is run" (fn t ->
    t.eq
      ["nc -z 'localhost' '8080'"]
      (Test.shell_calls (fn () -> answering? "localhost" :8080)))
])

group "stage-release" (fn () -> [
  test "a complete release is missing nothing" (fn t ->
    t.eq [] (missing [./VERSION, ./LICENSE, ./wand])),
  test "and reports every file that is not there" (fn t ->
    t.eq ["LICENSE", "wand"] (missing [./VERSION])),
  -- The staged directory holds more than a release needs, which is not a
  -- reason to refuse it.
  test "extra files are not a problem" (fn t ->
    t.eq [] (missing [./VERSION, ./LICENSE, ./wand, ./notes.md])),
  test "a path is read by its last element" (fn t ->
    t.eq [] (missing [./dist/VERSION, ./dist/LICENSE, ./dist/wand])),
  -- The lock the port takes is held for the body and released after, which
  -- is the half of `trap ... EXIT` that a second trap takes away. A lock is
  -- not re-entrant, so asking for it inside the body is refused and asking
  -- after it is not -- which is the release, said in what a caller can see.
  test "the lock is held for the body and released after" (fn t ->
    with FS.temp_dir "lock_" as dir -> (
      let path = Path.join dir (Path.of_string "held.lock");
      let inside = with FS.lock path as _ -> with FS.lock path as again -> Result.ok? again;
      let after = with FS.lock path as again -> Result.ok? again;
      t.eq (false, true) (inside, after)
    ))
])

-- Two layers of Result: the outer one is `Par.map` reporting work that
-- raised, the inner one is the check reporting an archive that did not
-- match. All four shapes reach the report.
group "verify-archives" (fn () -> [
  test "a matching digest is not a failure" (fn t ->
    t.eq [] (failures [(./a.sha256, Ok (Ok true))])),
  test "one that does not match is named" (fn t ->
    t.eq [(./a.sha256, "digest does not match")] (failures [(./a.sha256, Ok (Ok false))])),
  test "a check that could not run is named" (fn t ->
    t.eq [(./a.sha256, "no such file")] (failures [(./a.sha256, Ok (Error "no such file"))])),
  test "and work that raised is named" (fn t ->
    t.eq [(./a.sha256, "exited 1")] (failures [(./a.sha256, Error "exited 1")])),
  test "the order is the order the files came in" (fn t ->
    t.eq
      [./b.sha256, ./d.sha256]
      (List.map
        (fn (file, _) -> file)
        (failures [
          (./a.sha256, Ok (Ok true)),
          (./b.sha256, Ok (Ok false)),
          (./c.sha256, Ok (Ok true)),
          (./d.sha256, Error "exited 1")
        ]))),
  -- The name in a `.sha256` is bare, so it is read against the directory
  -- the file sits in and not against wherever the script runs.
  test "the archive is found beside its checksum" (fn t ->
    with FS.temp_dir "sha_" as dir -> (
      let sums = Path.join dir (Path.of_string "a.tar.gz.sha256");
      FS.write_file! sums "abc123  a.tar.gz\n";
      t.eq (Ok ("abc123", Path.join dir (Path.of_string "a.tar.gz"))) (stated sums)
    ))
])

-- argv is a list of strings, so the whole parser is testable without a
-- command line. `verbose` is named because whether a flag takes a value is
-- the one fact a list of strings cannot reveal.
let read argv = Args.read Opts.parser argv

group "probe-args" (fn () -> [
  test "a host and nothing else takes the defaults" (fn t ->
    t.eq (Ok Opts(host = "web-01", flags = Flags())) (read ["web-01"])),
  test "every flag, read as its type" (fn t ->
    t.eq
      (Ok Opts(host = "web-01", flags = Flags(port = :9000, timeout = 5s, verbose = true)))
      (read ["--port", ":9000", "--timeout", "5s", "--verbose", "web-01"])),
  test "the flag order does not matter" (fn t ->
    t.eq (read ["--port", ":9000", "web-01"]) (read ["web-01", "--port", ":9000"])),
  -- getopts takes `-p http` and fails somewhere else.
  test "a port that is not one names the field" (fn t ->
    match read ["--port", "http", "web-01"] with
    | Ok o -> t.fail "expected a refusal, got %{render o}"
    | Error why -> t.ok (String.contains? "port" why)),
  test "no host is refused" (fn t -> t.eq (Error ".host: expected a host") (read [])),
  test "and so is a second one" (fn t ->
    match read ["web-01", "web-02"] with
    | Ok o -> t.fail "expected a refusal, got %{render o}"
    | Error why -> t.ok (String.contains? "one host" why)),
  -- The usage line comes from the same declaration the decoder reads, so a
  -- flag cannot be in one and missing from the other.
  test "the usage line is the type's" (fn t ->
    t.eq "[--port :8080] [--timeout 30s] [--verbose] <host>" Opts.usage),
  -- Which flags take no value, and which collect, are the facts argv
  -- cannot carry, and they come from the same declaration.
  test "and so is the account of the flags" (fn t ->
    t.eq {verbose = "switch"} Opts.parser.spec),
  test "the line it reports" (fn t ->
    match read ["--verbose", "web-01"] with
    | Ok o -> t.eq "web-01:8080 timeout 30s (verbose)" (render o)
    | Error why -> t.fail why)
])

group "rotate-backups" (fn () -> [
  -- `find -mtime +30` counts whole days and drops the remainder, so it
  -- keeps a file for thirty-one. The window here is the duration it says.
  test "a backup inside the window is kept" (fn t ->
    t.eq false (expired? 2026-08-22T00:00:00Z 2026-08-01T00:00:00Z)),
  test "and one past it is not" (fn t ->
    t.ok (expired? 2026-08-22T00:00:00Z 2026-06-01T00:00:00Z)),
  test "the boundary is not past the window" (fn t ->
    t.eq false (expired? 2026-08-22T00:00:00Z 2026-07-23T00:00:00Z)),
  test "an hour the wrong side of it is" (fn t ->
    t.ok (expired? 2026-08-22T00:00:00Z 2026-07-22T23:00:00Z)),
  test "age is the length between two instants" (fn t ->
    t.eq 1d (age 2026-08-22T00:00:00Z 2026-08-21T00:00:00Z)),
  test "the window is what the name says" (fn t -> t.eq 30d window),
  -- The listing decides; nothing is read and nothing is removed.
  test "only what is past the window is returned" (fn t ->
    t.eq
      [(./backups/backup-old.tgz, 2026-06-01T00:00:00Z)]
      (expired 2026-08-22T00:00:00Z [
        (./backups/backup-new.tgz, 2026-08-20T00:00:00Z),
        (./backups/backup-old.tgz, 2026-06-01T00:00:00Z)
      ])),
  test "an empty listing rotates nothing" (fn t ->
    t.eq [] (expired 2026-08-22T00:00:00Z [])),
  test "every backup past the window, not the first" (fn t ->
    t.eq 2 (List.length (expired 2026-08-22T00:00:00Z [
      (./a.tgz, 2026-01-01T00:00:00Z),
      (./b.tgz, 2026-08-21T00:00:00Z),
      (./c.tgz, 2026-02-01T00:00:00Z)
    ]))),
  -- `-name 'backup-*.tgz'` was the only thing standing between `-delete`
  -- and the rest of the directory.
  test "a file this script did not write is not ours" (fn t ->
    t.eq false (ours? ./backups/notes.md)),
  test "and one it did, is" (fn t -> t.ok (ours? ./backups/backup-1.tgz)),
  -- `date +%F` is a day, so two backups on one day are one file.
  test "the name carries the time, not just the day" (fn t ->
    t.ok (backup_name 2026-08-22T01:00:00Z != backup_name 2026-08-22T02:00:00Z))
])

group "provision-host" (fn () -> [
  -- The whole of what `|| true` throws away. `useradd` exits 9 for a user
  -- that is already there and 1 for a command that was wrong; one of those
  -- is fine and the other is not.
  test "exit zero made it" (fn t ->
    t.eq (Made) (outcome Step(name = "user deploy", done? = 9)
      ShellResult(stdout = "", stderr = "", code = 0))),
  test "the code that means already there is not a failure" (fn t ->
    t.eq (Already) (outcome Step(name = "user deploy", done? = 9)
      ShellResult(stdout = "", stderr = "", code = 9))),
  test "and every other code still is" (fn t ->
    t.eq (Failed 1) (outcome Step(name = "user deploy", done? = 9)
      ShellResult(stdout = "", stderr = "", code = 1))),
  -- apt-get exits 100 when it could not take the dpkg lock. Nothing was
  -- installed, and `|| true` reports that run as a success.
  test "a lock it could not take is a failure, not a no-op" (fn t ->
    t.eq (Failed 100) (outcome Step(name = "package nginx", done? = 0)
      ShellResult(stdout = "", stderr = "", code = 100))),
  test "a step with no already-there code treats every non-zero as failure"
    (fn t ->
      t.eq (Failed 9) (outcome Step(name = "key mode", done? = 0)
        ShellResult(stdout = "", stderr = "", code = 9))),
  -- The property the bash cannot report: whether the second run did
  -- anything.
  test "a run that made nothing did not change the host" (fn t ->
    t.eq false (changed? [
      (Step(name = "a", done? = 9), Already),
      (Step(name = "b", done? = 0), Already)
    ])),
  test "and one that made something did" (fn t ->
    t.ok (changed? [
      (Step(name = "a", done? = 9), Already),
      (Step(name = "b", done? = 0), Made)
    ])),
  test "every failure is named with its code, not just the first" (fn t ->
    t.eq [("a", 1), ("c", 100)] (unmet [
      (Step(name = "a", done? = 0), Failed 1),
      (Step(name = "b", done? = 0), Made),
      (Step(name = "c", done? = 0), Failed 100)
    ])),
  test "a clean run has no failures" (fn t ->
    t.eq [] (unmet [(Step(name = "a", done? = 0), Made)])),
  test "the line says which of the three it was" (fn t ->
    t.eq "already  user deploy"
      (line Step(name = "user deploy", done? = 9) Already)),
  test "and a failure carries the code" (fn t ->
    t.eq "FAILED   package nginx (exit 100)"
      (line Step(name = "package nginx", done? = 0) (Failed 100))),
  -- The steps and the results are paired in step order, so the report
  -- reads in the order the file declares.
  test "outcomes pairs each step with its own result" (fn t ->
    t.eq [Made, Already] (List.map (fn (_, o) -> o) (outcomes
      [Step(name = "a", done? = 0), Step(name = "b", done? = 9)]
      [ShellResult(stdout = "", stderr = "", code = 0),
       ShellResult(stdout = "", stderr = "", code = 9)]))),
  test "every step this script declares is covered" (fn t ->
    t.eq 4 (List.length steps))
])
