import List
import String

let _Split = import ./_split

-- Text helpers, as a package another package requires.
--
-- `_split` is private: this package imports it, as `_Split`, and another
-- package cannot.

-- A string as a URL slug: lower case, words joined by `-`.
let slug text = _Split.words (String.lower text) |> String.join "-"

-- A word with its first letter in upper case.
let capital word =
  String.upper (String.slice 0 1 word) ++ String.slice 1 (String.length word) word

-- Each word with its first letter in upper case, joined by spaces.
let title text = _Split.words text |> List.map capital |> String.join " "
