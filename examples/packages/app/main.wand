uses {IO}

import IO
import List

let TextTools = import github.com/wand-lang/text-tools

-- A package that uses another one.
--
-- `wand.pkg` requires github.com/wand-lang/text-tools, with `local` set to
-- the copy beside this one, so nothing is fetched. With `local` gone, a run
-- fetches the version named there with git, and checks it against the sum
-- section that `wand p tidy` writes.
--
-- The import has no scheme, and a module is named in upper case: `TextTools`.

let posts = ["Hello, World", "Packages in wand", "Fibers & services"]

-- A post's title and the path it is served at.
let entry post = (TextTools.title post, "/posts/%{TextTools.slug post}")

let main () =
  posts |> List.map entry |> List.each (fn (title, path) -> IO.println "%{path}  %{title}")

main ()
