uses {FS.Read, IO, Proc}

import IO
import JSON
import List
import Proc
import Result

-- Read a release manifest and say whether it may ship.
--
-- bash:  ver=$(jq -r .version release.json)
--        if [ "$(jq -r '.artifacts | length' release.json)" -lt 4 ]; then
--          echo "not every platform built" >&2; exit 1
--        fi
--
-- `jq -r` prints `null` for a field that is not there, and the shell then
-- compares the four characters `null` against a version. A missing
-- `artifacts` array prints nothing at all, and `[ -lt ]` reads the empty
-- string as an error the script does not check. Every field is a string
-- until something treats it otherwise.
--
-- The type names each field and what it holds, once, and `Release.decoder`
-- is read off that. A document that does not match says which field, and
-- the version compares as a version.

type Release(version: Version, draft: Bool, artifacts: List String)

-- Every reason this release cannot ship, rather than the first one.
let blockers floor (r: Release) =
  [
    (r.draft, "still a draft"),
    (r.version < floor, "%{r.version} is below %{floor}"),
    (List.length r.artifacts < 4, "%{List.length r.artifacts} artifacts, expected 4")
  ]
  |> List.filter_map (fn (bad, why) -> if bad then Some why else None)

let report floor r =
  match blockers floor r with
  | [] -> IO.println "ready"
  | reasons -> (reasons |> List.each (fn why -> IO.println_err why); Proc.exit 1)

let read path = JSON.read_file path |> Result.and_then (JSON.decode Release.decoder)

-- The manifest is read in `main`: `test/wand/test_ports.wand` imports this
-- file, and an import runs a file's bindings but not its bare expressions,
-- so importing it touches no disk.
let main () =
  match read ./release.json with
  | Error why -> (IO.println_err "release.json: %{why}"; Proc.exit 1)
  | Ok r -> report 1.0.0 r

main ()
