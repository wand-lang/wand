uses {IO, Proc}

import Args
import IO
import Proc

-- Read a command line, and refuse one that does not say what it means.
--
-- bash:  usage() { echo "usage: $0 [-p port] [-t timeout] [-v] host"; exit 1; }
--        port=8080; timeout=30; verbose=0
--        while getopts "p:t:v" opt; do
--          case $opt in
--            p) port=$OPTARG ;;
--            t) timeout=$OPTARG ;;
--            v) verbose=1 ;;
--            \?) usage ;;
--          esac
--        done
--        shift $((OPTIND - 1))
--        [ $# -eq 1 ] || usage
--        host=$1
--
-- Four places know the flags: the `getopts` string, the case arms, the
-- defaults above the loop, and the usage text. Adding one means editing
-- all four, and forgetting the fourth is the common way a usage message
-- goes stale. `getopts` also does short flags only -- `--port` needs a
-- hand-rolled loop -- and `$OPTARG` is a string, so `-p http` is taken
-- here and fails somewhere else, if anything checks it at all.
--
-- A type says the shape once. `--port http` is refused at the boundary,
-- naming the field, and `:8080` is a `Port` from there on.

-- The flags, with what each holds when it is left out.
type Flags(port: Port = :8080, timeout: Duration = 30s, verbose: Bool = false)

-- The whole command line: the flags, and the one thing written without a
-- flag in front of it. `host` is a `String` rather than a list, which is
-- what says there is exactly one of them -- and what refuses two.
--
-- This declaration is the only place any of it is written. The reader comes
-- from it, and so do the usage line and the account of the flags: which take
-- no value, and which collect. None of that is visible in argv.
type Opts(flags: Flags, host: String)

let render (o: Opts) =
  "%{o.host}%{o.flags.port} timeout %{o.flags.timeout}%{if o.flags.verbose then " (verbose)" else ""}"

let usage = "usage: probe-args %{Opts.usage}"

-- argv is read in `main`: `test/wand/test_ports.wand` imports this file,
-- and an import runs a file's bindings but not its bare expressions, so a
-- test sees the test runner's arguments only if it asks for them.
let main () =
  if Args.help? (Proc.args ()) then IO.println usage
  else match Args.read Opts.parser (Proc.args ()) with
    | Ok o -> IO.println (render o)
    | Error why -> (IO.println_err "%{why}"; IO.println_err usage; Proc.exit 1)

main ()
