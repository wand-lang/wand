uses {FS.Read, IO, Proc}

import Base64
import Decode
import FS
import IO
import List
import Map
import Proc
import Result
import String
import YAML

-- Read the keys of a Kubernetes secret, decoded, without putting any value
-- on a command line.
--
-- bash:  kubectl get secret db -o jsonpath='{.data.password}' | base64 -d
--
-- Three things go wrong quietly here. `base64 -d` is GNU; BSD spells it
-- `-D`, so the line works on the cluster's jump host and not on a laptop.
-- `jsonpath` prints no trailing newline, which is what you want, but any
-- wrapper that adds one makes the input invalid padding -- and `base64`
-- reports that by writing the partial decode and exiting non-zero, which a
-- pipeline swallows. And one key per invocation means a secret with six
-- keys is six `kubectl` calls, each of which puts the value into a shell
-- pipeline where the history file can see it.
--
-- Reading the manifest once gives every key. `Base64.decode` answers a
-- `Result`, so bad padding is a value rather than partial output. This
-- prints the names and the length of each value; the values themselves
-- stay in the process.

type Secret(name: String, data: Map String)

let decoder =
  Decode.map2
    (fn name data -> Secret(name, data))
    (Decode.field "metadata" (Decode.field "name" Decode.string))
    (Decode.field "data" (Decode.dict Decode.string))

let read path =
  FS.read_file path |> Result.and_then YAML.parse |> Result.and_then (YAML.decode decoder)

-- A value that does not decode is reported beside its key rather than
-- ending the report: one bad entry should not hide the other five.
let entries (secret: Secret) =
  secret.data
  |> Map.to_list
  |> List.map (fn (key, encoded) ->
    match Base64.decode encoded with
    | Ok value -> (key, Ok (String.length value))
    | Error why -> (key, Error why))

let main () =
  match read ./secret.yaml with
  | Error why -> (IO.println_err why; Proc.exit 1)
  | Ok secret -> (
    IO.println "secret %{secret.name}";
    entries secret
    |> List.each (fn (key, outcome) ->
      match outcome with
      | Ok n -> IO.println "  %{key}: %{n} bytes"
      | Error why -> IO.println_err "  %{key}: %{why}")
  )

main ()
