uses {Clock, Env, IO, Net(example.com), Proc}

import Clock
import Duration
import Env
import HTTP
import IO
import JSON
import Proc
import Result
import String

-- Read a JSON endpoint that needs a token, and retry a failure worth
-- retrying.
--
-- bash:  for i in 1 2 3; do
--          curl -s -H "Authorization: Bearer $TOKEN" "$URL" && break
--          sleep $((i * 2))
--        done
--
-- `curl` without `--fail` exits 0 on a 500, so `&& break` takes the error
-- page as the answer and stops retrying. The loop has no ceiling on the
-- wait it will do, and the body it finally gets is text nobody reads.
--
-- Adding `--fail` fixes the exit code and loses the status: the shell can
-- then tell success from failure, but not a 503 worth retrying from a 404
-- that never will. Getting it back means `--write-out "%{http_code}"` and
-- parsing the number out of the output beside the body.
--
-- A `Response` has a `status` field, so that whole problem is one `match`.
-- The manifest says where the bytes go rather than which binary ran, and
-- the body decodes into a type, so a schema change is an error with a field
-- name in it.

type Health(status: String, version: Version)

-- A 404 is not an `Error`: the exchange happened and the server said no.
-- So the retry decides on the status, which is the thing bash could not
-- see. A server error may pass; a request error will not, however many
-- times it is asked.
let worth_retrying? (r: HTTP.Response) = r.status >= 500

-- The request is built where the host is written, so the manifest's
-- `Net(example.com)` is checked against a name a reader can see. A helper
-- taking the URL as a parameter would move the host out of the text, and
-- `V-NET1` says so.
--
-- The token is a header rather than an argument, so it is not on anybody's
-- command line. `ps` could read it out of the bash above.
let ask! req = HTTP.request! req

let attempt tries wait thunk =
  let r = thunk ();
  if HTTP.ok? r then Ok r.body
  else if tries <= 1 || !(worth_retrying? r) then Error "answered %{r.status}"
  else (Clock.sleep wait; attempt (tries - 1) (Duration.scale 2 wait) thunk)

let read out = JSON.parse out |> Result.and_then (JSON.decode Health.decoder)

let report (h: Health) = IO.println "%{h.status}, version %{h.version}"

-- The request is made in `main!`: `test/wand/test_ports.wand` imports this
-- file, and an import runs a file's bindings but not its bare expressions,
-- so importing it reaches no host.
let main! () =
  match Env.get "TOKEN" with
  | None -> (IO.println_err "TOKEN is not set"; Proc.exit 1)
  | Some token -> (
    let req =
      HTTP.Request(
        url = https://example.com/health,
        headers = {authorization = "Bearer %{token}"}
      );
    match attempt 3 1s (fn () -> ask! req) with
    | Error why -> (IO.println_err why; Proc.exit 1)
    | Ok body -> (
      match read body with
      | Error why -> (IO.println_err "%{why}"; Proc.exit 1)
      | Ok h -> report h
    )
  )

main! ()
