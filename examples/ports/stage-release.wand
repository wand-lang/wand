uses {FS.Read, FS.Write, IO, Proc}

import FS
import IO
import List
import Path
import Proc

-- Build a release in a scratch directory, under a lock, and clean up both
-- however it ends.
--
-- bash:  tmp=$(mktemp -d)
--        trap 'rm -rf "$tmp"' EXIT
--        touch /var/lock/release
--        trap 'rm -f /var/lock/release' EXIT     # clobbers the first
--        ... build into $tmp ...
--
-- The second `trap ... EXIT` replaces the first rather than adding to it,
-- so the scratch directory outlives the script. Nothing says so. Writing
-- both into one trap is the fix, and it means every cleanup in the script
-- has to be written in one place, in reverse order, by hand.
--
-- A bracket is a value here. Two of them nest, both release, and the
-- release runs however the body ends -- returning, raising, or exiting.
-- The order is the reverse of acquisition without anyone maintaining it.

-- What a release needs. A staged directory missing any of these is not one,
-- and the check is a function so it can be tested without staging.
let required = ["VERSION", "LICENSE", "wand"]

let missing staged =
  let names = staged |> List.map (fn p -> Path.to_string (Path.basename p));
  required |> List.filter (fn want -> !(List.any? (fn got -> got == want) names))

let stage! dir = (
  FS.write_file! (Path.join dir (Path.of_string "VERSION")) "0.31.0\n";
  FS.write_file! (Path.join dir (Path.of_string "LICENSE")) "MIT\n";
  FS.write_file! (Path.join dir (Path.of_string "wand")) "#!/bin/sh\n";
  FS.list_dir! dir
)

-- The lock is outside the scratch directory on purpose: two cleanups that
-- have nothing to do with each other are what the bash cannot write.
--
-- `FS.lock` is the operating system's lock on an open file, so a second run
-- is told the lock is held rather than writing over it. A lock file written
-- with `write_file!` is not a lock: both runs write it and both proceed.
-- The lock and the copies are in `main!`: `test/wand/test_ports.wand`
-- imports this file, and an import runs a file's bindings but not its bare
-- expressions, so importing it takes no lock.
let main! () =
  with FS.temp_dir "release_" as dir ->
  with FS.lock ./release.lock as taken ->
  match taken with
  | Error why -> (IO.println_err "another release is staging: %{why}"; Proc.exit 1)
  | Ok _ -> (
    match missing (stage! dir) with
    | [] -> IO.println "staged %{Path.to_string dir}"
    | gaps -> (
      IO.println_err "not a release, %{List.length gaps} file(s) short:";
      gaps |> List.each (fn name -> IO.println_err "  %{name}");
      Proc.exit 1
    )
  )

main! ()
