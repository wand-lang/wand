uses {IO, Proc, Shell(apt-get, chmod, dpkg, ln, useradd)}

import IO
import List
import Proc

-- Provision a host: a package, a service user, a key with the mode ssh
-- insists on, and a config linked into /etc. Run it twice and the second
-- run changes nothing.
--
-- bash:  apt-get install -y nginx || true
--        useradd -r deploy || true
--        chmod 0600 /home/deploy/.ssh/id_ed25519
--        ln -sf /opt/app/nginx.conf /etc/nginx/conf.d/app.conf
--
-- `|| true` is how a bash provisioning script becomes re-runnable, and it
-- is the bug. `useradd` exits 9 when the user is already there and 1 when
-- the command was wrong; `apt-get` exits 100 when it could not take the
-- dpkg lock. `|| true` reads all three as success, so the run where
-- another process held the lock and nothing was installed is the run that
-- reports nothing wrong. The script is idempotent and dishonest at once.
--
-- The exit code is the whole of the difference, and `$?()` hands it back
-- as a value. Each step names the one code that means "already done", so
-- everything else is still a failure and stays one.
--
-- This is the row where wand shells out for nearly all of it. Nothing in
-- `FS` sets a mode, a symlink or an owner, so those two steps are `$()`
-- calls and read like it. What wand adds is the manifest -- every binary
-- this file may run is on line one, checked -- and an exit code that has
-- to be looked at rather than discarded.
--
-- What an exit code cannot do is worth knowing, because it bounds three
-- steps below. `apt-get install` exits 0 whether or not the package was
-- there, so the package is asked about first, with `dpkg -s`. `chmod` and
-- `ln -sfn` exit 0 whether or not they changed anything, so those two
-- report `set` -- done, with no way to say whether it was already so --
-- and a run that only sets them says the host is as declared rather than
-- that it changed. Telling them apart means reading the mode and the
-- link back, and reading a mode is the one thing here a shell cannot do
-- portably -- `stat -c '%a'` is GNU, `stat -f '%Lp'` is BSD. That is the
-- price of the decision, paid here.

-- What a step answered. `Set` is a step done by a command whose exit code
-- cannot say whether anything changed. `Failed` carries the code because
-- the number is what tells someone which failure it was.
type Outcome = Made | Already | Set | Failed Int

-- One step of the desired state, by the name the report gives it.
type Step(name: String)

-- `useradd` exits 9 for a user that is already there: the one code that is
-- not a failure. Every other non-zero still is.
let by_code already code =
  if code == 0 then Made else if code == already then Already else Failed code

let told code = if code == 0 then Set else Failed code

-- The package is asked about before it is installed, because `apt-get`
-- exits 0 either way.
let package () =
  if $?(dpkg -s nginx).code == 0 then Already
  else by_code (0 - 1) $?(apt-get install -y nginx).code

let steps = [
  (Step(name = "package nginx"), "package"),
  (Step(name = "user deploy"), "user"),
  (Step(name = "key mode"), "key"),
  (Step(name = "config link"), "link")
]

-- A run changed the host if any step made something. Steps that were only
-- set do not count, because nothing says they changed.
let changed? results = List.any? (fn (_, o) -> o == Made) results

let failed? o =
  match o with
  | Failed _ -> true
  | _ -> false

let line (step: Step) o =
  match o with
  | Made -> "made     %{step.name}"
  | Already -> "already  %{step.name}"
  | Set -> "set      %{step.name}"
  | Failed code -> "FAILED   %{step.name} (exit %{code})"

-- The effectful edge: the command for each step.
let run which =
  match which with
  | "package" -> package ()
  | "user" -> by_code 9 $?(useradd -r deploy).code
  | "key" -> told $?(chmod 0600 /home/deploy/.ssh/id_ed25519).code
  | _ -> told $?(ln -sfn /opt/app/nginx.conf /etc/nginx/conf.d/app.conf).code

-- One step at a time, through `run_step`, and none after one that failed:
-- the key's mode is not set for a user that could not be made. The runner
-- is an argument so the order can be tested without touching a host.
let apply run_step =
  let go [] done = List.reverse done
  let go [(step, which) :: rest] done =
    let o = run_step which;
    let done = (step, o) :: done;
    if failed? o then List.reverse done else go rest done;
  go steps []

-- The steps run in `main`: `test/wand/test_ports.wand` imports this file,
-- and an import runs a file's bindings but not its bare expressions, so
-- importing it provisions nothing.
let main () = (
  let results = apply run;
  results |> List.each (fn (step, o) -> IO.println (line step o));
  match List.filter (fn (_, o) -> failed? o) results with
  | [] -> IO.println (if changed? results then "host changed" else "host as declared")
  | _ -> (IO.println_err "a step failed, and the steps after it were not run"; Proc.exit 1)
)

main ()
