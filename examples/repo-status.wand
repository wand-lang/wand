uses {IO, Shell(echo, git)}

import Decode
import IO
import List
import Result

-- git prints a count on a line of its own. A repo with no upstream prints
-- nothing at all, so a count that cannot be read is zero rather than a
-- failure.
let count out = Result.default 0 (Decode.run Decode.int out)

-- One entry per line. An empty capture is no entries -- not one empty
-- entry, which is the mistake a line count invites.
let entries out = Result.default [] (Decode.lines Decode.string out)

let branch = $(git branch --show-current)
let dirty = List.length (entries $(git status --porcelain))
let ahead = count $(git rev-list --count @{upstream}..HEAD 2>/dev/null || echo 0)
let behind = count $(git rev-list --count HEAD..@{upstream} 2>/dev/null || echo 0)
let last = $(git log -1 --format='%h %s')
let stashes = List.length (entries $(git stash list))

let status_msg = if dirty > 0 then "%{dirty} file(s) changed" else "clean"

let sync_msg =
  if ahead > 0 || behind > 0 then "^%{ahead} ahead  v%{behind} behind" else "up to date"

IO.println "Branch:  %{branch}"
IO.println "Status:  %{status_msg}"
IO.println "Sync:    %{sync_msg}"
if stashes > 0 then IO.println "Stashes: %{stashes} saved"
IO.println "Last:    %{last}"
