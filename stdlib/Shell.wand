uses {Clock, Shell}

import Resource

-- Reading what a command wrote.
--
-- A command's output has no types of its own -- it is text, and the shape
-- is whatever the command decided. These two run a decoder over it, so the
-- reading is done in one place with a message that says what was wrong,
-- rather than by a chain of scrapes that each assume the last one worked.
--
--     let ahead = Shell.decode Decode.int $(git rev-list --count HEAD)
--
-- `Decode.int` reads the digits, because a decoder reads a value out of
-- text. See `Decode`.

-- Whether a command succeeded: its exit code is zero.
--
-- `$?(cmd)` gives a `ShellResult`, and the first thing a script asks of
-- one is whether it worked. That question is `r.code == 0`, which every
-- caller was writing out.
--
-- >> Shell.ok? $?(true)
-- true : Bool
let ok? (r: ShellResult) = r.code == 0

-- Whether a command failed: its exit code is not zero.
--
-- The same question as `ok?` asked the other way, because half the time
-- that is the branch a script is written around. `!` negates a Bool, but
-- not a predicate waiting for its argument -- `!(Shell.ok? r)` needs the
-- brackets, and `List.filter Shell.failed?` needs nothing.
--
-- >> Shell.failed? $?(exit 3)
-- true : Bool
let failed? (r: ShellResult) = r.code != 0

-- Read the whole capture as one value, ignoring surrounding whitespace.
--
-- >> Shell.decode Decode.int $?(echo 42).stdout
-- Ok(42) : Result String Int
let decode d out = shell_decode d out

-- Read one value per line. `$()` strips the trailing newline, so a capture
-- with nothing in it is no lines rather than one empty line.
--
-- >> Shell.lines Decode.int "1\n2"
-- Ok([1, 2]) : Result String (List Int)
let lines d out = shell_lines d out

-- Run `thunk` with a deadline on each command it runs. A command that has
-- not finished in `d` is sent SIGTERM, and SIGKILL five seconds later.
--
-- The result is `Error` only when a command ran out of time; the message
-- names the command and the deadline. Any other failure passes through, so
-- a command that exits non-zero raises as it always does.
--
-- The deadline is per command, not for the whole thunk: a thunk that runs
-- three commands may take three deadlines.
--
-- >> Shell.timeout 5s (fn () -> 1 + 1)
-- Ok(2) : Result String Int
let timeout d thunk = shell_timeout d thunk

-- Run a command and give back what it wrote, with the surrounding
-- whitespace trimmed. Raises if it exits non-zero.
--
-- This is what `$(cmd)` is: `$(git status)` is `Shell.run! $*(git status)`,
-- spelled short. The long form is for a command that was built somewhere
-- else -- named, passed in, or picked out of a list -- which the short form
-- cannot express, since its command is its text.
--
-- >> Shell.run! $*(echo hi)
-- "hi" : String
let run! (c: Command) = shell_run c

-- Run a command, giving back an `Error` where `run!` raises.
--
-- >> Shell.run $*(exit 3)
-- Error("command exited with code 3: exit 3") : Result String String
let run (c: Command) = try run! c

-- Run a command that only reads, and give back what it wrote, trimmed.
-- Raises if it exits non-zero.
--
-- Use it only for a command that changes nothing: a query, a listing, a
-- status. A rehearsal runs it for real. For anything that writes, creates,
-- deletes or sends, use `$(...)` or `Shell.run!`, which a rehearsal
-- withholds.
--
-- It is `run!`, with that one difference. `--dry-run` withholds every other
-- command, since wand cannot see what a subprocess does, so a script that
-- asks the world a question before it decides what to change got "" back
-- and took a path a real run never would. The name is the script's promise
-- that the command changes nothing; wand takes its word, and the rehearsal
-- reports `ran (inspect): ...`. A command known to change things, such as
-- `kubectl apply` or `rm`, is a V-SHELL3 violation here.
--
-- >> Shell.inspect! $*(echo hi)
-- "hi" : String
let inspect! (c: Command) = shell_inspect c

-- Run a command that only reads, giving back an `Error` where `inspect!`
-- raises. Use it only for a command that changes nothing, as `inspect!`
-- says: a rehearsal runs it for real.
--
-- >> Shell.inspect $*(exit 3)
-- Error("command exited with code 3: exit 3") : Result String String
let inspect (c: Command) = try inspect! c

-- `inspect!`, with `input` written to the command's stdin, as
-- `input |> $(cmd)` writes it. Use it for a command that reads what it is
-- given and changes nothing, such as a server-side dry run:
-- `json |> Shell.inspect_with! $*(kubectl apply --dry-run=server -f -)`.
--
-- >> "looked" |> Shell.inspect_with! $*(cat)
-- "looked" : String
let inspect_with! (c: Command) (input: String) = shell_inspect_with c input

-- `inspect_with!`, giving an `Error` where it raises.
--
-- >> "x" |> Shell.inspect_with $*(false)
-- Error("command exited with code 1: false") : Result String String
let inspect_with (c: Command) (input: String) = try inspect_with! c input

-- The same command, to run in the directory `dir`. It runs nothing: give
-- the result to `run!`, `inspect!`, `query`, `stream`, `spawn` or any other
-- function that takes a `Command`.
--
-- Only this command runs in `dir`. The script and its other commands stay
-- where they are. A relative `dir` is read from the script's directory.
-- On a command that has a directory already, a relative `dir` is read from
-- that directory, as a second `cd` is.
-- A `dir` that is not a directory raises when the command runs.
--
-- The manifest names the command's own words, not a shell, so this is the
-- way to write `sh -c 'cd dir && cmd'`.
--
-- >> Shell.inspect! (Shell.in_dir /usr $*(pwd))
-- "/usr" : String
let in_dir (dir: Path) (c: Command) = shell_in_dir dir c

-- Run a command and report how it went instead of raising: a `ShellResult`
-- with its output, its error output and its exit code.
--
-- This is what `$?(cmd)` is, over a command built elsewhere.
--
-- >> Shell.query $*(exit 3) |> Shell.failed?
-- true : Bool
let query (c: Command) = shell_query c

-- Read a command's output as it arrives, one line at a time.
--
-- `$()` reads to the end before it answers, so a command that watches
-- rather than reports -- `tail -f`, `kubectl logs -f`, `journalctl -f` --
-- accumulates forever and never returns. A stream pulls one line at a
-- time, so the memory is one line, and `Stream.take` stops pulling:
--
--     Shell.stream $*(tail -f /var/log/app.log)
--     |> Stream.filter (fn l -> String.contains? "ERROR" l)
--     |> Stream.take 10
--     |> Stream.to_list
--
-- Four things to know.
--
-- **Stopping the read stops the command.** It is sent SIGTERM, and SIGKILL
-- five seconds later. wand signals the command it started and nothing
-- below it, so `sh -c "tail -f x"` leaves the `tail` behind.
--
-- **An early stop is not a failure.** A stream read to the end raises on a
-- non-zero exit, as `$()` does. One that stopped early -- a satisfied
-- `take` -- ignores the exit code, because the command ended when wand
-- ended it.
--
-- **Lines may arrive in gulps.** Many commands write in 4KB blocks when
-- their output is a pipe rather than a terminal, `grep` among them. Ask
-- for line buffering where the command has a flag for it
-- (`grep --line-buffered`), or wrap it: `$*(stdbuf -oL some-command)`.
--
-- **Folding twice runs the command twice.** A stream is a description, as
-- it is for a file. Re-reading a file is cheap and repeatable; re-running
-- a command is neither.
--
-- `Shell.timeout` does not bound a stream: its deadline is on a command
-- that runs to completion. `Stream.take` is the bound that fits this shape.
--
-- A stream with no `take` over a command that never ends never finishes.
-- That is `while true` written another way, and no type says so.
--
-- >> Shell.stream $*(printf "a\nb\n") |> Stream.to_list
-- ["a", "b"] : List String
let stream (c: Command) = shell_stream c

-- A command's stderr, one line at a time, as `stream` reads its stdout.
-- The command's stdout goes to wand's own.
--
-- >> Shell.stream_err $*(sh -c "echo out; echo err >&2") |> Stream.to_list
-- out
-- ["err"] : List String
let stream_err (c: Command) = shell_stream_err c

-- Start `c` and keep it running for the length of a `with`, to write to
-- its stdin and read its stdout and stderr as it goes: a REPL, a language
-- server, a worker that takes jobs on stdin.
--
-- with Shell.spawn $*(python3 -i -q) as py -> (
--   Shell.write! "print(6 * 7)\n" py;
--   Shell.read_line py
-- )
--
-- A read or a write waits in its own fiber, so a timeout is `Par.timeout`
-- around a read, and a child written to and read from at once is two
-- branches of `Par.all!`. `close` ends it and answers its exit code; the
-- `with` stops one that was not closed: stdin closed, then SIGTERM, then
-- SIGKILL after five seconds.
--
-- >> with Shell.spawn $*(cat) as p -> (Shell.write! "hi\n" p; Shell.read_line p)
-- Some("hi") : Option String
let spawn (c: Command) = Resource.make (fn () -> shell_spawn c) (fn p -> shell_stop p)

-- The next line `p` wrote to stdout, without its line ending, or `None`
-- once its stdout has ended.
--
-- >> with Shell.spawn $*(printf "a\nb\n") as p -> Shell.read_line p
-- Some("a") : Option String
let read_line (p: Process) = shell_read_line p

-- Up to `n` bytes of what `p` wrote to stdout, waiting for some if none
-- has arrived; `""` once its stdout has ended. For a protocol framed by
-- length rather than by line.
--
-- >> with Shell.spawn $*(printf "abcdef") as p -> Shell.read 3 p
-- "abc" : String
let read n (p: Process) = shell_read p n

-- The next line `p` wrote to stderr, or `None` once its stderr has ended.
--
-- >> with Shell.spawn $*(sh -c "echo oops >&2") as p -> Shell.read_err_line p
-- Some("oops") : Option String
let read_err_line (p: Process) = shell_read_err_line p

-- Up to `n` bytes of what `p` wrote to stderr.
--
-- >> with Shell.spawn $*(sh -c "printf warning >&2") as p -> Shell.read_err 4 p
-- "warn" : String
let read_err n (p: Process) = shell_read_err p n

-- Write `text` to `p`'s stdin, exactly as given: add the "\n" a line
-- needs. `Error` says why it could not go, most often that `p` has stopped
-- reading.
--
-- >> with Shell.spawn $*(cat) as p -> Shell.write "hi\n" p
-- Ok(()) : Result String Unit
let write text (p: Process) = shell_write p text

-- `write`, raising if the text cannot go.
--
-- >> with Shell.spawn $*(cat) as p -> (Shell.write! "hi\n" p; Shell.read_line p)
-- Some("hi") : Option String
let write! text (p: Process) =
  match write text p with
  | Ok _ -> ()
  | Error why -> fail_exn why

-- Close `p`'s stdin, wait for it to end, and answer how it ended: its exit
-- code, and the stdout and stderr nothing has read.
--
-- >> with Shell.spawn $*(sh -c "cat; exit 3") as p ->
-- ..   (Shell.write! "left\n" p; Shell.close p)
-- ShellResult("left\n", "", 3) : ShellResult
let close (p: Process) = shell_close p
