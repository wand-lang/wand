uses {Clock, FS.Read, FS.Write}

import Glob
import Path
import Resource

-- Every operation that touches the filesystem can fail for a reason the OS
-- can state, so each one comes as a pair: the plain name returns a Result
-- carrying that reason, and the `!` sibling raises instead. The `!` versions
-- wrap the raising builtins directly; the Result versions are `try` over
-- them, so there is one implementation of each operation.

-- Read the entire contents of a file as a string. Raises if unreadable.
--
-- Every example here works inside a temp directory, because a read needs
-- something to read and a `with` is what takes it away again.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi"; FS.read_file! f)
-- "hi" : String
let read_file! path = read_file path

-- Read the entire contents of a file as a string.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.exists? (Path.join d ./missing)
-- false : Bool
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (match FS.read_file (Path.join d ./missing) with
-- ..    | Ok _ -> "read" | Error _ -> "not there")
-- "not there" : String
let read_file path = try read_file! path

-- Write a string to a file, replacing existing contents. Raises on failure.
--
-- Replaces what is there, and makes the file if it is not.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "one"; FS.write_file! f "two";
-- ..    FS.read_file! f)
-- "two" : String
let write_file! path s = write_file path s

-- Write a string to a file, replacing existing contents.
--
-- The Result carries the reason the OS gave; the `!` sibling raises it.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.write_file (Path.join d ./x) "hi"
-- Ok(()) : Result String Unit
let write_file path s = try write_file! path s

-- Publish a string to a file so no reader sees it half-written. Raises on failure.
--
-- The content is written to a temporary file beside the target and renamed
-- over it, so another process reading the path gets the old contents or the
-- new ones and never a partial file. `FS.write_file` truncates and fills,
-- which leaves a window where the file is short.
--
-- What the temporary file being *beside* the target buys is the rename: a
-- rename cannot cross a filesystem, and the OS temp directory is often a
-- different one, so the hand-written version of this passes where it was
-- written and fails on a Linux box where /tmp is tmpfs.
--
-- An existing target keeps the mode it had. A new file gets 0644 through the
-- umask, as `FS.write_file` does. A symlink is written through rather than
-- replaced, also as `FS.write_file` does.
--
-- The temporary file is synced before the rename, so a published file is
-- whole. The directory is not, so after a power loss the publication itself
-- may be missing -- what this promises is that a reader never sees half a
-- file, not that the write survives the machine going down.
--
-- Reading the target's mode and resolving a symlink are both stats, which is
-- why this declares `FS.Read` as well as `FS.Write`.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_atomic! f "one";
-- ..    FS.write_atomic! f "two"; FS.read_file! f)
-- "two" : String
let write_atomic! path s = write_atomic path s

-- Publish a string to a file so no reader sees it half-written.
--
-- The Result carries the reason the OS gave; the `!` sibling raises it.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.write_atomic (Path.join d ./x) "hi"
-- Ok(()) : Result String Unit
let write_atomic path s = try write_atomic! path s

-- Append a string to a file, creating it if it does not exist. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi"; FS.append! f "!";
-- ..    FS.read_file! f)
-- "hi!" : String
let append! path s = fs_append path s

-- Append a string to a file, creating it if it does not exist.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.append (Path.join d ./x) "hi"
-- Ok(()) : Result String Unit
let append path s = try append! path s

-- Create an empty file at the given path. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.create_file! f; FS.size! f)
-- 0B : Size
let create_file! path = fs_create path

-- Create an empty file at the given path.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.create_file (Path.join d ./x)
-- Ok(()) : Result String Unit
let create_file path = try create_file! path

-- Return true if the path exists.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.exists? d
-- true : Bool
let exists? path = fs_exists path

-- Return true if the path is a regular file.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.file? d
-- false : Bool
let file? path = fs_is_file path

-- Return true if the path is a directory.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.dir? d
-- true : Bool
let dir? path = fs_is_dir path

-- Create a directory and all missing parents. Raises on failure.
--
-- Missing parents are made too, so one call is enough.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.mkdir! (Path.join d ./a/b); FS.dir? (Path.join d ./a/b))
-- true : Bool
let mkdir! path = fs_mkdir path

-- Create a directory and all missing parents.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.mkdir (Path.join d ./a)
-- Ok(()) : Result String Unit
let mkdir path = try mkdir! path

-- Delete a file or empty directory. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi"; FS.delete! f; FS.exists? f)
-- false : Bool
let delete! path = fs_remove path

-- Delete a file or empty directory.
--
-- Deleting what is not there is the Error, not a quiet success:
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (match FS.delete (Path.join d ./missing) with
-- ..    | Ok _ -> "gone" | Error _ -> "was not there")
-- "was not there" : String
let delete path = try delete! path

-- A new, uniquely-named empty file in the OS temp directory, removed when
-- the `with` that holds it ends. `prefix`/`suffix` are added to the
-- generated name:
--
-- with FS.temp_file "wand_" ".txt" as p ->
-- ...
--
-- Release tolerates the file already being gone, so a body may rename it
-- into place -- the way an atomic write publishes its result -- without
-- the cleanup failing on the way out.
--
-- >> with FS.temp_file "ex_" ".txt" as p ->
-- ..   (FS.write_file! p "hi"; FS.read_file! p)
-- "hi" : String
let temp_file prefix suffix =
  let acquire = fn () -> fs_temp_file prefix suffix;
  let release = fn p -> if exists? p then delete! p;
  Resource.make acquire release

-- A new, uniquely-named empty directory in the OS temp directory, removed
-- with everything in it when the `with` that holds it ends:
--
-- with FS.temp_dir "build_" as dir ->
-- ...
--
-- The body may leave files behind -- that is what a scratch directory is
-- for -- and release takes the tree with it. As with `temp_file`, release
-- tolerates the directory already being gone.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.dir? d
-- true : Bool
let temp_dir prefix =
  let acquire = fn () -> fs_temp_dir prefix;
  let release = fn p -> if exists? p then fs_delete_tree p;
  Resource.make acquire release

-- Why an acquire did not get the lock.
--
-- `Held` is another run: the guard did its job, and a cron job that should
-- stand down when the last one is still going exits 0 on this. `Denied`
-- carries what the OS said about a lock that could not be asked for at all
-- -- no such directory, no permission -- which is a broken script rather
-- than a busy one, and exits 1.
--
-- Telling them apart is the whole reason the acquire answers a `Result`
-- rather than raising both as text.
type LockError = Held | Denied String

-- Take a lock on `path` for as long as the `with` holds it. Answers why not
-- rather than raising.
--
-- The lock a cron job wants: one run at a time, and the guard released when
-- the process dies rather than left behind for the next run to reason about.
-- It is the operating system's lock on an open file, so nothing here holds a
-- pid, nothing goes stale, and there is no policy for breaking one.
--
-- The acquire does not wait. Either the lock is free now, or somebody else
-- has it and the answer is `Error Held`:
--
-- with FS.lock /var/run/deploy.lock as taken ->
--   match taken with
--   | Ok _ -> deploy ()
--   | Error FS.Held -> IO.println "a deploy is already running"
--   | Error FS.Denied why -> Proc.die "cannot lock: %{why}"
--
-- It guards against other runs of the script, and against other `Par`
-- workers in this one: a second acquire on the same file answers `Held`
-- whichever it is. The lock belongs to the open file and not to the
-- process, so a worker is told exactly what another process is told. That
-- includes this script's own -- a lock is not re-entrant, so a
-- `with FS.lock` inside another on the same path is `Held`.
--
-- The guard is only as good as the filesystem holding the lock file. On a
-- local filesystem it is exact. On NFS the lock is emulated and is not
-- dependable, so a lock file shared between machines guards less than it
-- appears to -- keep it on the machine that runs the job.
--
-- The lock file is created if it is missing and is never deleted, which
-- looks like a leak and is not. Deleting it is the race the lock exists to
-- prevent: another process can be holding the same name open, and after the
-- delete the two hold locks on two files. The empty file left behind costs
-- nothing.
--
-- A rehearsal takes the lock for real. Withholding it would let a `--dry-run`
-- run beside a real one, which is the situation being guarded against; the
-- change it makes to the world is an empty file.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (with FS.lock (Path.join d ./l) as taken -> Result.ok? taken)
-- true : Bool
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let p = Path.join d ./l;
-- ..    with FS.lock p as _ -> with FS.lock p as again -> again)
-- Error(Held) : Result LockError Path
let lock path =
  let acquire =
    fn () -> match try fs_lock path with
      | Ok (Some taken) -> Ok taken
      | Ok None -> Error Held
      | Error why -> Error (Denied why)
  in
  let release =
    fn taken -> match taken with
      | Ok taken -> fs_unlock taken
      | Error _ -> ()
  in
  Resource.make acquire release

-- Take a lock on `path`, waiting up to `budget` for it. Answers why not
-- rather than raising.
--
-- `FS.lock` for a script that would rather queue than stand down -- a deploy
-- behind another deploy, where the second one still has to happen:
--
-- with FS.lock_wait 5min /var/run/deploy.lock as taken ->
--   match taken with
--   | Ok _ -> deploy ()
--   | Error FS.Held -> IO.println "gave up waiting"
--   | Error FS.Denied why -> Proc.die "cannot lock: %{why}"
--
-- A budget that runs out is `Error Held`. Waiting and being told no is the
-- same answer as being told no at once: somebody else has it, and this run
-- is not going to get it.
--
-- `Denied` ends the wait immediately. A directory that is not there will not
-- appear because the poll continued, and a broken script should not spend
-- the budget finding that out.
--
-- The wait is a poll, so the lock is taken within a moment of being freed
-- rather than the instant it is freed. It carries `Clock`, because it
-- sleeps -- which is what makes a script that waits say so in its manifest
-- and one that does not, not.
--
-- A wait on a lock this same `with` already holds answers `Held` at once
-- rather than after the budget. Nothing is going to release it.
--
-- A rehearsal takes the lock and does not wait, and says so in the line it
-- reports. Waiting out a real budget would make `--dry-run` useless on the
-- scripts that need it most.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (with FS.lock_wait 1s (Path.join d ./l) as taken -> Result.ok? taken)
-- true : Bool
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let p = Path.join d ./l;
-- ..    with FS.lock p as _ -> with FS.lock_wait 50ms p as again -> again)
-- Error(Held) : Result LockError Path
let lock_wait budget path =
  let acquire =
    fn () -> match try fs_lock_wait budget path with
      | Ok (Some taken) -> Ok taken
      | Ok None -> Error Held
      | Error why -> Error (Denied why)
  in
  let release =
    fn taken -> match taken with
      | Ok taken -> fs_unlock taken
      | Error _ -> ()
  in
  Resource.make acquire release

-- Take a lock on `path`, waiting up to `budget` for it. Raises if it cannot
-- be taken.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (with FS.lock_wait! 1s (Path.join d ./l) as taken -> Path.extension taken)
-- "" : String
let lock_wait! budget path =
  let acquire =
    fn () -> match fs_lock_wait budget path with
      | Some taken -> taken
      | None -> fail_exn "lock: %{path} is held by another process"
  in
  let release = fn taken -> fs_unlock taken;
  Resource.make acquire release

-- Take a lock on `path` for as long as the `with` holds it. Raises if it
-- cannot be taken.
--
-- For a script that has nothing to say about either failure and should stop:
--
-- with FS.lock! /var/run/deploy.lock as _ ->
--   deploy ()
--
-- `FS.lock` is the one to reach for when "somebody else is running" and
-- "this lock file cannot be opened" call for different exit codes, since
-- both arrive here as a raise.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (with FS.lock! (Path.join d ./l) as taken -> Path.extension taken)
-- "" : String
let lock! path =
  let acquire =
    fn () -> match fs_lock path with
      | Some taken -> taken
      | None -> fail_exn "lock: %{path} is held by another process"
  in
  let release = fn taken -> fs_unlock taken;
  Resource.make acquire release

-- Delete a directory and everything under it. Raises on failure.
--
-- Depth first. A symlink inside the tree is unlinked, never descended
-- into, so the tree is the only thing that goes.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.mkdir! (Path.join d ./a/b); FS.delete_tree! (Path.join d ./a);
-- ..    FS.exists? (Path.join d ./a))
-- false : Bool
let delete_tree! path = fs_delete_tree path

-- Delete a directory and everything under it.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.mkdir! (Path.join d ./a); FS.delete_tree (Path.join d ./a))
-- Ok(()) : Result String Unit
let delete_tree path = try delete_tree! path

-- Copy a directory and everything under it. Raises on failure.
--
-- A file keeps the mode it had, and a symlink is recreated as a symlink
-- rather than followed.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.mkdir! (Path.join d ./a); FS.write_file! (Path.join d ./a/x) "hi";
-- ..    FS.copy_tree! (Path.join d ./a) (Path.join d ./b);
-- ..    FS.read_file! (Path.join d ./b/x))
-- "hi" : String
let copy_tree! src dst = fs_copy_tree src dst

-- Copy a directory and everything under it.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.mkdir! (Path.join d ./a);
-- ..    FS.copy_tree (Path.join d ./a) (Path.join d ./b))
-- Ok(()) : Result String Unit
let copy_tree src dst = try copy_tree! src dst

-- Rename or move a file or directory. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi";
-- ..    FS.rename! f (Path.join d ./y); FS.exists? f)
-- false : Bool
let rename! src dst = fs_rename src dst

-- Rename or move a file or directory.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi";
-- ..    FS.rename f (Path.join d ./y))
-- Ok(()) : Result String Unit
let rename src dst = try rename! src dst

-- Copy a file to a new path. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi";
-- ..    FS.copy! f (Path.join d ./y); FS.read_file! (Path.join d ./y))
-- "hi" : String
let copy! src dst = fs_copy src dst

-- Copy a file to a new path.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi";
-- ..    FS.copy f (Path.join d ./y))
-- Ok(()) : Result String Unit
let copy src dst = try copy! src dst

-- Return a list of paths for the immediate children of a directory. Raises on failure.
--
-- The paths come back whole, not as bare names.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.write_file! (Path.join d ./a) "x";
-- ..    List.map Path.basename (FS.list_dir! d))
-- [a] : List Path
let list_dir! path = fs_ls path

-- Return a list of paths for the immediate children of a directory.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.list_dir d
-- Ok([]) : Result String (List Path)
let list_dir path = try list_dir! path

-- Return the last-modified time of a file as a DateTime. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi";
-- ..    Clock.now () - FS.mtime! f < 1min)
-- true : Bool
let mtime! path = fs_mtime path

-- Return the last-modified time of a file as a DateTime.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (match FS.mtime (Path.join d ./missing) with
-- ..    | Ok _ -> "read" | Error _ -> "not there")
-- "not there" : String
let mtime path = try mtime! path

-- Return the size of a file. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi"; FS.size! f)
-- 2B : Size
let size! path = fs_size path

-- Return the size of a file.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "hi"; FS.size f)
-- Ok(2B) : Result String Size
let size path = try size! path

-- Return the current working directory.
--
-- >> Path.absolute? (FS.cwd ())
-- true : Bool
let cwd () = fs_cwd ()

-- The files matching a pattern, searched from the working directory.
--
-- An absolute pattern is searched from its own directory instead, because
-- the pattern is then the only thing saying where to look. `glob_in` takes
-- the directory as an argument.
--
-- Files only: a directory whose name fits is not in the answer.
-- `FS.list_dir` reads a directory's entries, subdirectories included.
--
-- >> List.length (FS.glob *.wand) >= 0
-- true : Bool
let glob pattern =
  let base = Glob.base pattern;
  fs_glob pattern (if Path.absolute? base then base else fs_cwd ())

-- The files under `dir` that the pattern matches.
--
-- The walk always starts at `dir`. An absolute pattern matches a file's
-- whole path, so it answers only where `dir` holds the files it names.
--
-- Files only: a directory whose name fits is not in the answer, so `./*`
-- in a directory of nothing but subdirectories answers `[]`.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.write_file! (Path.join d ./a.wand) "x";
-- ..    List.length (FS.glob_in *.wand d))
-- 1 : Int
let glob_in pattern dir = fs_glob pattern dir

-- A stream of the file's lines -- nothing is read until a terminal
-- operation runs it, which is also where a missing file raises. See
-- Stream.
--
-- Nothing is read until a terminal operation runs the stream.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "a\nb";
-- ..    FS.stream_lines f |> Stream.fold_left (fn n _ -> n + 1) 0)
-- 2 : Int
let stream_lines p = fs_stream_lines p

-- A stream of several files' lines, read as one. Each file is opened when
-- the one before it runs out, so this holds one file open at a time
-- however many are named.
--
-- `FS.glob *.log |> FS.stream_lines_all` is the case this exists for: a
-- day of logs is one stream, not a list of streams.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let a = Path.join d ./a; let b = Path.join d ./b;
-- ..    FS.write_file! a "1\n2"; FS.write_file! b "3";
-- ..    FS.stream_lines_all [a, b] |> Stream.to_list)
-- ["1", "2", "3"] : List String
let stream_lines_all ps = fs_stream_lines_all ps

-- Write a stream's elements to a file, one per line, replacing what is
-- there. Raises on failure.
--
-- `FS.stream_lines` reads and this writes, so a filtered log is a read and
-- a write rather than one `FS.append!` per line -- the file is opened once
-- and the lines arrive as the stream produces them.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x;
-- ..    FS.write_lines! f (Stream.of_list ["a", "b"]); FS.read_file! f)
-- "a\nb\n" : String
let write_lines! path s = fs_write_lines path s

-- Write a stream's elements to a file, one per line, replacing what is
-- there.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.write_lines (Path.join d ./x) (Stream.of_list ["a"])
-- Ok(()) : Result String Unit
let write_lines path s = try write_lines! path s

-- Publish a stream's elements to a file, one per line, so no reader sees it
-- half-written. Raises on failure.
--
-- `FS.write_atomic` for a stream: the lines go to a temporary file beside
-- the target and it is renamed over the target when the stream ends, so
-- another process reading the path gets the whole of the old contents or
-- the whole of the new ones. Everything `FS.write_atomic` says about the
-- filesystem, the mode and a symlink holds here.
--
-- The difference is the ending. `FS.write_lines` writes straight into the
-- target, so a stream that fails part way through leaves a file missing its
-- tail. This one publishes only a stream that finished: if the source fails
-- or a stage raises, the temporary file goes and the target still holds
-- what it held.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x;
-- ..    FS.write_lines_atomic! f (Stream.of_list ["a", "b"]); FS.read_file! f)
-- "a\nb\n" : String
let write_lines_atomic! path s = fs_write_lines_atomic path s

-- Publish a stream's elements to a file, one per line, so no reader sees it
-- half-written.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.write_lines_atomic (Path.join d ./x) (Stream.of_list ["a"])
-- Ok(()) : Result String Unit
let write_lines_atomic path s = try write_lines_atomic! path s

-- Add a stream's elements to the end of a file, one per line. Makes the
-- file if it is not there. Raises on failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x; FS.write_file! f "a\n";
-- ..    FS.append_lines! f (Stream.of_list ["b"]); FS.read_file! f)
-- "a\nb\n" : String
let append_lines! path s = fs_append_lines path s

-- Add a stream's elements to the end of a file, one per line.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   FS.append_lines (Path.join d ./x) (Stream.of_list ["a"])
-- Ok(()) : Result String Unit
let append_lines path s = try append_lines! path s
