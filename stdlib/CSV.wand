uses {FS.Read}

import Result

-- Parse a CSV string with the default comma separator: a list of rows,
-- each row a list of field strings, or an Error saying why the text is not
-- CSV -- a quoted field that is never closed.
--
-- A cell is text, whatever it looks like: reading `1` as a number is the
-- caller's to do, or `rows` and a decoder.
--
-- >> CSV.parse "a,b\n1,2"
-- Ok([["a", "b"], ["1", "2"]]) : Result String (List (List String))
--
-- >> CSV.parse "a,\"b"
-- Error("a quoted field is not closed: every opening \" needs a closing one") : Result String (List (List String))
let parse src = csv_parse "," src

-- The same as `CSV.parse`, raising the reason instead of answering with it.
--
-- >> CSV.parse! "a,b"
-- [["a", "b"]] : List (List String)
let parse! src = Result.get! (parse src)

-- Parse a CSV string with a custom separator, which is one character.
--
-- >> CSV.parse_with ";" "a;b"
-- Ok([["a", "b"]]) : Result String (List (List String))
let parse_with sep src = csv_parse sep src

-- The same as `CSV.parse_with`, raising the reason instead of answering
-- with it.
--
-- >> CSV.parse_with! ";" "a;b"
-- [["a", "b"]] : List (List String)
let parse_with! sep src = Result.get! (parse_with sep src)

-- Write rows as CSV. A cell is text, and every value has a text form, so
-- a row of numbers or domain values needs no conversion first.
--
-- >> CSV.stringify [["a", "b"], ["1", "2"]]
-- "a,b\n1,2" : String
--
-- A row of numbers needs no conversion first:
--
-- >> CSV.stringify [[1, 2], [3, 4]]
-- "1,2\n3,4" : String
let stringify rows = csv_stringify "," rows

-- Serialise a list of rows with a custom separator.
--
-- >> CSV.stringify_with ";" [["a", "b"]]
-- "a;b" : String
let stringify_with sep rows = csv_stringify sep rows

-- Read and parse a CSV file, raising on error. Reading is the same
-- `FS!read_file` every other reader performs, so this is `FS.Read` like
-- any other read: a handler mocking the filesystem stands in for it, and
-- `--dry-run` sees it.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./c.csv; FS.write_file! f "a,b"; CSV.read_file! f)
-- [["a", "b"]] : List (List String)
let read_file! path = parse! (read_file path)

-- Read and parse a CSV file.  Returns Ok rows or Error message.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (match CSV.read_file (Path.join d ./missing.csv) with
-- ..    | Ok _ -> "read" | Error _ -> "not there")
-- "not there" : String
let read_file path = try read_file! path

-- Read one value per row, by column name: the first row names the columns,
-- so a row is read by field like any other record. A file without a header
-- row is what `parse` is for. See `Decode`.
--
-- The first row names the columns, so each row after it is read by field.
--
-- >> CSV.rows (Decode.field "name" Decode.string) "name\nalice"
-- Ok(["alice"]) : Result String (List String)
let rows d src = csv_rows d src
