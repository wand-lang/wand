uses {Clock, FS.Read, FS.Write, Net, Net.Listen}

import FS
import List
import Map
import Net
import Par
import Result
import Shell
import Size
import String
import URL

-- Reaching a host over HTTP.
--
-- One primitive underneath, so a double that stands in for `Net!http`
-- covers every function here. What a call answers is an `HTTPResponse`
-- whatever the server said: a 404 is not an `Error`, because the exchange
-- succeeded and the server said no. `Error` is for the transport failing --
-- a name that does not resolve, a connection refused, a timeout -- which is
-- the line `$()` and `$?()` already draw.
--
-- Where the bytes may go is the manifest's business. `uses {Net}` admits
-- any host; `uses {Net(api.github.com)}` admits one. A request is checked
-- against the manifest of the file that built it, and so is every redirect
-- it follows.
--
-- `HTTPRequest`, `HTTPResponse` and `HTTPMethod` are built in, so the types
-- need no import and no module prefix. `HTTP.Request`, `HTTP.Response` and
-- `HTTP.Method` are those three under the names a reader would reach for
-- first. They are aliases, so the two spellings are one type: a value built
-- one way annotates, matches and passes the other.
--
-- A method is written with its module -- `HTTP.GET`, `HTTP.POST` -- because
-- those are HTTP's words rather than the language's. Bare `POST` names
-- nothing.
--
-- The transport runs `curl`. wand has no TLS of its own yet, so bytes reach
-- a host through a subprocess, and that subprocess is not bounded by a
-- narrowed `Shell`: `Shell(git)` means only `git` runs from this script,
-- not that only `git` runs. `--trace` reports the request. Moving TLS
-- in-process later changes no script, because the manifest is checked on
-- the URL either way.

type Method = HTTPMethod
type Request = HTTPRequest
type Response = HTTPResponse

-- True when the status is a 2xx. `Shell.ok?` for a status code.
--
-- >> HTTP.ok? HTTP.Response(status = 204, headers = {}, body = "")
-- true : Bool
let ok? (r: Response) = r.status >= 200 && r.status < 300

-- One header of a response, by name, matched without regard to case --
-- which is how the wire treats it, and why the names come back lowercased.
--
-- >> HTTP.header "Accept" HTTP.Response(status = 200, headers = {accept = "text/plain"}, body = "")
-- Some("text/plain") : Option String
let header name (r: Response) = Map.get (String.lower name) r.headers

-- Send a request. Raises if the exchange did not happen.
--
-- >> Test.with_http [] (fn () ->
-- ..   (HTTP.request! HTTP.Request(url = https://example.com/)).status)
-- 200 : Int
let request! req = net_http req

-- Send a request, reporting a transport failure rather than raising.
--
-- >> Test.with_http [] (fn () ->
-- ..   Result.ok? (HTTP.request HTTP.Request(url = https://example.com/)))
-- true : Bool
let request req = try request! req

-- Fetch a URL. A status the server answered with is on the response, so a
-- 404 is `Ok` -- the exchange happened. `Error` is the transport failing.
-- The raising sibling draws the line one step further in: `get!` raises on
-- a status outside 2xx as well.
--
-- >> Test.with_http [] (fn () -> Result.ok? (HTTP.get https://example.com/))
-- true : Bool
let get url = request Request(url = url)

-- Fetch a URL, raising on a transport failure or on a status outside 2xx.
--
-- >> Test.with_http [] (fn () -> (HTTP.get! https://example.com/).status)
-- 200 : Int
let get! url =
  let r = request! Request(url = url);
  if ok? r then r else fail_exn "http: %{url} answered %{r.status}"

-- Send a body to a URL. Raises if the exchange did not happen; a status the
-- caller has to read is on the response.
--
-- >> Test.with_http [] (fn () ->
-- ..   (HTTP.post! https://example.com/ "{}").status)
-- 200 : Int
let post! url body = request! Request(url = url, method = POST, body = body)

-- Send a body to a URL, reporting a transport failure rather than raising.
--
-- >> Test.with_http [] (fn () ->
-- ..   Result.ok? (HTTP.post https://example.com/ "{}"))
-- true : Bool
let post url body = try post! url body

-- Every value of one header, in the order they arrived. A response may
-- repeat a header -- `set-cookie` is the one that matters -- and `header`
-- answers the last of them.
--
-- >> HTTP.header_list "Accept" HTTP.Response(status = 200, headers = {accept = "a"}, body = "")
-- ["a"] : List String
let header_list name (r: Response) =
  match header name r with
  | Some v -> [v]
  | None -> []

-- Read a response body as one value, the way `Shell.decode` reads a
-- capture. There is no `get_json`: the reading happens in one place, with a
-- message that says what was wrong, rather than a chain of scrapes that
-- each assume the last one worked.
--
-- >> HTTP.decode Decode.int HTTP.Response(status = 200, headers = {}, body = "42")
-- Ok(42) : Result String Int
let decode d (r: Response) = Shell.decode d r.body

-- Fetch a URL straight into a file. Raises if the exchange did not happen
-- or the server did not answer 2xx.
--
-- Load-bearing rather than a convenience. The bytes go from the socket to
-- the file without becoming a value on the way, so an artifact larger than
-- memory is a download rather than a crash -- which is also why the body of
-- a `Response` is a `String` and this is not.
--
-- Redirects are followed and every hop is checked against the manifest, as
-- they are for any other request.
let download! url dest = net_download url dest

-- Fetch a URL straight into a file.
let download url dest = try download! url dest

-- Send a file as the body of a request. Raises if the exchange did not
-- happen.
--
-- The file is read rather than streamed, which is why this declares
-- `FS.Read` and `download` declares `FS.Write`. A body that will not fit in
-- memory has no answer here yet.
let upload! url path = request! Request(url = url, method = POST, body = FS.read_file! path)

-- Send a file as the body of a request.
let upload url path = try upload! url path

-- ── Serving ─────────────────────────────────────────────────────────────

-- A request as a server receives it: a path and a query rather than a URL,
-- and where it came from. It is a type of its own, so one cannot be sent
-- back out by mistake.
type Incoming(
  method: Method,
  path: String,
  query: String,
  headers: Map String,
  body: String,
  peer: String = ""
)

-- A server: the port it listens on, and everything else with a default --
-- how many requests it handles at once, the size of a request's body and
-- of its head, how long a head may take to arrive, how long the handler
-- may take, and how long a request in progress is given to finish when
-- the server is told to stop.
type Server(
  port: Port,
  limit: Int = 256,
  max_body: Size = 1MB,
  max_head: Size = 16KB,
  head_timeout: Duration = 10s,
  deadline: Duration = 30s,
  grace: Duration = 10s
)

-- A response with this status and body, and no headers.
--
-- >> (HTTP.reply 404 "no such user").status
-- 404 : Int
let reply status body = Response(status = status, headers = {}, body = body)

let _split_target target =
  match String.split "?" target with
  | [] -> ("/", "")
  | [path] -> (path, "")
  | [path :: rest] -> (path, String.join "?" rest)

-- A request made in a test, to give a handler without a socket.
--
-- >> (HTTP.incoming HTTP.GET "/users/9?full=1").query
-- "full=1" : String
let incoming method target =
  let (path, query) = _split_target target;
  Incoming(method = method, path = path, query = query, headers = {}, body = "")

-- The parts of a request's path, decoded, without the empty ones the
-- slashes leave. Routing is a `match` on these.
--
-- >> HTTP.segments (HTTP.incoming HTTP.GET "/users/john%20doe/")
-- ["users", "john doe"] : List String
let segments (req: Incoming) =
  String.split "/" req.path
  |> List.filter (fn s -> !(String.empty? s))
  |> List.map (fn s -> Result.default s (URL.decode s))

let _status_text code =
  match code with
  | 200 -> "OK"
  | 201 -> "Created"
  | 202 -> "Accepted"
  | 204 -> "No Content"
  | 301 -> "Moved Permanently"
  | 302 -> "Found"
  | 304 -> "Not Modified"
  | 400 -> "Bad Request"
  | 401 -> "Unauthorized"
  | 403 -> "Forbidden"
  | 404 -> "Not Found"
  | 405 -> "Method Not Allowed"
  | 408 -> "Request Timeout"
  | 409 -> "Conflict"
  | 413 -> "Content Too Large"
  | 422 -> "Unprocessable Content"
  | 431 -> "Request Header Fields Too Large"
  | 500 -> "Internal Server Error"
  | 501 -> "Not Implemented"
  | 503 -> "Service Unavailable"
  | _ -> "Status"

let _method_of text =
  match text with
  | "GET" -> Some GET
  | "POST" -> Some POST
  | "PUT" -> Some PUT
  | "PATCH" -> Some PATCH
  | "DELETE" -> Some DELETE
  | "HEAD" -> Some HEAD
  | _ -> None

-- The lines of a request's head, up to the blank one, within `max` bytes.
let _read_head conn max =
  let go lines used =
    match Net.read_line conn with
    | None -> Error (400, "the request ended before its head did")
    | Some "" -> Ok (List.reverse lines)
    | Some line -> if used + String.length line > max then
        Error (431, "the request's head is larger than %{max} bytes")
      else go (line :: lines) (used + String.length line + 2)
  in
  go [] 0

let _parse_headers lines =
  lines
  |> List.filter_map (fn line ->
    match String.split ":" line with
    | [] -> None
    | [_] -> None
    | [name :: rest] -> Some (
      String.lower (String.trim name),
      String.trim (String.join ":" rest)
    ))
  |> Map.from_list

-- Exactly `n` bytes of body, or fewer if the other end stops sending.
let _read_body conn n =
  let go parts got =
    if got >= n then String.join "" (List.reverse parts)
    else (
      let part = Net.read (n - got) conn;
      if String.empty? part then String.join "" (List.reverse parts)
      else go (part :: parts) (got + String.length part)
    );
  go [] 0

let _read_request (limits: Server) conn =
  match _read_head conn (Size.to_bytes limits.max_head) with
  | Error refusal -> Error refusal
  | Ok [] -> Error (400, "the request is empty")
  | Ok [first :: rest] -> (
    match String.split " " first with
    | [verb, target, _] -> (
      match _method_of verb with
      | None -> Error (501, "")
      | Some method -> (
        let headers = _parse_headers rest;
        let length =
          (match Map.get "content-length" headers with
           | Some n -> Result.default (0 - 1) (String.to_int n)
           | None -> 0);
        if length < 0 then Error (400, "the Content-Length is not a number")
        else if length > Size.to_bytes limits.max_body then
          Error (413, "the body is larger than %{limits.max_body}")
        else (
          let (path, query) = _split_target target;
          Ok Incoming(
            method = method,
            path = path,
            query = query,
            headers = headers,
            body = _read_body conn length,
            peer = Net.peer conn
          )
        )
      )
    )
    | _ -> Error (400, "the request line is not `METHOD target HTTP/version`")
  )

let _send (r: Response) conn =
  let head =
    Map.to_list r.headers |> List.map (fn (k, v) -> "%{k}: %{v}\r\n") |> String.join "";
  let status = "HTTP/1.1 %{r.status} %{_status_text r.status}\r\n";
  let fixed = "Content-Length: %{String.length r.body}\r\nConnection: close\r\n";
  let _ = Net.write "%{status}%{fixed}%{head}\r\n%{r.body}" conn;
  ()

let _answer (limits: Server) handler conn =
  match Par.timeout limits.head_timeout (fn () -> _read_request limits conn) with
  | Error _ -> _send (reply 408 "") conn
  | Ok (Error(status, why)) -> _send (reply status why) conn
  | Ok (Ok req) -> (
    match Par.timeout limits.deadline (fn () -> handler req) with
    | Ok response -> _send response conn
    | Error why -> if String.starts_with? "timed out after" why then _send (reply 503 "") conn
      else _send (reply 500 "") conn
  )

-- Serve HTTP as `server` says: each request is given to `handler`, which
-- answers with a response. Runs until the process is told to stop.
--
-- let route (req: HTTP.Incoming) =
--   match (req.method, HTTP.segments req) with
--   | (HTTP.GET, ["health"]) -> HTTP.reply 200 "ok"
--   | _ -> HTTP.reply 404 ""
--
-- HTTP.serve! HTTP.Server(port = :8080) route
-- HTTP.serve! HTTP.Server(port = :8080, limit = 64, deadline = 5s) route
--
-- At most `limit` requests are handled at once. A handler that raises
-- answers 500 for that request only. One that takes longer than the
-- deadline is stopped and answers 503. A request whose head does not
-- arrive in time answers 408, and one larger than the limits answers 413
-- or 431.
--
-- On SIGTERM or Ctrl-C it stops accepting, gives the requests in progress
-- the grace to finish, then stops them, and returns. It raises when it
-- cannot listen: the port is in use, or needs privilege.
let serve! (server: Server) handler =
  Net.listen server.port |> stream_serve server.grace server.limit (_answer server handler)
