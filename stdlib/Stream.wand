import List

-- Reading through, without reading in.
--
-- A stream is a description of a source and its stages; nothing is read
-- until a terminal operation runs it -- open, each line through the
-- stages, close on the way out however the run ends. Like a Resource,
-- it describes; it is never the open thing, so it can be named, passed,
-- and folded twice.
-- Folding twice reads the source twice: traversal is not free and not
-- snapshotted.
--
--     FS.stream_lines /var/log/app.log
--     |> Stream.filter (fn l -> String.contains? "ERROR" l)
--     |> Stream.fold_left (fn n _ -> n + 1) 0
--
-- A source that can fail carries Raise in its row, and the failure
-- surfaces at the terminal operation, where the open happens; `try`
-- around the terminal call is the one capture.

-- A stream of a list's elements. The one source that performs nothing.
--
-- A stream on its own is a description and shows as one -- the work
-- happens when a terminal operation runs it:
--
-- >> Stream.of_list [1, 2, 3]
-- <stream> : Stream {..} Int
--
-- >> Stream.of_list [1, 2, 3] |> Stream.to_list
-- [1, 2, 3] : List Int
let of_list xs = stream_of_list xs

-- Transform each element as it flows.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.map (fn x -> x * 2) |> Stream.to_list
-- [2, 4, 6] : List Int
let map f s = stream_map f s

-- Keep the elements the predicate approves.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.filter (fn x -> x > 1) |> Stream.to_list
-- [2, 3] : List Int
let filter f s = stream_filter f s

-- At most n elements pass; the source stops being read once they have.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.take 2 |> Stream.to_list
-- [1, 2] : List Int
let take n s = stream_take n s

-- Read the source, folding every element into acc.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.fold_left (fn a x -> a + x) 0
-- 6 : Int
let fold_left f acc s = stream_fold f acc s

-- Read the source for f's effects, dropping what f returns.
--
-- >> Stream.of_list ["a", "b"] |> Stream.each (fn x -> IO.println x)
-- a
-- b
let each f s = stream_each f s

-- Read the source and keep everything -- the memory cost is the point of
-- saying it explicitly.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.to_list
-- [1, 2, 3] : List Int
let to_list s = stream_to_list s

-- The number of elements the source yields.
--
-- Counting reads the whole source, and counting twice reads it twice. A
-- source that never ends -- `Shell.stream $*(tail -f app.log)` -- never
-- finishes counting.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.count
-- 3 : Int
let count s = fold_left (fn n _ -> n + 1) 0 s

-- The final element, or None when the source is empty.
--
-- The whole source is read to reach it. There is no way to arrive at the
-- last of a stream without passing every one before it.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.last
-- Some(3) : Option Int
--
-- >> Stream.of_list [] |> Stream.last
-- None : Option 'a
let last s = fold_left (fn _ x -> Some x) None s

-- True when the source yields nothing.
--
-- One element is enough to answer, so the source is read no further.
--
-- >> Stream.of_list [] |> Stream.empty?
-- true : Bool
--
-- >> Stream.of_list [1] |> Stream.empty?
-- false : Bool
let empty? s = List.empty? (s |> take 1 |> to_list)

-- True when any element satisfies the predicate.
--
-- Reading stops at the first element that does, so a match near the head
-- of a large file costs the head of that file and nothing more.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.any? (fn x -> x > 2)
-- true : Bool
let any? p s = !(empty? (filter p s))

-- True when every element satisfies the predicate.
--
-- Reading stops at the first element that does not.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.all? (fn x -> x > 0)
-- true : Bool
let all? p s = empty? (filter (fn x -> !(p x)) s)

-- The first element satisfying the predicate, or None.
--
-- Reading stops there.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.find (fn x -> x > 1)
-- Some(2) : Option Int
--
-- >> Stream.of_list [1, 2, 3] |> Stream.find (fn x -> x > 9)
-- None : Option Int
let find p s = List.head (s |> filter p |> take 1 |> to_list)

-- Combine the elements with f, seeding the accumulator from the first
-- one. Private: it exists so sum, max and min are one line each, and the
-- public spelling of "fold from the head" is not yet decided.
let _reduce f s =
  fold_left
    (fn a x -> match a with
      | None -> Some x
      | Some v -> Some (f v x)
    )
    None
    s

-- Total the elements, or None when the source is empty.
--
-- Add-polymorphic for the same reason `List.sum` is: the total starts
-- from the first element, because a literal zero would pin the type to
-- Int. So a stream of sizes totals to a Size.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.sum
-- Some(6) : Option Int
--
-- >> Stream.of_list [] |> Stream.sum
-- None : Option ('a: Add)
let sum s = _reduce (fn a b -> a + b) s

-- The largest element, or None when the source is empty.
--
-- >> Stream.of_list [3, 1, 2] |> Stream.max
-- Some(3) : Option Int
let max s = _reduce (fn a b -> if b > a then b else a) s

-- The smallest element, or None when the source is empty.
--
-- >> Stream.of_list [3, 1, 2] |> Stream.min
-- Some(1) : Option Int
let min s = _reduce (fn a b -> if b < a then b else a) s

-- Transform each element and keep the answers that are there. One step
-- where a `map` and a `filter` are two.
--
-- A line that does not parse is `None` and does not reach the fold, which
-- is how a stream handles a bad line: there is no Result-aware family
-- here, because this and a `Result` in the accumulator cover it.
--
-- >> Stream.of_list [1, 2, 3, 4]
-- ..   |> Stream.filter_map (fn x -> if x % 2 == 0 then Some(x * 10) else None)
-- ..   |> Stream.to_list
-- [20, 40] : List Int
let filter_map f s = stream_filter_map f s

-- Transform each element into several, and pass each of them on. The one
-- stage that can emit more than it is given.
--
-- >> Stream.of_list ["a b", "c"]
-- ..   |> Stream.flat_map (fn l -> String.split " " l)
-- ..   |> Stream.to_list
-- ["a", "b", "c"] : List String
let flat_map f s = stream_flat_map f s

-- Pass elements while the predicate holds, and stop at the first one it
-- refuses. The source stops being read there, as it does for `take`.
--
-- >> Stream.of_list [1, 2, 9, 3] |> Stream.take_while (fn x -> x < 5)
-- ..   |> Stream.to_list
-- [1, 2] : List Int
let take_while f s = stream_take_while f s

-- Skip the first n elements. They are read and thrown away: a stream has
-- no way to arrive at the n+1th without passing the ones before it.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.drop 2 |> Stream.to_list
-- [3] : List Int
let drop n s = stream_drop n s

-- Skip elements while the predicate holds, then pass every one after.
-- Once it has stopped dropping it does not start again.
--
-- The header of a file is the case: drop while a line is a comment.
--
-- >> Stream.of_list [1, 2, 9, 1] |> Stream.drop_while (fn x -> x < 5)
-- ..   |> Stream.to_list
-- [9, 1] : List Int
let drop_while f s = stream_drop_while f s

-- Pair each element with its position, counting from zero.
--
-- >> Stream.of_list ["a", "b"] |> Stream.indexed |> Stream.to_list
-- [(0, "a"), (1, "b")] : List (Int, String)
let indexed s = stream_indexed s

-- A running total: each element answers with the accumulator after it.
--
-- `fold_left` gives the last answer and this gives all of them, so a
-- running sum is a stream rather than a fold that keeps a list. The
-- starting value is not emitted: a stage answers about an element, and
-- before the first element there is none.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.scan (fn a x -> a + x) 0
-- ..   |> Stream.to_list
-- [1, 3, 6] : List Int
let scan f init s = stream_scan f init s

-- Group elements into lists of n. The last group is what is left, so it
-- can hold fewer than n.
--
-- Batching is the case: a thousand rows written per request rather than
-- one, without holding the whole file.
--
-- >> Stream.of_list [1, 2, 3] |> Stream.chunks 2 |> Stream.to_list
-- [[1, 2], [3]] : List (List Int)
let chunks n s = stream_chunks n s

-- Pass an element the first time it is seen, and never again.
--
-- **This holds every distinct element it has seen.** On a source without
-- an end that is memory without an end. It is bounded by how many
-- different elements arrive, not by how many arrive.
--
-- >> Stream.of_list [1, 2, 1, 3] |> Stream.unique |> Stream.to_list
-- [1, 2, 3] : List Int
let unique s = stream_unique s
-- Count how often each string arrives, reading the stream once.
--
-- Written as a fold, counting applies two functions to every item: the
-- fold's own, and the one `Map.update` increments with. This applies
-- neither. It is the whole loop, so a stream that does not fit in memory
-- still tallies -- what it holds is one count for each different string,
-- not the stream.
--
-- Counting by something other than the whole line is `Stream.map` or
-- `Stream.filter_map` in front of it, and those run in the same loop:
-- `FS.stream_lines log |> Stream.filter_map (String.word 0) |> Stream.tally`
-- counts first fields and skips a line that has none.
--
-- Entries come back in the order their keys were first seen, as everywhere
-- a map is built. Sort by the count to rank them.
--
-- >> Stream.of_list ["a", "b", "a"] |> Stream.tally
-- {a = 2, b = 1} : Map Int
let tally s = stream_tally s
