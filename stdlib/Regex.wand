import Result

-- Compile a pattern string into a Regex, returning Ok or Error.
--
-- For a pattern decided at run time. One written in the source is a
-- literal -- `r/\d+/` -- and is compiled before the program runs, so it
-- cannot fail here.
--
-- >> Regex.compile "("
-- Error("invalid regex: (") : Result String Regex
let compile pattern = regex_compile pattern

-- The same as `Regex.compile`, raising the reason instead of answering with it.
--
-- >> Regex.compile! "a+"
-- <regex> : Regex
let compile! pattern = Result.get! (compile pattern)

-- Return true if the string contains a match for the regex.
--
-- >> Regex.match? r/\d+/ "a1b"
-- true : Bool
--
-- A flag goes after the closing slash:
--
-- >> Regex.match? r/WAND/i "wand"
-- true : Bool
let match? re s = regex_match re s

-- Return the full match and capture groups, or None if no match.
--
-- The whole match first, then one element per group. A group that
-- matches nothing is an empty string.
--
-- >> Regex.capture r/(\w+)@(\w+)/ "a@b"
-- Some(["a@b", "a", "b"]) : Option (List String)
--
-- >> Regex.capture r/(\w+)@(\w+)/ "nope"
-- None : Option (List String)
let capture re s = regex_capture re s

-- Replace the first match with a plain string.
--
-- >> Regex.replace r/a/ "o" "banana"
-- "bonana" : String
let replace re repl s = regex_replace re repl s

-- Replace all matches with a plain string.
--
-- >> Regex.replace_all r/a/ "o" "banana"
-- "bonono" : String
let replace_all re repl s = regex_replace_all re repl s

-- Replace the first match with what a function makes of it. The function
-- is given what `capture` gives: the whole match, then each group, and ""
-- for a group that matched nothing.
--
-- >> Regex.replace_with r/(\d+)/ (fn g -> String.repeat 2 (List.get! 1 g)) "a1b2"
-- "a11b2" : String
let replace_with re f s = regex_replace_with re f s

-- Replace every match with what a function makes of it, given what
-- `capture` gives for that match. A group is reached by its place in the
-- list, so the replacement is code rather than a string with `$1` in it,
-- and a replacement that holds a `$` means what it says.
--
-- >> Regex.replace_all_with r/(\w+)@(\w+)/ (fn g ->
-- ..   match g with
-- ..   | [_, user, host] -> "%{host} at %{user}"
-- ..   | _ -> "") "a@b c@d"
-- "b at a d at c" : String
let replace_all_with re f s = regex_replace_all_with re f s

-- Split the string on matches of the regex.
--
-- >> Regex.split r/\s+/ "a  b   c"
-- ["a", "b", "c"] : List String
let split re s = regex_split re s

-- Return every non-overlapping match of the regex, in order.
--
-- >> Regex.match_all r/\d+/ "a1b22c333"
-- ["1", "22", "333"] : List String
let match_all re s = regex_find_all re s
