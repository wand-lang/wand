import List
import String

-- Join two path segments.
--
-- >> Path.join /etc ./hosts
-- /etc/hosts : Path
let join p1 p2 = path_join p1 p2

-- Return the parent directory of a path.
--
-- >> Path.parent /etc/hosts
-- /etc : Path
let parent p = path_parent p

-- Return the final component of a path, without directories. It is a
-- Path, not a String: a basename is a one-segment relative path, and the
-- thing you most often do next is join it onto a directory. Use
-- `Path.to_string` when the text itself is what you want.
--
-- >> Path.basename /etc/hosts
-- hosts : Path
let basename p = path_basename p

-- Return the file extension including the leading dot, or "" if none.
--
-- >> Path.extension ./notes.txt
-- ".txt" : String
--
-- >> Path.extension /etc/hosts
-- "" : String
let extension p = path_extension p

-- Return the path with its extension replaced.
--
-- >> Path.with_extension ".md" ./notes.txt
-- ./notes.md : Path
--
-- An empty extension takes one off:
--
-- >> Path.with_extension "" ./notes.txt
-- ./notes : Path
let with_extension ext p = path_with_extension ext p

-- Return true if the path is absolute.
--
-- >> Path.absolute? /etc/hosts
-- true : Bool
let absolute? p = path_is_absolute p

-- Return true if the path is relative.
--
-- >> Path.relative? ./notes.txt
-- true : Bool
let relative? p = path_is_relative p

-- Resolve . and .. components in a path.
--
-- Text only: nothing is asked of the file system, so a `..` is dropped
-- whether or not the directory above it exists.
--
-- `==` and `<` do not use this. They compare in a weaker form that leaves
-- `..` alone, because `/a/c/../b` is `/a/b` only while `c` is not a
-- symlink. Two paths that differ only in separators, `.` segments or a
-- trailing separator are already equal without this function.
--
-- >> Path.normalize /etc/../var/./log
-- /var/log : Path
let normalize p = path_normalize p

-- Convert a path to its string representation.
--
-- >> Path.to_string /etc/hosts
-- "/etc/hosts" : String
let to_string p = path_to_string p

-- Parse a string as a path.
--
-- >> Path.of_string "/etc/hosts"
-- /etc/hosts : Path
let of_string s = path_of_string s

-- Return a list of the path's components as strings.
--
-- >> Path.components /etc/hosts
-- ["etc", "hosts"] : List String
let components p = path_components p

-- A path's segments, without the `.` and empty ones that `==` ignores.
let _segments p = List.filter (fn s -> s != ".") (path_components p)

-- True when a `..` in the segments goes above where they start.
let _climbs_out? depth parts =
  match parts with
  | [] -> false
  | [".." :: t] -> depth == 0 || _climbs_out? (depth - 1) t
  | [_ :: t] -> _climbs_out? (depth + 1) t

-- The path from `dir` to `p`, or `None` when `p` is not under `dir`.
--
-- `FS.list_dir` and `FS.glob_in` give paths that start with the directory
-- they read. This takes that directory off again, so `./d/logs/b.txt`
-- prints as `logs/b.txt`.
--
-- It compares components, not text: `./dd/x` is not under `./d`. The two
-- paths are compared in the form `==` uses, so `./d`, `d` and `d/` are one
-- directory, and nothing is asked of the file system. An absolute path is
-- never under a relative one, nor the other way: to make a relative path
-- absolute needs the working directory. A `..` is compared as written, as
-- `==` does, and a `p` whose `..` climbs back out of `dir` is not under it.
-- Use `Path.normalize` first to resolve them.
--
-- A directory relative to itself is `.`, the path that names it from
-- inside.
--
-- >> Path.relative_to ./d ./d/logs/b.txt
-- Some(logs/b.txt) : Option Path
--
-- >> Path.relative_to ./d ./dd/x
-- None : Option Path
--
-- >> Path.relative_to /srv/app/ /srv/app
-- Some(.) : Option Path
let relative_to dir p =
  let base = _segments dir;
  let parts = _segments p;
  let rest = List.drop (List.length base) parts;
  if path_is_absolute dir != path_is_absolute p then None
  else if List.take (List.length base) parts != base then None
  else if _climbs_out? 0 rest then None
  else if rest == [] then Some (path_of_string ".")
  else Some (path_of_string (String.join "/" rest))

-- The path from `dir` to `p`. Raises when `p` is not under `dir`.
--
-- >> Path.relative_to! ./d ./d/logs/b.txt
-- logs/b.txt : Path
let relative_to! dir p =
  match relative_to dir p with
  | Some rest -> rest
  | None -> fail_exn "relative_to: %{p} is not under %{dir}"

implement Ord Path =
  -- The larger of two Paths.
  --
  -- The form that says which file a path names: repeated separators,
  -- `.` segments and a trailing separator make no difference.
  --
  -- >> Path.max /a/b /a/c
  -- /a/c : Path
  let max a b = if a > b then a else b;
  -- The smaller of two Paths.
  --
  -- >> Path.min /a/b /a/c
  -- /a/b : Path
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> Path.clamp /a/a /a/m /a/z
  -- /a/m : Path
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> Path.between? /a/a /a/z /a/m
  -- true : Bool
  let between? lo hi v = v >= lo && v <= hi
