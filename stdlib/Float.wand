import Result

-- Crossing between the two members of Num.
--
-- Arithmetic never converts on its own -- `1.5 + 1` is a type error --
-- so the crossing is always written out, and this is where it is
-- written.

-- The Float with the same value.
--
-- A Float whose value is whole shows without a point, so the type is what
-- tells the two apart.
--
-- >> Float.of_int 3
-- 3 : Float
let of_int n = float_of_int n

-- The nearest Int, halves rounding away from zero. NaN, infinity and a
-- value past an Int's range have no nearest Int, and are a runtime error,
-- as an Int that overflows is; the same holds for `floor` and `ceil`.
--
-- A negative argument needs its brackets: `Float.round -2.5` is the
-- subtraction it looks like, not a call.
--
-- >> Float.round 2.5
-- 3 : Int
--
-- >> Float.round (-2.5)
-- -3 : Int
let round f = float_round f

-- The largest Int at or below.
--
-- >> Float.floor 2.9
-- 2 : Int
--
-- >> Float.floor (-2.1)
-- -3 : Int
let floor f = float_floor f

-- The smallest Int at or above.
--
-- >> Float.ceil 2.1
-- 3 : Int
--
-- >> Float.ceil (-2.9)
-- -2 : Int
let ceil f = float_ceil f

-- The distance from zero.
--
-- >> Float.abs (-2.5)
-- 2.5 : Float
let abs f = float_abs f

-- The number written to a fixed number of digits after the point. Halves
-- round away from zero, and the digits are filled in.
--
-- >> Float.format 1 0.3333
-- "0.3" : String
--
-- >> Float.format 2 1.5
-- "1.50" : String
let format digits f = float_format digits f

-- Read a float.
--
-- >> Float.of_string "1.5"
-- Ok(1.5) : Result String Float
let of_string s = str_to_float s

-- The same as `Float.of_string`, raising the reason instead of answering
-- with it.
--
-- >> Float.of_string! "1.5"
-- 1.5 : Float
let of_string! s = Result.get! (of_string s)

implement Ord Float =
  -- The larger of two Floats.
  --
  -- >> Float.max 1.5 2.25
  -- 2.25 : Float
  let max a b = if a > b then a else b;
  -- The smaller of two Floats.
  --
  -- >> Float.min 1.5 2.25
  -- 1.5 : Float
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> Float.clamp 0.5 1.5 2.5
  -- 1.5 : Float
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> Float.between? 0.5 1.5 1.0
  -- true : Bool
  let between? lo hi v = v >= lo && v <= hi
