import List
import Result

-- Return the number of bytes in a string. A character outside ASCII takes
-- more than one, so this is a size rather than a count of letters.
--
-- >> String.length "wand"
-- 4 : Int
let length s = str_length s

-- Return true if the string is empty.
--
-- >> String.empty? ""
-- true : Bool
let empty? s = str_length s == 0

-- Convert a string to uppercase.
--
-- >> String.upper "wand"
-- "WAND" : String
let upper s = str_upper s

-- Convert a string to lowercase.
--
-- >> String.lower "WAND"
-- "wand" : String
let lower s = str_lower s

-- Strip leading and trailing whitespace.
--
-- >> String.trim "  wand  "
-- "wand" : String
let trim s = str_trim s

-- Strip leading whitespace.
--
-- >> String.trim_left "  wand  "
-- "wand  " : String
let trim_left s = str_trim_left s

-- Strip trailing whitespace.
--
-- >> String.trim_right "  wand  "
-- "  wand" : String
let trim_right s = str_trim_right s

-- Return the substring from index `from` up to (not including) `to_end`.
--
-- >> String.slice 0 4 "wandering"
-- "wand" : String
let slice from to_end s = str_slice from to_end s

-- Split a string on a delimiter, returning a list of substrings.
--
-- >> String.split "," "a,b,c"
-- ["a", "b", "c"] : List String
let split delim s = str_split delim s

-- Return true if the string contains the given substring.
--
-- The part looked for comes first, and the string looked in comes last, as
-- it does in every predicate here. That order is what lets one be pipelined:
-- `name |> String.contains? "x"` reads the way it runs.
--
-- >> String.contains? "and" "wand"
-- true : Bool
--
-- >> "wand" |> String.contains? "and"
-- true : Bool
let contains? needle s = str_contains needle s

-- Return true if the string starts with the given prefix.
--
-- >> String.starts_with? "wa" "wand"
-- true : Bool
let starts_with? prefix s = str_starts_with prefix s

-- Return true if the string ends with the given suffix.
--
-- >> String.ends_with? "nd" "wand"
-- true : Bool
let ends_with? suffix s = str_ends_with suffix s

-- Replace all occurrences of `old` with `new` in the string.
--
-- >> String.replace "a" "o" "banana"
-- "bonono" : String
let replace old new s = str_replace old new s

-- Repeat a string n times.
--
-- >> String.repeat 3 "ab"
-- "ababab" : String
let repeat n s = str_repeat n s

-- Reverse a string.
--
-- >> String.reverse "wand"
-- "dnaw" : String
let reverse s = str_reverse s

-- At most n bytes, cut so a multi-byte character is never split.
--
-- The budget is bytes, as every other Int in this module is, so
-- `String.length (String.truncate n s)` is never above n. What it buys
-- over `String.slice 0 n` is that the answer is still valid text: slicing
-- "café" at four bytes leaves half of the é behind.
--
-- It is not a display width. A CJK character occupies two terminal
-- columns and a combining mark occupies none, so a budget in bytes and a
-- budget in columns are different questions and wand answers the first.
--
-- Bytes that are not UTF-8 are cut at n, because there is no character
-- there to keep whole.
--
-- >> String.truncate 4 "café"
-- "caf" : String
--
-- >> String.truncate 5 "café"
-- "café" : String
--
-- >> String.truncate 9 "café"
-- "café" : String
let truncate n s = str_truncate n s

-- Split into one string per byte.
--
-- A String is bytes, so this is a byte split rather than a character
-- split: `String.bytes "café"` has five elements, and the last two are
-- the halves of the é.
--
-- >> String.bytes "wand"
-- ["w", "a", "n", "d"] : List String
let bytes s = str_bytes s

-- Convert an integer to its string representation.
--
-- >> String.of_int 42
-- "42" : String
let of_int n = int_to_str n

-- Parse a string as an integer: an optional `-` and decimal digits, with
-- the space around them ignored. Returns Ok n or Error msg.
--
-- >> String.to_int "42"
-- Ok(42) : Result String Int
--
-- >> String.to_int "x"
-- Error("cannot parse \"x\" as Int") : Result String Int
--
-- >> String.to_int "0x1F"
-- Error("cannot parse \"0x1F\" as Int") : Result String Int
let to_int s = str_to_int s

-- The same as `String.to_int`, raising the reason instead of
-- answering with it.
--
-- >> String.to_int! "42"
-- 42 : Int
let to_int! s = Result.get! (to_int s)

-- Parse a string as a float. Returns Ok f or Error msg.
--
-- >> String.to_float "1.5"
-- Ok(1.5) : Result String Float
let to_float s = str_to_float s

-- The same as `String.to_float`, raising the reason instead of
-- answering with it.
--
-- >> String.to_float! "1.5"
-- 1.5 : Float
let to_float! s = Result.get! (to_float s)

-- Parse "true" or "false" (case-insensitive). Returns Ok b or Error msg.
--
-- >> String.to_bool "TRUE"
-- Ok(true) : Result String Bool
let to_bool s = str_to_bool s

-- The same as `String.to_bool`, raising the reason instead of
-- answering with it.
--
-- >> String.to_bool! "TRUE"
-- true : Bool
let to_bool! s = Result.get! (to_bool s)

-- Convert a string to a Path value. Always succeeds.
--
-- >> String.to_path "/etc/hosts"
-- /etc/hosts : Path
let to_path s = str_to_path s

-- The glob that text spells, or an error saying why it is not one.
--
-- A pattern out of argv or a config file comes through here. There is no
-- other way to build one: a literal cannot begin with a bare name, since
-- `src/**/*.ts` reads as a variable called `src`.
--
-- >> String.to_glob "src/**/*.ts"
-- Ok(src/**/*.ts) : Result String Glob
--
-- >> String.to_glob "notes.txt"
-- Error("cannot parse \"notes.txt\" as Glob: a glob has a `*`, a `?` or a `[`; text with none of them is a Path") : Result String Glob
let to_glob s = str_to_glob s

-- The same as `String.to_glob`, raising the reason instead of
-- answering with it.
--
-- >> String.to_glob! "src/**/*.ts"
-- src/**/*.ts : Glob
let to_glob! s = Result.get! (to_glob s)

-- Parse a URL string. Returns Ok url or Error msg.
--
-- >> String.to_url "https://example.com"
-- Ok(https://example.com) : Result String URL
let to_url s = str_to_url s

-- The same as `String.to_url`, raising the reason instead of
-- answering with it.
--
-- >> String.to_url! "https://example.com"
-- https://example.com : URL
let to_url! s = Result.get! (to_url s)

-- Parse an IPv4 address string. Returns Ok ipv4 or Error msg.
--
-- >> String.to_ipv4 "192.168.1.1"
-- Ok(192.168.1.1) : Result String IPv4
let to_ipv4 s = str_to_ipv4 s

-- The same as `String.to_ipv4`, raising the reason instead of
-- answering with it.
--
-- >> String.to_ipv4! "192.168.1.1"
-- 192.168.1.1 : IPv4
let to_ipv4! s = Result.get! (to_ipv4 s)

-- Parse a CIDR string (e.g. "192.168.0.0/24"). Returns Ok cidr or Error msg.
--
-- >> String.to_cidr "10.0.0.0/8"
-- Ok(10.0.0.0/8) : Result String CIDR
let to_cidr s = str_to_cidr s

-- The same as `String.to_cidr`, raising the reason instead of
-- answering with it.
--
-- >> String.to_cidr! "10.0.0.0/8"
-- 10.0.0.0/8 : CIDR
let to_cidr! s = Result.get! (to_cidr s)

-- Parse a port string (e.g. ":8080"). Returns Ok port or Error msg.
--
-- >> String.to_port ":8080"
-- Ok(:8080) : Result String Port
let to_port s = str_to_port s

-- The same as `String.to_port`, raising the reason instead of
-- answering with it.
--
-- >> String.to_port! ":8080"
-- :8080 : Port
let to_port! s = Result.get! (to_port s)

-- Parse a version string (e.g. "1.2.3"). Returns Ok version or Error msg.
--
-- >> String.to_version "1.2.3"
-- Ok(1.2.3) : Result String Version
let to_version s = str_to_version s

-- The same as `String.to_version`, raising the reason instead of
-- answering with it.
--
-- >> String.to_version! "1.2.3"
-- 1.2.3 : Version
let to_version! s = Result.get! (to_version s)

-- Parse a size string (e.g. "10MB"). Returns Ok size or Error msg.
--
-- >> String.to_size "10MB"
-- Ok(10MB) : Result String Size
let to_size s = str_to_size s

-- The same as `String.to_size`, raising the reason instead of
-- answering with it.
--
-- >> String.to_size! "10MB"
-- 10MB : Size
let to_size! s = Result.get! (to_size s)

-- Parse an instant, written either way: "2024-01-15T14:30:00Z" or the bare
-- day "2024-01-15", which is midnight UTC. Returns Ok datetime or Error
-- msg.
--
-- >> String.to_datetime "2026-08-22"
-- Ok(2026-08-22T00:00:00Z) : Result String DateTime
let to_datetime s = str_to_datetime s

-- The same as `String.to_datetime`, raising the reason instead of
-- answering with it.
--
-- >> String.to_datetime! "2026-08-22"
-- 2026-08-22T00:00:00Z : DateTime
let to_datetime! s = Result.get! (to_datetime s)

-- Parse a duration string (e.g. "5min", "1h30m"). Returns Ok duration or Error msg.
--
-- >> String.to_duration "1h30m"
-- Ok(1h30m) : Result String Duration
let to_duration s = str_to_duration s

-- The same as `String.to_duration`, raising the reason instead of
-- answering with it.
--
-- >> String.to_duration! "1h30m"
-- 1h30m : Duration
let to_duration! s = Result.get! (to_duration s)

-- Join a list of strings with a separator.
--
-- >> String.join ", " ["a", "b", "c"]
-- "a, b, c" : String
--
-- >> String.join "," ["", "b"]
-- ",b" : String
let join sep xs =
  match xs with
  | [] -> ""
  -- Which element comes first is a question about the list, not about what
  -- the elements hold: testing the accumulator for "" made an empty first
  -- element look like "nothing yet", so `join "," ["", "b"]` answered "b"
  -- and dropped a field that was empty on purpose.
  | [h :: t] -> List.fold_left (fn acc x -> acc ++ sep ++ x) h t

-- Split a string into lines. A newline ends a line rather than separating
-- two, so a trailing one adds no empty line and a string with nothing in it
-- has no lines.
--
-- Nearly every file ends in a newline, so splitting on "\n" answered with
-- one element more than there were lines and "" at the end, which every
-- caller then had to drop. An empty line inside the text is kept: only the
-- bytes after the last newline are dropped, and only when there are none.
--
-- >> String.lines "one\ntwo"
-- ["one", "two"] : List String
--
-- >> String.lines "one\ntwo\n"
-- ["one", "two"] : List String
--
-- >> String.lines "one\n\nthree\n"
-- ["one", "", "three"] : List String
--
-- >> String.lines ""
-- [] : List String
let lines s = str_lines s

-- Split a string into words: any run of whitespace separates them, and
-- leading or trailing whitespace adds none.
--
-- A space, a tab, a carriage return and a newline each separate, and a run
-- of them separates once. Splitting on a single space instead made every
-- extra space its own empty word -- `words "  a  b  "` came back with seven
-- elements, five of them "" -- and a tab separated nothing at all.
--
-- >> String.words "  one   two  "
-- ["one", "two"] : List String
--
-- >> String.words "a\tb\nc  d"
-- ["a", "b", "c", "d"] : List String
let words s = str_words s

-- The word at index `n`, counting from 0. `None` where the string has no
-- such word.
--
-- The same rule `words` uses: a run of whitespace separates once, and
-- leading or trailing whitespace adds no word. Reading one word is what
-- this is for -- it walks to `n` and builds only that one, where
-- `List.get n (String.words s)` builds every word to hand back one.
--
-- >> String.word 1 "a b c"
-- Some("b") : Option String
--
-- >> String.word 9 "a b c"
-- None : Option String
--
-- >> String.word 1 "  a   b  "
-- Some("b") : Option String
let word n s = str_word n s

-- The word at index `n`, raising where there is none.
--
-- >> String.word! 1 "a b c"
-- "b" : String
let word! n s = str_word_exn n s

implement Ord String =
  -- The larger of two Strings.
  --
  -- Byte order, so `"Z"` is before `"a"`.
  --
  -- >> String.max "a" "b"
  -- "b" : String
  let max a b = if a > b then a else b;
  -- The smaller of two Strings.
  --
  -- >> String.min "a" "b"
  -- "a" : String
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> String.clamp "a" "m" "z"
  -- "m" : String
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> String.between? "a" "m" "f"
  -- true : Bool
  let between? lo hi v = v >= lo && v <= hi
