import JSON
import List
import Map
import Option
import Result
import String

-- Reading a command line.
--
-- Arguments are another untyped boundary, and the language already has one
-- blessed way to read those. So argv becomes an object and a `Decoder`
-- reads it -- every combinator, every domain reader, derivation, and the
-- error that names the field, all of it already written:
--
--     type Opts (port : Port, timeout : Duration, config : Path)
--
--     Args.parse Opts.decoder (Proc.args ())
--     -- Ok (Opts (port = :8080, timeout = 30s, config = ./app.toml))
--     -- Error .port: expected Port, got "http"
--
-- There is no second set of combinators here on purpose. What this module
-- does is turn a list of strings into a document; `Decode` does the rest.
--
-- `CommandLine` is built in, so it needs no import and no module prefix.
-- `Args.Parser` is that type under the name the thing already goes by:
-- `Opts.parser` is what makes one and `Args.read` is what takes one. It is
-- an alias, so the two spellings are one type.

type Parser 'a = CommandLine 'a

-- ── What counts as a flag ───────────────────────────────────────────────

-- Only `--name`. A single dash is not a flag, which is what keeps `-5` a
-- positional argument rather than an option nobody declared, and short
-- flags out of a design that has no room for them.
let _flag? arg = String.starts_with? "--" arg

let _name_of arg = String.slice 2 (String.length arg) arg

-- `--key=value` is unambiguous on its own. Anything else needs to know
-- whether the flag takes a value, which is the one fact a list of strings
-- cannot supply. A `Parser` carries it, as its `spec`.
let _inline? arg = String.contains? "=" arg

let _inline_pair arg =
  match String.split "=" (_name_of arg) with
  | [k :: rest] -> (k, String.join "=" rest)
  | [] -> (_name_of arg, "")

-- ── argv to an object ───────────────────────────────────────────────────

-- Positional arguments live under `_`, which cannot collide with a flag:
-- `--_` is not a name anyone writes, and `_` is already the language's
-- word for "the part with no name".
--
--     Args.parse (Decode.field "_" (Decode.list Decode.string)) args
--
-- >> Args.parse (Decode.field "_" (Decode.list Decode.string)) ["a", "b"]
-- Ok(["a", "b"]) : Result String (List String)
let _positional_key = "_"

-- What a flag's own text cannot say: whether it takes a value, and whether
-- it collects. A name the spec does not mention takes one value and the
-- last one written wins.
let _switch? spec k =
  match Map.get k spec with
  | Some "switch" -> true
  | _ -> false

let _repeated? spec k =
  match Map.get k spec with
  | Some "repeated" -> true
  | _ -> false

let _object_of_spec spec args =
  -- A repeated flag is gathered separately and joined at the end: the value
  -- of a key is one JSON string until a second `--tag` makes it a list, and
  -- reading a list back out to append to it is work the type already knows
  -- the answer to.
  let set k v (fields, repeats) =
    if _repeated? spec k
    then (fields,
          Map.update k [] (fn vs -> List.concat vs [v]) repeats)
    else (Map.set k (JSON.of_string v) fields, repeats)
  in let go acc positional args =
    match args with
    | [] -> Ok(acc, positional)
    -- `--` ends the flags. What follows is positional whatever it looks
    -- like, which is the only way to pass an argument that begins with two
    -- dashes.
    | ["--" :: rest] -> Ok(acc, List.concat positional rest)
    | [arg :: rest] when !(_flag? arg) -> go acc (List.concat positional [arg]) rest
    -- Only flags get past the guard above, so `=` here means `--key=value`.
    | [arg :: rest] when _inline? arg -> (
      let (k, v) = _inline_pair arg in go (set k v acc) positional rest
    )
    | [arg :: rest] -> (
      let k = _name_of arg in
      if _switch? spec k then go (set k "true" acc) positional rest
      else match rest with
        | [v :: more] -> go (set k v acc) positional more
        -- Asking for help is not reading a command line, so it is answered
        -- before one is read rather than by a field nobody declared.
        | [] when k == "help" ->
          Error "--help expects a value; `Args.help?` answers it instead"
        | [] -> Error "--%{k} expects a value"
    )
  -- A flag that collects and was never written is none of them, not a
  -- missing field: the empty list is what a `List` says for absent, as
  -- `false` is for a `Bool`. Seeded here rather than by a rule about lists
  -- everywhere, so a JSON document missing a key is still the error it was.
  in let seeded = (List.fold_left
    (fn acc (k, kind) -> if kind == "repeated" then Map.set k [] acc else acc)
    Map.empty
    (Map.to_list spec))
  in go (Map.empty, seeded) [] args
    |> Result.map (fn ((fields, repeats), positional) -> (
      -- A flag declared repeated holds a list whether it was written once
      -- or twenty times, so the type reads the same either way.
      let gathered =
        List.fold_left
          (fn acc (k, vs) -> Map.set k (JSON.of_list (List.map JSON.of_string vs)) acc)
          fields
          (Map.to_list repeats);
      JSON.of_map
        (Map.set _positional_key (JSON.of_list (List.map JSON.of_string positional)) gathered)
    ))

-- ── Parsing ─────────────────────────────────────────────────────────────

-- Read arguments with a decoder. Every flag is assumed to take a value:
-- `--port 8080` and `--port=8080` are the same argument written twice. Use
-- `read` when some flags are on/off:
--
-- >> Args.parse (Decode.field "port" Decode.port) ["--port", "8080"]
-- Ok(:8080) : Result String Port
--
-- >> Args.parse (Decode.field "port" Decode.port) ["--port=8080"]
-- Ok(:8080) : Result String Port
--
-- A flag that is not there is `None` rather than a failure, if the
-- decoder allows it:
--
-- >> Args.parse (Decode.optional "port" Decode.port) []
-- Ok(None) : Result String (Option Port)
let parse decoder args =
  _object_of_spec Map.empty args |> Result.and_then (JSON.decode decoder)

-- Read arguments against a type's own account of its command line.
--
--     Args.read Opts.parser (Proc.args ())
--
-- `Opts.parser` is derived from the fields, and holds the three things
-- reading one takes: what the flags do that their own text cannot say, the
-- reader, and the usage line. A `Bool` is a switch and a `List` collects, so
-- `--tag a --tag b` is two tags where `--name a --name b` is one name
-- written twice. Both are facts the type states and argv cannot -- a flag
-- written once looks the same either way -- and this is how they reach the
-- reading without being written a second time.
--
-- The three arrive together because they are only ever used together. Taken
-- separately, one type's account of its flags could meet another type's
-- reader, and nothing said so until the run.
--
-- >> Args.read Args.Parser(spec = {v = "switch"}, reader = Decode.field "v" Decode.bool, usage = "") ["--v"]
-- Ok(true) : Result String Bool
--
-- A flag the spec calls repeated holds a list however many times it was
-- written:
--
-- >> Args.read Args.Parser(spec = {t = "repeated"}, reader = Decode.field "t" (Decode.list Decode.string), usage = "") ["--t", "a"]
-- Ok(["a"]) : Result String (List String)
let read : Parser 'a -> List String -> Result String 'a =
  fn parser args -> _object_of_spec parser.spec args
  |> Result.and_then (JSON.decode parser.reader)

-- Return true if the arguments ask for help.
--
-- `--help` is not a flag a type declares: it is a question about the
-- command line rather than a value in it, and the answer is a usage line
-- rather than a record. So it is asked before the arguments are read:
--
--     if Args.help? (Proc.args ())
--     then (IO.println "usage: probe %{Flags.usage} host"; Proc.exit 0)
--     else ...
--
-- >> Args.help? ["--verbose", "--help"]
-- true : Bool
--
-- >> Args.help? ["--verbose"]
-- false : Bool
--
-- After `--` there are no flags left, so a `--help` there is an argument
-- like any other:
--
-- >> Args.help? ["--", "--help"]
-- false : Bool
let help? args =
  match args with
  | [] -> false
  | ["--" :: _] -> false
  | [a :: rest] -> if a == "--help" then true else help? rest
