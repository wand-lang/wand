-- Reading data that arrived untyped.
--
-- A `Decoder a` says how to read an `a` out of a document. It is a value:
-- it can be named, passed to a function, and used against three inputs.
-- Running one is a backend's job -- `JSON.decode`, `TOML.decode`,
-- `CSV.rows`, `Decode.lines` -- and every backend presents what it read in
-- the same shape, so these combinators serve all of them.
--
--     let pod =
--       Decode.map2 (fn n r -> Pod (name = n, restarts = r))
--         (Decode.field "name" Decode.string)
--         (Decode.field "restarts" Decode.int)
--
--     JSON.decode pod (JSON.parse! out)
--
-- Decoding fails with the field that failed and the path to it:
--
--     .items[3].metadata.name: expected String, got Int
--
-- That message is the reason to prefer this to poking at fields one at a
-- time. A scrape that reads the wrong field gets a null and carries on; a
-- decoder stops and says which field, where.
--
-- Decoding is pure. Reading the document is the caller's job, and already
-- says so in the caller's signature.

-- Read a number. `int` requires a whole one; `float` accepts either, since
-- a whole number in a document is an Int to the parser and a Float to
-- whoever wrote it.
--
-- >> JSON.decode Decode.int (JSON.parse! "3")
-- Ok(3) : Result String Int
--
-- >> JSON.decode Decode.int (JSON.parse! "3.5")
-- Error("expected Int, got Float") : Result String Int
let int = decode_int

--
-- >> JSON.decode Decode.float (JSON.parse! "3")
-- Ok(3) : Result String Float
let float = decode_float

-- Read a string.
--
-- >> JSON.decode Decode.string (JSON.parse! `"hi"`)
-- Ok("hi") : Result String String
let string = decode_string

--
-- >> JSON.decode Decode.bool (JSON.parse! "true")
-- Ok(true) : Result String Bool
let bool = decode_bool

-- Read a named field, and decode what is under it. Absence is a failure
-- naming the field: a field that has to be there and is not means the
-- document is not what was expected, which is a reason, not a `None`.
--
-- >> let doc = JSON.parse! `{"a": 1}`
-- >> JSON.decode (Decode.field "a" Decode.int) doc
-- Ok(1) : Result String Int
--
-- >> JSON.decode (Decode.field "z" Decode.int) doc
-- Error(".z: no such field") : Result String Int
let field name inner = decode_field name inner

-- Read a named field that may not be there, as an `Option`. A field that
-- is absent, or written as null, is `None`. A field that is there and will
-- not decode is still a failure -- `optional` says the field may be
-- missing, not that its contents may be anything.
--
-- >> let doc = JSON.parse! `{"a": 1}`
-- >> JSON.decode (Decode.optional "z" Decode.int) doc
-- Ok(None) : Result String (Option Int)
let optional name inner = decode_optional name inner

-- Read every element of a list with the same decoder. The first element
-- that fails stops it.
--
-- >> JSON.decode (Decode.list Decode.int) (JSON.parse! "[1, 2]")
-- Ok([1, 2]) : Result String (List Int)
let list inner = decode_list inner

-- Read an object whose keys are data rather than field names -- a label
-- map, per-host counts -- into a `Map`. Every value is read with the same
-- decoder, and a failure names the key it was under.
--
-- >> let doc = JSON.parse! `{"a": 1, "b": 2}`
-- >> JSON.decode (Decode.dict Decode.int) doc
-- Ok({a = 1, b = 2}) : Result String (Map Int)
let dict inner = decode_dict inner

-- Read a value that may be null, as an `Option`. This is the value-level
-- sibling of `optional`, which asks whether a *field* is there: only a
-- lookup can ask that, so an element of a list needs this one instead.
--
-- >> JSON.decode (Decode.nullable Decode.int) (JSON.parse! "null")
-- Ok(None) : Result String (Option Int)
let nullable inner = decode_nullable inner

-- Read two things from the same value and combine them. This is how a
-- record with two fields is built.
--
-- >> let doc = JSON.parse! `{"a": 1, "b": 2}`
-- >> let a = Decode.field "a" Decode.int
-- >> let b = Decode.field "b" Decode.int
-- >> JSON.decode (Decode.map2 (fn x y -> (x, y)) a b) doc
-- Ok((1, 2)) : Result String (Int, Int)
let map2 f a b = decode_map2 f a b

-- Read one thing, then choose the decoder for the rest from what it said.
-- Together with `succeed` this covers records of any width, and validation
-- that depends on what was read.
--
-- >> let check = fn n -> if n > 0 then Decode.succeed n else Decode.fail "too small"
-- >> JSON.decode (Decode.and_then check Decode.int) (JSON.parse! "-1")
-- Error("too small") : Result String Int
let and_then f d = decode_and_then f d

-- A decoder that reads nothing and answers, and one that refuses. They are
-- the two ends of `and_then`: without them it would have nothing to
-- return.
--
-- >> JSON.decode (Decode.succeed 7) (JSON.parse! "null")
-- Ok(7) : Result String Int
let succeed v = decode_succeed v

--
-- >> JSON.decode (Decode.fail "nope") (JSON.parse! "1")
-- Error("nope") : Result String 'a
let fail msg = decode_fail msg

-- Change what a decoder produced.
--
-- >> JSON.decode (Decode.map (fn n -> n * 2) Decode.int) (JSON.parse! "3")
-- Ok(6) : Result String Int
let map f d = and_then (fn x -> succeed (f x)) d

-- Read three things from the same value and combine them.
--
-- Three is where the numbered ones stop. A wider record is `and_map`, or a
-- derived `T.decoder` if the field names match the type's.
--
-- >> let three = Decode.map3 (fn a b c -> (a, b, c)) Decode.int Decode.int Decode.int
-- >> JSON.decode three (JSON.parse! "1")
-- Ok((1, 1, 1)) : Result String (Int, Int, Int)
let map3 f a b c = and_then (fn g -> map g c) (map2 f a b)

-- Hand one more decoder to a function that is waiting for it. Start with
-- `succeed` holding a function of as many arguments as there are fields,
-- then pipe a decoder in for each one. Any width reads the same way, and
-- adding a field is one more line rather than a different combinator.
--
-- A type whose field names match the document's needs none of this:
-- `T.decoder` is derived and reads any width. Reach for `and_map` when the
-- names differ, when a field needs work on the way in, or when the
-- document spells a field something wand cannot -- `$ref`, `x-linked`.
--
-- >> let doc = JSON.parse! `{"x": 1, "y": 2, "z": 3}`
-- >> let triple = Decode.succeed (fn a b c -> (a, b, c))
-- >> let read = triple |> Decode.and_map (Decode.field "x" Decode.int) |> Decode.and_map (Decode.field "y" Decode.int) |> Decode.and_map (Decode.field "z" Decode.int)
-- >> JSON.decode read doc
-- Ok((1, 2, 3)) : Result String (Int, Int, Int)
let and_map d df = map2 (fn f v -> f v) df d

-- Try each decoder in turn and take the first that succeeds. If none does,
-- every alternative's complaint is reported, since which one is the real
-- reason is not the decoder's to guess.
--
-- >> let text = Decode.one_of [Decode.string, Decode.map String.of_int Decode.int]
-- >> JSON.decode text (JSON.parse! "8080")
-- Ok("8080") : Result String String
let one_of ds = decode_one_of ds

-- Domain literals decode as themselves: `"30s"` in a document lexes as the
-- `30s` a script would have written, so the boundary produces the type the
-- rest of the program is written against rather than a String to convert
-- later. Any string is a `Path`.
--
-- >> JSON.decode Decode.path (JSON.parse! `"/etc/hosts"`)
-- Ok(/etc/hosts) : Result String Path
let path = decode_path

-- >> JSON.decode Decode.glob (JSON.parse! `"*.wand"`)
-- Ok(*.wand) : Result String Glob
let glob = decode_glob

--
-- >> JSON.decode Decode.duration (JSON.parse! `"30s"`)
-- Ok(30s) : Result String Duration
let duration = decode_duration

--
-- >> JSON.decode Decode.url (JSON.parse! `"https://example.com"`)
-- Ok(https://example.com) : Result String URL
let url = decode_url

--
-- >> JSON.decode Decode.size (JSON.parse! `"10MB"`)
-- Ok(10MB) : Result String Size
let size = decode_size

--
-- >> JSON.decode Decode.version (JSON.parse! `"1.2.3"`)
-- Ok(1.2.3) : Result String Version
let version = decode_version

-- An instant, written either way: "2024-01-15T14:30:00Z" or the bare day
-- "2024-01-15", which is midnight UTC.
--
-- >> JSON.decode Decode.datetime (JSON.parse! `"2024-01-15"`)
-- Ok(2024-01-15T00:00:00Z) : Result String DateTime
let datetime = decode_datetime

--
-- >> JSON.decode Decode.ipv4 (JSON.parse! `"192.168.1.1"`)
-- Ok(192.168.1.1) : Result String IPv4
let ipv4 = decode_ipv4

--
-- >> JSON.decode Decode.cidr (JSON.parse! `"10.0.0.0/8"`)
-- Ok(10.0.0.0/8) : Result String CIDR
let cidr = decode_cidr

-- A port is `:8080` in a script; in a document it is the bare number, which
-- is what a config file or an API contains. Both read.
--
-- >> JSON.decode Decode.port (JSON.parse! "8080")
-- Ok(:8080) : Result String Port
let port = decode_port

-- ── Text ───────────────────────────────────────────────────────────────

-- Read a whole text as one value, ignoring the space around it.
--
-- Text with no shape of its own -- a command's output, a response body --
-- is read here, in one place, with a message that says what was wrong:
--
--     let ahead = Decode.run Decode.int $(git rev-list --count HEAD)
--
-- >> Decode.run Decode.int " 42\n"
-- Ok(42) : Result String Int
let run d text = shell_decode d text

-- Read one value per line. `$()` strips the trailing newline, so a capture
-- with nothing in it is no lines rather than one empty line.
--
-- >> Decode.lines Decode.int "1\n2"
-- Ok([1, 2]) : Result String (List Int)
let lines d text = shell_lines d text
