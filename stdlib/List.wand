-- Apply a function to every element of a list, returning a new list.
--
-- >> List.map (fn x -> x * 2) [1, 2, 3]
-- [2, 4, 6] : List Int
let map _ [] = []
let map f [h :: t] = f h :: map f t

-- Keep only elements satisfying a predicate.
--
-- >> List.filter (fn x -> x >= 2) [1, 2, 3]
-- [2, 3] : List Int
let filter _ [] = []
let filter p [h :: t] = if p h then h :: filter p t else filter p t

-- Apply a function to every element, keeping each Some value and dropping each None.
--
-- >> List.filter_map (fn x -> if x > 1 then Some (x * 10) else None) [1, 2, 3]
-- [20, 30] : List Int
let filter_map _ [] = []
let filter_map f [h :: t] =
  match f h with
  | Some v -> v :: filter_map f t
  | None -> filter_map f t

-- Reduce a list left to right with an accumulator.
--
-- >> List.fold_left (fn x y -> x + y) 0 [1, 2, 3]
-- 6 : Int
let fold_left f acc [] = acc
let fold_left f acc [h :: t] = fold_left f (f acc h) t

-- Reduce a list right to left with an accumulator.
--
-- >> List.fold_right (fn x acc -> x - acc) [1, 2, 3] 0
-- 2 : Int
let fold_right f [] acc = acc
let fold_right f [h :: t] acc = f h (fold_right f t acc)

-- Return the number of elements in a list.
--
-- >> List.length [1, 2, 3]
-- 3 : Int
let length [] = 0
let length [_ :: t] = 1 + length t

-- Concatenate two lists.
--
-- >> List.append [1, 2] [3]
-- [1, 2, 3] : List Int
let append [] ys = ys
let append [h :: t] ys = h :: append t ys

-- Reverse a list.
--
-- >> List.reverse [1, 2, 3]
-- [3, 2, 1] : List Int
let reverse xs = fold_left (fn acc x -> x :: acc) [] xs

-- Return the first element of a list, or None if it is empty.
--
-- >> List.head [1, 2, 3]
-- Some(1) : Option Int
let head [] = None
let head [h :: _] = Some h

-- Return the first element of a list. Raises on empty list.
--
-- >> List.head! [1, 2, 3]
-- 1 : Int
let head! [h :: _] = h

-- Return all elements after the first, or None if the list is empty.
--
-- >> List.tail [1, 2, 3]
-- Some([2, 3]) : Option (List Int)
let tail [] = None
let tail [_ :: t] = Some t

-- Return all elements after the first. Raises on empty list.
--
-- >> List.tail! [1, 2, 3]
-- [2, 3] : List Int
let tail! [_ :: t] = t

-- An empty list. `[]` is the same value written as a literal.
--
-- >> List.empty
-- [] : List 'a
let empty = []

-- Return true if the list is empty.
--
-- >> List.empty? []
-- true : Bool
let empty? [] = true
let empty? _ = false

-- Return true if any element satisfies the predicate.
--
-- >> List.any? (fn x -> x > 2) [1, 2, 3]
-- true : Bool
let any? _ [] = false
let any? p [h :: t] = if p h then true else any? p t

-- Return true if all elements satisfy the predicate.
--
-- >> List.all? (fn x -> x > 0) [1, 2, 3]
-- true : Bool
let all? _ [] = true
let all? p [h :: t] = if p h then all? p t else false

-- Return the first element satisfying the predicate, or None.
--
-- >> List.find (fn x -> x > 1) [1, 2, 3]
-- Some(2) : Option Int
let find _ [] = None
let find p [h :: t] = if p h then Some h else find p t

-- Pair up elements from two lists. Stops at the shorter list.
--
-- >> List.zip [1, 2] ["a", "b"]
-- [(1, "a"), (2, "b")] : List (Int, String)
let zip [] _ = []
let zip _ [] = []
let zip [a :: t] [b :: u] = (a, b) :: zip t u

-- Take the first n elements. A count of 0 or less takes none, as
-- `Stream.take` does.
--
-- >> List.take 2 [1, 2, 3]
-- [1, 2] : List Int
--
-- >> List.take (-1) [1, 2, 3]
-- [] : List Int
let take n xs =
  match xs with
  | [h :: t] when n > 0 -> h :: take (n - 1) t
  | _ -> []

-- Drop the first n elements. A count of 0 or less drops none, as
-- `Stream.drop` does.
--
-- >> List.drop 2 [1, 2, 3]
-- [3] : List Int
--
-- >> List.drop (-1) [1, 2, 3]
-- [1, 2, 3] : List Int
let drop n xs =
  match xs with
  | [_ :: t] when n > 0 -> drop (n - 1) t
  | _ -> xs

-- Take elements while the predicate holds, stopping at the first miss.
--
-- >> List.take_while (fn x -> x < 3) [1, 2, 3, 1]
-- [1, 2] : List Int
let take_while _ [] = []
let take_while p [h :: t] = if p h then h :: take_while p t else []

-- Drop elements while the predicate holds, returning the remainder.
--
-- >> List.drop_while (fn x -> x < 3) [1, 2, 3, 1]
-- [3, 1] : List Int
let drop_while _ [] = []
let drop_while p [h :: t] = if p h then drop_while p t else h :: t

-- Call f on each element, for side effects. Takes the element, as `map`
-- and `filter` do; pair it with `indexed` when the position is wanted.
--
-- Whatever f returns is dropped. Most commands run for their effect
-- produce something anyway -- `$()` hands back stdout whether or not the
-- command wrote any -- and requiring Unit taxed every one of those call
-- sites with a `let _ = ... in ()` that said nothing.
--
-- >> List.each (fn x -> IO.println "%{x}") [1, 2]
-- 1
-- 2
let each _ [] = ()
let each f [h :: t] =
  let _ = f h;
  each f t

-- Pair each element with its position, counting from zero.
--
-- >> List.indexed ["a", "b"]
-- [(0, "a"), (1, "b")] : List (Int, String)
let indexed xs =
  let go _ [] = []
  let go i [h :: t] = (i, h) :: go (i + 1) t;
  go 0 xs

-- Return the element at index n, or None if out of bounds.
--
-- >> List.get 1 [1, 2, 3]
-- Some(2) : Option Int
let get n xs = list_get n xs

-- Return the element at index n.  Raises if out of bounds.
--
-- >> List.get! 1 [1, 2, 3]
-- 2 : Int
let get! n xs = list_get_exn n xs

-- Sort a list using the default ordering.
--
-- >> List.sort [3, 1, 2]
-- [1, 2, 3] : List Int
let sort xs = list_sort xs

-- Sort a list by a key function.
--
-- >> List.sort_by String.length ["ccc", "a", "bb"]
-- ["a", "bb", "ccc"] : List String
let sort_by f xs = list_sort_by f xs

-- Keep the first of each element, dropping the rest.
--
-- Two elements are the same when `==` says so, which reads a value rather
-- than its spelling: `60s` and `1min` are one element.
--
-- >> List.unique [1, 2, 1, 3]
-- [1, 2, 3] : List Int
-- >> List.unique [60s, 1min, 2min]
-- [60s, 2min] : List Duration
let unique xs = list_unique xs
-- Count how often each string appears. `Stream.tally` is the same over a
-- stream, for a list too big to hold.
--
-- Entries come back in the order their keys were first seen. Sort by the
-- count to rank them.
--
-- >> List.tally ["a", "b", "a"]
-- {a = 2, b = 1} : Map Int
--
-- >> List.tally []
-- {} : Map Int
let tally xs = list_tally xs

-- Generate a list of integers from lo to hi, both included.
--
-- >> List.range 1 4
-- [1, 2, 3, 4] : List Int
let range lo hi = list_range lo hi

-- Flatten a list of lists into a single list.
--
-- >> List.flatten [[1, 2], [3]]
-- [1, 2, 3] : List Int
let flatten xs = list_flatten xs

-- Concatenate two lists. Alias for append.
--
-- >> List.concat [1, 2] [3]
-- [1, 2, 3] : List Int
let concat xs ys = list_concat xs ys

-- Total the elements, or None when there are none.
--
-- The total starts from the first element rather than from a literal
-- zero, which is what keeps the function Add-polymorphic: a zero would be
-- an Int and would pin the list to Int. So a list of sizes totals to a
-- Size and a list of durations to a Duration.
--
-- An empty list has no total to give, because the unit to answer with is
-- the very thing the type does not fix. Supply one with
-- `Option.default`: `List.sum sizes |> Option.default 0B`.
--
-- >> List.sum [1, 2, 3]
-- Some(6) : Option Int
--
-- >> List.sum [1KB, 500B]
-- Some(1500B) : Option Size
--
-- >> List.sum []
-- None : Option ('a: Add)
let sum [] = None
let sum [h :: t] = Some (fold_left (fn a x -> a + x) h t)

-- The largest element, or None when there are none.
--
-- Comparison reads the value, so `60s` and `1min` are one element and a
-- list of versions answers by precedence rather than by text.
--
-- >> List.max [3, 1, 2]
-- Some(3) : Option Int
--
-- >> List.max [1.9.0, 1.10.0]
-- Some(1.10.0) : Option Version
--
-- >> List.max []
-- None : Option ('a: Ord)
let max [] = None
let max [h :: t] = Some (fold_left (fn a x -> if x > a then x else a) h t)

-- The smallest element, or None when there are none.
--
-- >> List.min [3, 1, 2]
-- Some(1) : Option Int
--
-- >> List.min []
-- None : Option ('a: Ord)
let min [] = None
let min [h :: t] = Some (fold_left (fn a x -> if x < a then x else a) h t)
