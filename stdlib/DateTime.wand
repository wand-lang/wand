import Result

-- Taking an instant apart, and building one.
--
-- There is one instant type and one resolution, the second. `2026-08-22`
-- is a spelling of `2026-08-22T00:00:00Z`, so a date and an instant are
-- the same value written two ways, and a `Duration` moves either of them
-- by the same amount.
--
-- Nothing here reads a clock. `Clock.now` does that, and this module takes
-- what it answers apart:
--
--     Clock.now () |> DateTime.day_start        -- today at midnight
--
-- Every instant is UTC. An instant written with an offset answers for the
-- moment it names rather than the text it was written in, so
-- `DateTime.hour 2026-08-22T20:00:00+05:30` is 14.

-- The year.
--
-- >> DateTime.year 2026-08-22T14:30:00Z
-- 2026 : Int
let year d = dt_year d

-- The month, 1 to 12.
--
-- >> DateTime.month 2026-08-22T14:30:00Z
-- 8 : Int
let month d = dt_month d

-- The day of the month, 1 to 31.
--
-- >> DateTime.day 2026-08-22T14:30:00Z
-- 22 : Int
let day d = dt_day d

-- The hour, 0 to 23.
--
-- >> DateTime.hour 2026-08-22T14:30:00Z
-- 14 : Int
--
-- An offset resolves, so this is the same instant and the same hour:
--
-- >> DateTime.hour 2026-08-22T20:00:00+05:30
-- 14 : Int
let hour d = dt_hour d

-- The minute, 0 to 59.
--
-- >> DateTime.minute 2026-08-22T14:30:00Z
-- 30 : Int
let minute d = dt_minute d

-- The second, 0 to 59.
--
-- >> DateTime.second 2026-08-22T14:30:45Z
-- 45 : Int
let second d = dt_second d

-- The day of the week, ISO 8601: Monday is 1 and Sunday is 7. A number
-- rather than a variant, because it sorts and compares.
--
-- >> DateTime.weekday 2026-08-22
-- 6 : Int
let weekday d = dt_weekday d

-- Midnight UTC of the day this instant falls in.
--
-- >> DateTime.day_start 2026-08-22T14:30:00Z
-- 2026-08-22T00:00:00Z : DateTime
let day_start d = dt_day_start d

-- A day at midnight, or the reason it is not a day. This is the only
-- builder: a time of day is a `Duration` on top of it, because a
-- `Duration` already moves an instant.
--
--     DateTime.on! 2026 8 22 + 14h + 30min      -- 2026-08-22T14:30:00Z
--
-- So there is no rule about what `at 25 0 0` would mean: adding 25 hours
-- to a midnight is the next day at one, which is what it should be.
--
-- >> DateTime.on 2026 8 22
-- Ok(2026-08-22T00:00:00Z) : Result String DateTime
--
-- >> DateTime.on 2026 2 30
-- Error("2026-02-30 is not a day") : Result String DateTime
let on y m d = dt_on (y, m, d)

-- A day at midnight. Raises if it is not a day.
--
-- >> DateTime.on! 2026 8 22
-- 2026-08-22T00:00:00Z : DateTime
--
-- A time of day is a Duration on top of a midnight:
--
-- >> DateTime.on! 2026 8 22 + 14h + 30min
-- 2026-08-22T14:30:00Z : DateTime
let on! y m d = dt_on_exn (y, m, d)

-- The date alone, as `2026-08-22`. The stamped-name case, which is why
-- there is no format string:
--
--     "backup-%{DateTime.date_string (Clock.now ())}.tar.gz"
--
-- >> DateTime.date_string 2026-08-22T14:30:00Z
-- "2026-08-22" : String
let date_string d = dt_date_string d

-- The time of day alone, as `14:30:00`.
--
-- >> DateTime.time_string 2026-08-22T14:30:00Z
-- "14:30:00" : String
let time_string d = dt_time_string d

-- Read an instant, written either way: "2024-01-15T14:30:00Z" or the bare
-- day "2024-01-15", which is midnight UTC.
--
-- >> DateTime.of_string "2026-08-22"
-- Ok(2026-08-22T00:00:00Z) : Result String DateTime
let of_string s = str_to_datetime s

-- The same as `DateTime.of_string`, raising the reason instead of answering
-- with it.
--
-- >> DateTime.of_string! "2026-08-22"
-- 2026-08-22T00:00:00Z : DateTime
let of_string! s = Result.get! (of_string s)

implement Ord DateTime =
  -- The larger of two instants.
  --
  -- Instants are compared, so the spelling a value was written in
  -- does not matter.
  --
  -- >> DateTime.max 2024-01-15 2024-06-01
  -- 2024-06-01T00:00:00Z : DateTime
  let max a b = if a > b then a else b;
  -- The smaller of two instants.
  --
  -- >> DateTime.min 2024-01-15 2024-06-01
  -- 2024-01-15T00:00:00Z : DateTime
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> DateTime.clamp 2024-01-01 2024-12-31 2025-06-15
  -- 2024-12-31T00:00:00Z : DateTime
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> DateTime.between? 2024-01-01 2024-12-31 2025-06-15
  -- false : Bool
  let between? lo hi v = v >= lo && v <= hi
