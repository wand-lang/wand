uses {FS.Read}

import List

-- The language's own tools, as functions: format source as `wand f` does,
-- check it as `wand t` does, and the version of this wand.
--
-- A program that writes wand, such as a code generator, formats what it
-- writes with `format`, so its output is what `wand f` would write. A
-- program that checks other wand files uses `check_file!` and reads the
-- answer as values, not as the text of `wand t --json`.
--
-- Each one but `load!` reads source and gives an answer without running
-- it: text does not become a running program, as it does not become a
-- `Command`. `load!` is the one that runs source, and only a file that
-- checks, that implements the interface its caller names, and that
-- performs no more than that interface allows.

-- One finding of a check, as `wand t --json` reports it. `severity` is
-- "error" or "warning".
type Diagnostic(
  severity: String,
  code: String,
  file: String,
  line: Int,
  col: Int,
  message: String
)

-- A `?` in the source, and the type that belongs there.
type Hole(line: Int, col: Int, type: String)

-- What a check found. `type` is the type of the source when it checks: of
-- its last expression, or `Unit`. It is `None` when the source has an
-- error. `effects` is what the source performs, written as a `uses` line
-- writes it, such as ["FS.Write", "Shell(git)"]: empty when it performs
-- nothing, and when it has an error.
type Checked(
  diagnostics: List Diagnostic,
  holes: List Hole,
  type: Option String,
  effects: List String = []
)

-- ── Format ─────────────────────────────────────────────────────────────

-- Format wand source as `wand f` does. The result is what `wand f` writes,
-- so a file written with it is a fixed point of `wand f`. Raises when the
-- source does not parse.
--
-- >> Wand.format! "let x=1"
-- "let x = 1\n" : String
let format! (src: String) = wand_format src

-- `format!`, giving an `Error` where it raises.
--
-- >> Wand.format "let x ="
-- Error("unexpected token: EOF") : Result String String
let format (src: String) = try format! src

-- ── Check ──────────────────────────────────────────────────────────────

let _checked (diagnostics, holes, t, effects) =
  Checked(
    diagnostics =
      List.map
        (fn (severity, code, file, line, col, message) -> Diagnostic(
          severity,
          code,
          file,
          line,
          col,
          message
        ))
        diagnostics,
    holes =
      List.map (fn (line, col, shape) -> Hole(line = line, col = col, type = shape)) holes,
    type = t,
    effects = effects
  )

-- Check wand source as `wand t` does: its errors, its lint warnings, the
-- type of each `?`, and its type. The source can be one expression or a
-- whole program, and it imports what it uses, as a file does. It reads no
-- files, so it can import the standard library and nothing else: an import
-- of a file is a diagnostic. To check a file, use `check_file!`.
--
-- >> (Wand.check "import List\nList.fold_left ? 0 [1, 2, 3]").holes
-- [Hole(2, 16, "Int -> Int -> Int ! 'e")] : List Hole
--
-- >> (Wand.check "1 + 2").type
-- Some("Int") : Option String
--
-- >> (Wand.check "import Random\nRandom.int 1 6").effects
-- ["Random"] : List String
--
-- >> (Wand.check "1 + \"a\"").diagnostics
-- [Diagnostic("error", "E-TYPE", "", 1, 1, "String and Int are not the same type")] : List Diagnostic
let check (src: String) = _checked (wand_check src)

-- Check a file as `wand t` does, with what it imports. A file that cannot
-- be read raises. What the check finds in the file is the answer, not a
-- failure.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./x.wand; FS.write_file! f "let x = 1"; (Wand.check_file! f).type)
-- Some("Unit") : Option String
let check_file! (path: Path) = _checked (wand_check_file path)

-- `check_file!`, giving an `Error` where it raises.
--
-- >> Result.ok? (Wand.check_file ./no-such-file.wand)
-- false : Bool
let check_file (path: Path) = try check_file! path

-- Check `src` as the file at `path` would be checked, without it being
-- there: what it imports is read from beside `path`, and what the check
-- finds names `path`. An editor checks a buffer this way before it saves
-- it, since the buffer's relative imports only resolve where it will live.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (FS.write_file! (Path.join d ./room.wand) "let name = \"hall\"";
-- ..    (Wand.check_at! (Path.join d ./door.wand) "let room = import ./room\nroom.name").type)
-- Some("String") : Option String
let check_at! (path: Path) (src: String) = _checked (wand_check_at path src)

-- `check_at!`, giving an `Error` where it raises.
--
-- >> Result.ok? (Wand.check_at ./x.wand "1 + 1")
-- true : Bool
let check_at (path: Path) (src: String) = try check_at! path src

-- ── Load ───────────────────────────────────────────────────────────────

-- Load the file at `path` as a module of the interface `loader` names,
-- such as `core.Blueprint.loader`. The file is checked first, and nothing
-- of it runs unless it checks, declares `implement` of that interface, and
-- performs, in its functions and at its top level, only what the
-- interface's members allow. Then it runs as an import does, and what it
-- imports that the program has loaded already is the same module. Loading
-- the same path again reads the file again, so a program can load a new
-- version of it. Raises, with what was wrong, when any of that fails.
--
-- >> with FS.temp_dir "ex_" as d -> (
-- ..   let f = Path.join d ./ints.wand;
-- ..   FS.write_file! f "implement Ord Int =\n  let max a b = if a > b then a else b;\n  let min a b = if a < b then a else b;\n  let clamp lo hi x = if x < lo then lo else if x > hi then hi else x;\n  let between? lo hi x = x >= lo && x <= hi\n";
-- ..   (Wand.load! Ord.loader f).max 2 3
-- .. )
-- 3 : Int
let load! loader (path: Path) = wand_load loader path

-- `load!`, giving an `Error` where it raises.
--
-- >> Result.ok? (Wand.load Ord.loader ./no-such-file.wand)
-- false : Bool
let load loader (path: Path) = try load! loader path

-- ── Limit ──────────────────────────────────────────────────────────────

-- How much a limited call may do: how many steps it may take, and how
-- deep its calls may nest. A step is one position the evaluator passes.
-- Builtins whose output grows with their input -- `++`, `String.repeat`,
-- `List.range`, `JSON` -- take steps for its size before they build it,
-- so a limit bounds memory as well as time.
type Limits(steps: Int = 100000, depth: Int = 1000)

-- Run `thunk` under `limits`: `Ok` its value, or `Error` naming the limit
-- that ran out. A `try` inside the thunk cannot catch that; only this does.
-- A raise inside the thunk passes out as a raise. What the thunk may
-- perform is unchanged: a limit bounds how long code runs, not what it
-- does. An inner limit gets the smaller of its own and what is left of
-- the outer one, and its steps count against the outer one too, as do
-- the steps of fibers started inside it.
--
-- >> Wand.limit Wand.Limits() (fn () -> 1 + 2)
-- Ok(3) : Result String Int
--
-- >> Wand.limit (Wand.Limits(steps = 1000)) (fn () -> List.length (List.range 1 100000))
-- Error("ran out of steps after 1000") : Result String Int
let limit (limits: Limits) thunk = wand_limit limits.steps limits.depth thunk

-- Run `thunk` and give its value with the steps it took. It sets no limit
-- of its own, and its steps count against any limit around it.
--
-- >> (fn (v, steps) -> (v, steps > 0)) (Wand.cost (fn () -> List.length (List.range 1 10)))
-- (10, true) : (Int, Bool)
let cost thunk = wand_cost thunk

-- ── Version ────────────────────────────────────────────────────────────

-- The version of this wand.
--
-- >> Wand.version >= 0.92.0
-- true : Bool
let version = wand_version
