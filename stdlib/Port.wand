import Result

-- The port number, without the colon.
--
-- The colon is the literal's punctuation, and it stays in every string a
-- port makes -- `"host%{:8080}"` is "host:8080", which is the address. A
-- command that takes the port as an argument of its own wants the
-- number, and this is where it comes from.
--
-- >> Port.to_int :8080
-- 8080 : Int
--
-- >> "host%{:8080}"
-- "host:8080" : String
let to_int p = port_to_int p

-- The port with that number, or an error if it is not one: a port is
-- 0 to 65535.
--
-- >> Port.of_int 8080
-- Ok(:8080) : Result String Port
--
-- >> Port.of_int 70000
-- Error("invalid port 70000: must be 0-65535") : Result String Port
let of_int n = port_of_int n

-- Read a port, written as a literal is: ":8080".
--
-- >> Port.of_string ":8080"
-- Ok(:8080) : Result String Port
let of_string s = str_to_port s

-- The same as `Port.of_string`, raising the reason instead of answering
-- with it.
--
-- >> Port.of_string! ":8080"
-- :8080 : Port
let of_string! s = Result.get! (of_string s)

implement Ord Port =
  -- The larger of two Ports.
  --
  -- >> Port.max :80 :8080
  -- :8080 : Port
  let max a b = if a > b then a else b;
  -- The smaller of two Ports.
  --
  -- >> Port.min :80 :8080
  -- :80 : Port
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> Port.clamp :80 :443 :8080
  -- :443 : Port
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> Port.between? :80 :443 :100
  -- true : Bool
  let between? lo hi v = v >= lo && v <= hi
