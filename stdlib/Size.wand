-- The size in bytes as an integer.
--
-- >> Size.to_bytes 10MB
-- 10000000 : Int
let to_bytes s = size_to_bytes s

-- A size of n bytes, written in bytes. A size is 0B or more, so a negative
-- count is a runtime error.
--
-- >> Size.of_bytes 6466
-- 6466B : Size
let of_bytes n = size_of_bytes n

-- Format a size as a human-readable string. A size keeps the unit it was
-- written in; this is where it is rounded to a readable one.
--
-- >> Size.format 6466B
-- "6.5KB" : String
let format s = size_format s

implement Ord Size =
  -- The larger of two Sizes.
  --
  -- The value is compared, not the spelling: `1000B` and `1KB` are
  -- one Size.
  --
  -- >> Size.max 4KB 100MB
  -- 100MB : Size
  let max a b = if a > b then a else b;
  -- The smaller of two Sizes.
  --
  -- >> Size.min 4KB 100MB
  -- 4KB : Size
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> Size.clamp 1KB 1MB 5MB
  -- 1MB : Size
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> Size.between? 1KB 1MB 4KB
  -- true : Bool
  let between? lo hi v = v >= lo && v <= hi
