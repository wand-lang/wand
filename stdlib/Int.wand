import Result

-- The Int operations that are not operators.
--
-- Arithmetic is written with `+ - * / %`, so what is left here is the
-- handful of things an operator does not spell: distance from zero,
-- repeated multiplication, the ends of the range, and reading one from
-- text.
--
-- A conversion is on the type it produces. `Int.of_string` reads an Int,
-- `String.of_int` writes one as text, and `Float.of_int` widens one.
--
-- An Int is a machine word holding `Int.min_value` to `Int.max_value`.
-- Arithmetic outside that range is a runtime error rather than a wrap,
-- and it is not the Raise effect -- tracking it would put Raise on every
-- function that adds two numbers.

-- The distance from zero.
--
-- Float has its own, because arithmetic never crosses between the two on
-- its own: `Float.abs` is the one for a Float.
--
-- >> Int.abs (-7)
-- 7 : Int
--
-- >> Int.abs 7
-- 7 : Int
let abs n = if n < 0 then 0 - n else n

-- The base raised to the exponent.
--
-- A negative exponent divides, and Int division truncates toward zero, so
-- `Int.pow 2 (-1)` is 0 rather than a half. A base of zero with a negative
-- exponent divides by zero, exactly as writing that division would.
--
-- >> Int.pow 2 10
-- 1024 : Int
--
-- >> Int.pow 10 0
-- 1 : Int
let pow _ 0 = 1
let pow b e = if e < 0 then 1 / pow b (0 - e) else b * pow b (e - 1)

-- The largest Int.
--
-- >> Int.max_value
-- 4611686018427387903 : Int
let max_value = 4611686018427387903

-- The smallest Int.
--
-- It is written as a subtraction because the magnitude is one past the
-- largest literal wand accepts.
--
-- >> Int.min_value
-- -4611686018427387904 : Int
let min_value = 0 - max_value - 1

-- Read an integer: an optional `-` and decimal digits, with the space
-- around them ignored.
--
-- >> Int.of_string "42"
-- Ok(42) : Result String Int
--
-- >> Int.of_string "x"
-- Error("cannot parse \"x\" as Int") : Result String Int
--
-- >> Int.of_string "0x1F"
-- Error("cannot parse \"0x1F\" as Int") : Result String Int
let of_string s = str_to_int s

-- The same as `Int.of_string`, raising the reason instead of answering
-- with it.
--
-- >> Int.of_string! "42"
-- 42 : Int
let of_string! s = Result.get! (of_string s)

implement Ord Int =
  -- The larger of two Ints.
  --
  -- >> Int.max 3 7
  -- 7 : Int
  let max a b = if a > b then a else b;
  -- The smaller of two Ints.
  --
  -- >> Int.min 3 7
  -- 3 : Int
  let min a b = if a < b then a else b;
  -- The value, held between a low and a high bound, both included.
  --
  -- The bounds come first so the value can arrive from a pipeline.
  --
  -- >> Int.clamp 0 10 42
  -- 10 : Int
  let clamp lo hi v = if v < lo then lo else if v > hi then hi else v;
  -- True when the value is at or between the two bounds.
  --
  -- >> Int.between? 1 10 5
  -- true : Bool
  let between? lo hi v = v >= lo && v <= hi
