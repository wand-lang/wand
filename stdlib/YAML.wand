uses {FS.Read}

import FS

-- Reading and writing YAML: Kubernetes manifests, docker-compose files,
-- GitHub Actions workflows.
--
-- `of` and `stringify` write a new document from a value, as `JSON.of` and
-- `JSON.stringify` do. They do not edit a file in place: a document that is
-- read and written again loses its comments and its layout.
--
-- YAML can spell one value in many ways, and `stringify` always picks the
-- same one: block style, two spaces for each level, and a sequence under
-- its key indented under it. A string is written without quotes only when
-- no YAML reader can read it as something else. Other strings are in
-- double quotes. That includes the YAML 1.1 words `yes`, `no`, `on`, `off`,
-- `y` and `n`, because some readers, kubectl among them, read those as
-- booleans.
--
-- Scalars are read against the **YAML 1.2 core schema**, not 1.1. A
-- workflow's `on:` is the string `"on"` and not the boolean true; a compose
-- file's `2200:22` is a string and not base sixty; `restart: no` is the
-- word `"no"`. Every one of those is 1.1 behaviour that would read a real
-- file as something other than what it says.
--
-- One row survives both schemas and bites anyway: `1.10` is a **float**, so
-- a chart version read unquoted arrives as `1.1`. Read it from a quoted
-- string, which is what the file should be writing:
--
--     version: "1.10.0"
--
-- Helm charts are not YAML. A chart's templates are Go templates that
-- happen to produce it, so read the output of `helm template` rather than
-- the chart.

-- Any value as YAML, as `JSON.of` writes it: a record's fields by their
-- keys, a constructor by its spelling, and a field that holds `None` left
-- out. A function, a resource or a stream is an `Error`.
--
-- >> YAML.of {name = "web"} |> Result.map YAML.stringify
-- Ok("name: web\n") : Result String String
let of v = yaml_of v

-- Any value as YAML. Raises on what cannot be written.
--
-- >> YAML.stringify (YAML.of! {replicas = 3})
-- "replicas: 3\n" : String
let of! v = yaml_of_exn v

-- A JSON value as YAML. The two hold the same tree, so this cannot fail:
-- use it for what an encoder gives, such as `T.encoder x`.
--
-- >> YAML.stringify (YAML.of_json (JSON.parse! `{"port": 80}`))
-- "port: 80\n" : String
let of_json j = yaml_of_json j

-- One document as YAML text, ending with a newline. A string that a YAML
-- reader could read as a boolean, a number or a null is quoted.
--
-- >> YAML.stringify (YAML.of! {name = "web", enabled = "yes", port = "8080"})
-- "name: web\nenabled: \"yes\"\nport: \"8080\"\n" : String
--
-- >> YAML.stringify (YAML.of! {ports = [80, 443]})
-- "ports:\n  - 80\n  - 443\n" : String
let stringify y = yaml_stringify y

-- Several documents in one stream, with `---` between them: the form of a
-- manifest file that holds more than one object.
--
-- >> YAML.stringify_all [YAML.of! {kind = "Service"}, YAML.of! {kind = "Deployment"}]
-- "kind: Service\n---\nkind: Deployment\n" : String
let stringify_all ys = yaml_stringify_all ys

-- Read one document.
--
-- A file that holds more than one is an error rather than a truncation --
-- silently taking the first is how a script checks one third of a manifest
-- and reports that everything passed. Use `parse_all` for those.
--
-- >> YAML.parse "name: web\nport: 8080"
-- Ok({"name":"web","port":8080}) : Result String YAML
--
-- >> YAML.parse "on: push"
-- Ok({"on":"push"}) : Result String YAML
--
-- YAML spells infinity `.inf`, and the value a document is read into has no
-- way to hold one. Both spellings are an Error.
--
-- >> YAML.parse "a: .inf" |> Result.error?
-- true : Bool
let parse src = yaml_parse src

-- Read one document. Raises on anything `parse` reports.
--
-- >> YAML.parse! "replicas: 3" |> YAML.field! "replicas" |> YAML.get_int
-- Ok(3) : Result String Int
let parse! src = yaml_parse_exn src

-- Read every document in the file. `---` separates them, which is how
-- Kubernetes manifests are written and how `kubectl apply -f` reads them.
--
-- >> YAML.parse_all "kind: Service\n---\nkind: Deployment" |> Result.map List.length
-- Ok(2) : Result String Int
let parse_all src = yaml_parse_all src

-- Read every document in the file. Raises instead of answering.
--
-- >> YAML.parse_all! "a: 1\n---\na: 2" |> List.length
-- 2 : Int
let parse_all! src = yaml_parse_all_exn src

-- Read one document from a file. Raises on a file that will not open, and
-- on one holding more than one document.
--
-- This performs the same `FS!read_file` every other reader performs, so it
-- is `FS.Read` like any other read: a handler mocking the filesystem stands
-- in for it, and `--dry-run` sees it.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./c.yaml; FS.write_file! f "port: 8080";
-- ..    YAML.read_file! f)
-- {"port":8080} : YAML
let read_file! path = parse! (FS.read_file! path)

-- Read one document from a file.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (match YAML.read_file (Path.join d ./missing.yaml) with
-- ..    | Ok _ -> "read" | Error _ -> "no")
-- "no" : String
let read_file path = try read_file! path

-- Read every document in a file. This is the one a manifest wants, because
-- `---` is how they are written and how `kubectl apply -f` reads them.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (let f = Path.join d ./m.yaml; FS.write_file! f "kind: Service\n---\nkind: Pod";
-- ..    List.length (YAML.read_file_all! f))
-- 2 : Int
let read_file_all! path = parse_all! (FS.read_file! path)

-- Read every document in a file.
--
-- >> with FS.temp_dir "ex_" as d ->
-- ..   (match YAML.read_file_all (Path.join d ./missing.yaml) with
-- ..    | Ok _ -> "read" | Error _ -> "no")
-- "no" : String
let read_file_all path = try read_file_all! path

-- Read a document into a type, with a decoder.
--
-- A `Decoder 'a` is the same one `JSON.decode` and `TOML.decode` take, and
-- the same one a type definition derives, so nothing here is a third
-- vocabulary to learn.
--
-- >> YAML.decode (Decode.field "port" Decode.int) (YAML.parse! "port: 8080")
-- Ok(8080) : Result String Int
let decode d y = yaml_decode d y

-- The value at a key.
--
-- >> YAML.parse! "a:\n  b: 1" |> YAML.field "a" |> Result.and_then (YAML.field "b")
-- Ok(1) : Result String YAML
let field key y = yaml_field key y

-- The value at a key. Raises if it is not there.
--
-- >> YAML.parse! "kind: Pod" |> YAML.field! "kind" |> YAML.get_string
-- Ok("Pod") : Result String String
let field! key y = yaml_field_exn key y

-- The string, or an Error saying what it found instead.
--
-- >> YAML.get_string (YAML.parse! "'yes'")
-- Ok("yes") : Result String String
let get_string y = yaml_get_string y

-- The integer, or an Error saying what it found instead.
--
-- >> YAML.get_int (YAML.parse! "8080")
-- Ok(8080) : Result String Int
let get_int y = yaml_get_int y

-- The float, or an Error saying what it found instead. An integer reads as
-- a float, as it does in `JSON`.
--
-- >> YAML.get_float (YAML.parse! "1.5")
-- Ok(1.5) : Result String Float
let get_float y = yaml_get_float y

-- The boolean, or an Error saying what it found instead. Only `true` and
-- `false` are booleans here: `yes`, `no`, `on` and `off` are words.
--
-- >> YAML.get_bool (YAML.parse! "true")
-- Ok(true) : Result String Bool
--
-- >> YAML.get_bool (YAML.parse! "yes") |> Result.error?
-- true : Bool
let get_bool y = yaml_get_bool y

-- The sequence, or an Error saying what it found instead.
--
-- >> YAML.get_sequence (YAML.parse! "- 1\n- 2") |> Result.map List.length
-- Ok(2) : Result String Int
let get_sequence y = yaml_get_sequence y

-- The mapping, or an Error saying what it found instead.
--
-- >> YAML.get_mapping (YAML.parse! "a: 1") |> Result.map Map.size
-- Ok(1) : Result String Int
let get_mapping y = yaml_get_mapping y

-- Whether it is a sequence.
--
-- >> YAML.sequence? (YAML.parse! "- 1")
-- true : Bool
let sequence? y = yaml_is_sequence y

-- Whether it is a mapping.
--
-- >> YAML.mapping? (YAML.parse! "a: 1")
-- true : Bool
let mapping? y = yaml_is_mapping y

-- Whether it is empty. YAML writes nothing four ways -- `null`, `~`, `Null`
-- and an absent value -- and a manifest with a bare `resources:` under it
-- is ordinary, so the question comes up.
--
-- >> YAML.parse! "resources:" |> YAML.field! "resources" |> YAML.null?
-- true : Bool
--
-- >> YAML.parse! "resources: {}" |> YAML.field! "resources" |> YAML.null?
-- false : Bool
let null? y = yaml_is_null y
