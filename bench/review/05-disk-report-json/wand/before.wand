uses {IO, Shell(df)}

import Int
import IO
import List
import Option
import Result
import String

-- Print every mount that is more than 80% full.

type Mount(mount: String, used: Int)

let parse line =
  match String.words line with
  | [_ :: _ :: _ :: _ :: percent :: mount :: _] ->
    Int.of_string (String.replace "%" "" percent)
    |> Result.to_option
    |> Option.map (fn used -> Mount(mount, used))
  | _ -> None

let full =
  $(df -Pk)
  |> String.lines
  |> List.drop 1
  |> List.filter_map parse
  |> List.filter (fn (m: Mount) -> m.used > 80)

List.each (fn (m: Mount) -> IO.println "%{m.mount} %{m.used}%") full
