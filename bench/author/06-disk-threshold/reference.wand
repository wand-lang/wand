uses {IO, Proc}

import Int
import IO
import List
import Option
import Proc
import Regex
import Result
import String

-- One line of `df -P` as its capacity and mount point.
let usage_of line =
  match Regex.capture r/^[^ ]+ +[0-9]+ +[0-9]+ +[0-9]+ +([0-9]+)% +(.+)$/ (String.trim line) with
  | Some [_, capacity, mount] ->
    Int.of_string capacity |> Result.to_option |> Option.map (fn c -> (c, mount))
  | _ -> None

let report! limit =
  IO.read_all! ()
  |> String.lines
  |> List.drop 1
  |> List.filter_map usage_of
  |> List.filter (fn (capacity, _) -> capacity >= limit)
  |> List.sort_by (fn (capacity, mount) -> (0 - capacity, mount))
  |> List.each (fn (capacity, mount) -> IO.println "%{capacity}% %{mount}")

let percent arg =
  if Regex.match? r/^[0-9]+$/ arg then
    match Int.of_string arg with
    | Ok n if n <= 100 -> Some n
    | _ -> None
  else None

match Proc.args () |> List.map percent with
| [Some limit] -> report! limit
| _ -> (IO.println_err "usage: prog PERCENT, from 0 to 100"; Proc.exit 2)
