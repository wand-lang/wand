uses {Env, FS.Read, IO, Proc, Shell}

import Env
import FS
import IO
import List
import Option
import Path
import Proc
import Shell
import String

-- Every example in a doc string is run, and has to produce what it says it
-- produces. An example is written to be read by someone deciding how to
-- call a function, and one that is wrong is worse than none at all: it is
-- read with the same trust and it cannot be told apart.
--
-- This is wand's own CI step, written in wand. It runs after the suites,
-- so the binary it uses has already been exercised by tests that do not
-- depend on it.

-- The binary to check with -- the one this build just produced, not
-- whatever is on PATH. CI sets it; a bare `wand` is the fallback for
-- running this by hand.
let wand = Env.get "WAND" |> Option.default "wand"

-- The modules are the files, so a new one is covered the day it is added.
-- A list written here instead would be a list that goes stale, and the way
-- it goes stale is silently.
let modules =
  FS.glob_in *.wand (Path.of_string "stdlib")
  |> List.map (fn p -> Path.to_string (Path.with_extension "" (Path.basename p)))
  |> List.sort

-- `wand d --test` answers with its exit code and says nothing when every
-- example holds, so a module that has no examples yet passes quietly and a
-- module whose examples are wrong does not. The output is kept to report,
-- since a failure has to say which example and how.
let check name = $?(%{wand} d --test %{name})

-- ── Every function has one ──────────────────────────────────────────────

-- Running the examples says nothing about the functions that have none. A
-- module whose examples all hold and whose functions mostly lack them
-- passes the check above, and did: a count per module looked like coverage
-- and 53 functions had nothing.
--
-- These are the ones that cannot have an example, each for a reason that
-- is not "nobody wrote it yet":
--
--   Proc.exit           ends the process, and the checker with it
--   IO.read_line        waits on stdin, which a check has none of
--   IO.read_line!       the same
--   IO.read_all         the same
--   IO.read_all!        the same
--   IO.stdin_lines      the same
--   IO.flush            answers with nothing and writes nothing
--   HTTP.download       writes a file from a host, and there is no host
--   HTTP.download!      the same
--   HTTP.upload         reads a file to a host, and there is no host
--   HTTP.upload!        the same
--   Net.listen          waits for a client, and a check has none
--   Net.read_line       needs a connection, and only a client makes one
--   Net.read            the same
--   Net.write           the same
--   Net.write!          the same
--   Net.peer            the same
--
-- The rest of `HTTP` has examples, because `Test.with_http` answers a
-- request without one. These four do not, because the double answers with a
-- response and these two are about a file: standing in for them would prove
-- the double works rather than that they do.
let exempt = [
  "Proc.exit",
  "IO.read_line",
  "IO.read_line!",
  "IO.read_all",
  "IO.read_all!",
  "IO.stdin_lines",
  "IO.flush",
  "HTTP.download",
  "HTTP.download!",
  "HTTP.upload",
  "HTTP.upload!",
  "Net.listen",
  "Net.read_line",
  "Net.read",
  "Net.write",
  "Net.write!",
  "Net.peer"
]

-- `wand d` lists a module's members, one per line, as `Module.name : type`,
-- with the names padded so the colons line up within the module. The name is
-- what stands before the colon, trimmed of that padding.
let members_of! name =
  $(%{wand} d %{name})
  |> String.lines
  |> List.filter (fn l -> String.starts_with? "%{name}." l)
  |> List.map (fn l -> String.trim (List.head! (String.split " : " l)))

-- A name has an example when its doc carries the session's prompt.
let has_example! name = String.contains? ">>" $(%{wand} d --json %{name})

let undocumented_in! module =
  members_of! module
  |> List.filter (fn n -> !(List.any? (fn e -> e == n) exempt))
  |> List.filter (fn n -> !(has_example! n))

let report (r: ShellResult) = (IO.println_err r.stdout; IO.println_err r.stderr)

let report_undocumented names = (
  IO.println_err "these functions have no example, and are not exempt:";
  names |> List.each (fn n -> IO.println_err "  %{n}");
  Proc.exit 1
)

let main! () = (
  let missing = modules |> List.map undocumented_in! |> List.flatten;
  if List.empty? missing then () else report_undocumented missing;
  let results = modules |> List.map check;
  match List.filter Shell.failed? results with
  | [] -> IO.println "every function has an example, and every example holds"
  | bad -> (
    IO.println_err "these examples do not produce what they say:";
    bad |> List.each report;
    Proc.exit 1
  )
)

main! ()
