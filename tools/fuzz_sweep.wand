uses {Env, FS.Read, FS.Write, IO, Proc, Shell}

import Env
import FS
import IO
import List
import Option
import Par
import Result
import Path
import Shell
import Proc
import String

-- Runs the fuzzer over several seeds and says what it found.
--
-- The fuzzer itself is OCaml, in `test/fuzz`. This script decides which
-- seeds to run, how long each one runs, where its findings go, and what the
-- exit code means.
--
-- A shell script did this before. It copied the binary and did not check
-- the copy. `cp` onto a file that another process is running fails with
-- ETXTBSY, and the script had no `set -e`, so it carried on. A forty-minute
-- sweep then ran against a build from before the fix it was meant to test,
-- and said nothing. The findings looked real and were not. So the copy here
-- is compared against the original.
--
-- It let two seeds write to one directory. A finding is keyed by signature,
-- so the second seed to hit a signature overwrote the first. One reproducer
-- was lost that way. So each seed is given its own `--out`, which is also
-- what makes the seeds safe to run together.
--
-- It reported a quiet night when the fuzzer had not started. So a seed that
-- exits with anything but 0 or 1 stops the sweep, and a seed that claims a
-- finding and writes no file stops it too.

let wand_root = Env.get "WAND_ROOT" |> Option.default "."

let fuzz_exe =
  Env.get "FUZZ_EXE" |> Option.default "%{wand_root}/_build/default/test/fuzz/fuzz.exe"

-- A number from the environment, or the fallback. A value that is set and
-- unreadable takes the fallback rather than stopping the sweep: the number
-- is how long to run, and a sweep that runs is worth more than one that
-- refuses over a typo.
let int_env name fallback =
  Env.get name
  |> Option.and_then (fn s -> String.to_int s |> Result.to_option)
  |> Option.default fallback

-- Six seeds of five minutes each finds what one seed of thirty does not:
-- the seeds are independent, so they walk different parts of the corpus.
let seeds = int_env "SEEDS" 6

let seconds = int_env "SECONDS_PER_SEED" 300

-- The seeds are independent, so they run together. Four at once is what the
-- daily job has always used, and it is a safe default for a laptop: the
-- fuzzer is CPU-bound and each seed is given a wall-clock budget, so more
-- workers than cores means every seed covers less ground in its own five
-- minutes. Raise it where there are cores to spare.
let workers = int_env "WORKERS" 4

-- Every seed's findings, one directory per seed underneath.
--
-- Under `_fuzz-findings/` rather than beside it, so everything the fuzzer
-- writes is in one place. Under a `sweep` of its own rather than directly
-- in it, because a sweep clears this directory before it starts, and
-- `_fuzz-findings/` is also where a plain `fuzz.exe` run leaves a finding
-- that nobody has triaged yet.
let archive_dir = Path.of_string "%{wand_root}/_fuzz-findings/sweep"

-- The binary under test, copied so a rebuild during the sweep cannot change
-- what is being tested half way through. The copy lives beside the findings
-- and not in a temp directory: a `with` bracket releases at the end of its
-- body, so a pin made inside one is deleted before the first seed runs.
let pin! () = (
  let src = Path.of_string fuzz_exe;
  unless FS.exists? src then (
    IO.println_err "no fuzzer at %{fuzz_exe} -- set FUZZ_EXE, or build it";
    Proc.exit 2
  );
  let pinned = Path.join archive_dir (Path.of_string "fuzz.exe");
  FS.copy! src pinned;
  -- Compared, not assumed. A copy that failed and was not checked is the
  -- whole reason this file exists.
  let same = FS.read_file! (Path.of_string fuzz_exe) == FS.read_file! pinned;
  unless same then (IO.println_err "the pinned copy differs from %{fuzz_exe}"; Proc.exit 2);
  -- The copy has to be runnable, and a copy does not have to carry the
  -- execute bit. Asked here, where the answer is one line, rather than as
  -- "No such file or directory" once per seed.
  let ok = $?(test -x %{Path.to_string pinned});
  unless Shell.ok? ok then (
    IO.println_err "the pinned copy is not executable: %{Path.to_string pinned}";
    Proc.exit 2
  )
  else pinned
)

-- Where one seed's findings go. `--out` gives each seed a directory of its
-- own, which is what lets them run together: the fuzzer keys a finding by
-- signature, so two seeds that hit one would overwrite each other, and a
-- sweep would report whichever finished last.
let out_of seed = Path.join archive_dir (Path.of_string "seed%{seed}")

-- Run one seed and answer with everything the caller needs to report it.
-- Nothing is printed here: parallel seeds finish in any order, and lines
-- from six of them interleaved are not a log anyone can read.
let run_seed pinned (seed: Int) =
  let out = out_of seed;
  let r =
    $?(%{Path.to_string pinned} --seed %{seed} --iterations 100000000 --seconds %{seconds} --timeout 20 --shrink 2000 --out %{Path.to_string out});
  let found = if FS.exists? out then FS.glob_in **.wand out else [];
  (seed, r.code, String.trim "%{r.stdout}%{r.stderr}", found)

-- One seed's line in the log, in seed order, once every seed is done.
let report_seed (seed, code, output, found) = (
  IO.println "--- seed %{seed}";
  IO.println output;
  -- The fuzzer exits 0 with nothing to say and 1 when it found something.
  -- Anything else means it did not run, and a sweep that could not start
  -- must not report a quiet night.
  if code > 1 then (IO.println_err "seed %{seed} did not run (exit %{code})"; Proc.exit 2);
  -- The fuzzer says it found something by exiting 1, and shows what by
  -- writing the input and its notes. If the two disagree, the sweep cannot
  -- say what happened, and saying "no new findings" would be the worst of
  -- the answers available.
  if code == 1 && found == [] then (
    IO.println_err "seed %{seed} reported a finding and wrote no file";
    Proc.exit 2
  )
  else found
)

let report kept = (
  let n = kept |> List.map List.length |> List.fold_left (fn a b -> a + b) 0;
  match n with
  | 0 -> IO.println "no new findings in %{seeds} seed(s)"
  | _ -> (
    IO.println_err "%{n} finding(s), kept under %{Path.to_string archive_dir}";
    Proc.exit 1
  )
)

let main! () = (
  if FS.exists? archive_dir then FS.delete_tree! archive_dir;
  FS.mkdir! archive_dir;
  let pinned = pin! ();
  IO.println "pinned %{fuzz_exe}, %{seeds} seeds of %{seconds}s, %{workers} at a time";
  -- `Par.map` answers with a Result for each worker, because one that
  -- raises must not take the others with it. A seed that could not run at
  -- all is the sweep failing, not a quiet seed.
  let results = Par.map workers (fn s -> run_seed pinned s) (List.range 0 (seeds - 1));
  let ran =
    results
    |> List.map (fn r ->
      match r with
      | Ok v -> v
      | Error m -> (IO.println_err "a seed raised: %{m}"; Proc.exit 2));
  report (ran |> List.map report_seed)
)

main! ()
