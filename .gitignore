*.annot
*.cmo
*.cma
*.cmi
*.a
*.o
*.cmx
*.cmxs
*.cmxa

# Files containing detailed information about the compilation (generated
# by `ocamlc`/`ocamlopt` when invoked using the option `-bin-annot`).
# These files are typically useful for code inspection tools
# (e.g. Merlin).
*.cmt
*.cmti

# ocamlbuild and Dune default working directory
_build/

# ocamlbuild targets
*.byte
*.native

# oasis generated files
setup.data
setup.log

# Merlin configuring file for Vim and Emacs
.merlin

# Dune generated files
*.install

# Local OPAM switch
_opam/
/wand

# Release archives, built by `make release`
/dist/

# Generated by dune when it compiles the C stub
/compile_commands.json

# Reproducers the fuzzer writes, a sweep's under `sweep/`. Anything worth
# keeping is moved into test/fuzz/regressions/ by hand.
_fuzz-findings/
.DS_Store

# Claude Code: local settings and the worktrees of its agents
.claude/
